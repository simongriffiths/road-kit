      {
        "id": "api_keys.delete",
        "title": "Revoke an API key",
        "description": "Propose revoking one key of an agent. A revoked key gets no new token; tokens already issued run out within minutes.",
        "action_resource": {
          "rest": {
            "method": "DELETE",
            "path": "/agents/{id}/keys/{key_id}/"
          }
        },
        "authority": {
          "operational_authority": "Agents, road_agent_api",
          "actor": {
            "model": "authenticated",
            "required_permissions": [
              "road.agents.rw"
            ],
            "attribution_required": true
          }
