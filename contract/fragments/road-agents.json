              "properties": {
                "key_id": {
                  "type": "integer"
                }
              }
            }
          },
          "rejections": [
            {
              "rule_id": "AGENT_NOT_FOUND",
              "retryable": false,
              "discloses_ids": false
            },
            {
              "rule_id": "API_KEY_NOT_FOUND",
              "retryable": false,
              "discloses_ids": true
            }
          ],
          "non_disclosing": false
        },
        "audit": {
          "record": "road_decisions",
          "fields": [
