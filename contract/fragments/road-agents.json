        "changes_existing_record": false,
        "request": {
          "idempotency": {
            "strategy": "idempotency_key",
            "header": "Idempotency-Key",
            "retention": "indefinitely",
            "replays": "accepted_only"
          },
          "body": {
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 0,
            "description": "No body: the resource and the Idempotency-Key header say everything."
          }
        },
        "preconditions": {
          "current_state_recheck": true,
          "evaluation": "first_failure",
          "rules": [
            {
              "id": "AGENT_NOT_FOUND",
              "kind": "access",
              "description": "The agent exists and the caller owns it.",
              "consumer_visible": true
            },
            {
              "id": "API_KEY_NOT_FOUND",
