            ],
            "properties": {
              "before": {
                "type": "string",
                "format": "date-time",
                "description": "The cutoff. Todos changed before it are purged."
              }
            }
          }
        },
        "preconditions": {
          "current_state_recheck": true,
          "evaluation": "first_failure",
          "rules": [
