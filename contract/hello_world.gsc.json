  "publication": {
    "provisional": true,
    "views": [
      {
        "id": "todos.list",
        "title": "List todos",
        "meaning": "The caller's todos, newest first, with the read token a later action on any of them must carry. Deleted todos are left out unless asked for. Another owner's todos need todo.list_all.",
        "resource": {
          "rest": {
            "method": "GET",
            "path": "/todos/"
          }
        },
        "authority": {
          "actor": {
            "model": "authenticated",
            "required_permissions": [
              "todo.list"
            ],
            "attribution_required": false
          }
        },
        "parameters": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "OPEN",
                "DONE",
                "DELETED"
              ]
            },
            "query": {
              "type": "string",
              "description": "A word in the title. Not \"q\": ORDS reserves it."
            },
            "owner": {
              "type": "integer",
              "description": "Another principal's todos. Needs todo.list_all."
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "items",
            "hasMore",
            "limit",
            "offset",
            "count",
            "read_token"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "todo_id",
                  "title",
                  "status",
                  "created_at",
                  "updated_at"
                ],
                "properties": {
