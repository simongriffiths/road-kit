merge into jwt_scaffold_config target
using (
  select 1 as config_id,
         '@@ROAD_ISSUER@@' as issuer,
         'road-dev' as audience,
         -- NULL, DELIBERATELY, since spec-patch-09 phase 4 -- and the column had to become
         -- nullable to hold it (db/tables/jwt_scaffold_config.create.sql; ORA-01407 otherwise,
         -- since Oracle stores '' as NULL and a NOT NULL column refuses it). This used to be a
         -- fixed list issued identically to every user, which is what made the ORDS privilege gate
         -- mere routing rather than authorisation (spec-patch-06 section 8.4). A real login now
         -- gets its scope from jwt_scaffold_auth_api.effective_ords_scope, derived per principal
         -- from ROAD_ROLE_PERMISSIONS intersected with USER_ORDS_PRIVILEGES.NAME.
         --
         -- This column survives as issue_token's fallback for a call with no p_scope override --
         -- bin/get-test-token.sh's default form, and the conformance suite's negative cases. It
         -- must stay NULL: any other value here is silently handed to any principal who holds no
         -- ORDS-gate permission at all, because issue_token's own NVL falls back to this column
         -- exactly when a principal is entitled to nothing.
         null as scope_name,
         60 as ttl_minutes,
         '@@ROAD_JWK_URL@@' as jwk_url
    from dual
) source
on (target.config_id = source.config_id)
when matched then
  update set issuer      = source.issuer,
             audience    = source.audience,
             scope_name  = source.scope_name,
             ttl_minutes = source.ttl_minutes,
             jwk_url     = source.jwk_url,
             updated_at  = systimestamp
when not matched then
  insert (
    config_id,
    issuer,
    audience,
    scope_name,
    ttl_minutes,
    jwk_url
  )
  values (
    source.config_id,
    source.issuer,
    source.audience,
    source.scope_name,
    source.ttl_minutes,
    source.jwk_url
  );

commit;

