 12    -- TRUE if p_current_updated_at is no later than the token's issued_at (nothing touched by
 13    -- this entity has changed since the read that issued p_guid) — FALSE otherwise, including
 14    -- when p_guid does not correspond to any issued token. Also annotates the token's
 15    -- road_api_log row with entity_type/entity_id/outcome ('OK' or 'STALE_REJECTED') so the one
 16    -- row serves concurrency, observability and audit together (spec-patch-01-concurrency.md §5).
 17    function check_fresh(
 18      p_guid               in raw,
 19      p_app_schema         in varchar2,
 20      p_entity_type        in varchar2,
 21      p_entity_id          in varchar2,
 22      p_current_updated_at in timestamp with time zone
 23    ) return boolean;
