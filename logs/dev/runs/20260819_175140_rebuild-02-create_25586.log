 35      l_count number;
 36    begin
 37      select count(*) into l_count from road_permissions where permission_name = p_permission_name;
 38      if l_count = 0 then
 39        raise_application_error(c_err_not_found, 'Permission not found: ' || p_permission_name);
 40      end if;
