SQL> create or replace package body road_audit_api_test as
  2  
  3    c_app_schema constant varchar2(30) := 'ROAD_CAL_TEST';
  4  
  5    procedure assert_true(p_label in varchar2, p_condition in boolean) is
  6    begin
  7      if p_condition is null or not p_condition then
  8        raise_application_error(-20000, p_label || ': expected TRUE, got ' ||
  9          case p_condition when true then 'TRUE' when false then 'FALSE' else 'NULL' end);
 10      end if;
 11    end assert_true;
 12  
 13    procedure assert_eq(p_label in varchar2, p_expected in varchar2, p_actual in varchar2) is
 14    begin
 15      if p_actual is null or p_expected is null or p_actual != p_expected then
 16        raise_application_error(
 17          -20000,
 18          p_label || ': expected [' || p_expected || '] got [' || p_actual || ']'
 19        );
 20      end if;
 21    end assert_eq;
 22  
 23    -- issue_read_token / check_fresh both commit autonomously; SAVEPOINT/ROLLBACK in run_all
 24    -- cannot undo those rows, so every test cleans up its own road_api_log rows explicitly.
 25    procedure cleanup(p_log_id in raw) is
 26    begin
 27      delete from road_api_log where log_id = p_log_id;
 28      commit;
 29    end cleanup;
 30  
 31    procedure test_issue_read_token_creates_row is
 32      l_guid  raw(16);
 33      l_count number;
 34    begin
 35      l_guid := road_audit_api.issue_read_token(
 36        p_caller_type => 'BROWSER',
 37        p_app_schema  => c_app_schema,
 38        p_endpoint    => 'get_events_for_range',
 39        p_caller_ref  => 'test-session'
 40      );
 41      assert_true('guid not null', l_guid is not null);
 42  
 43      select count(*) into l_count
 44        from road_api_log
 45       where log_id = l_guid
 46         and caller_type = 'BROWSER'
 47         and caller_ref = 'test-session'
 48         and app_schema = c_app_schema
 49         and endpoint = 'get_events_for_range'
 50         and outcome = 'OK';
 51      assert_eq('row count', '1', to_char(l_count));
 52  
 53      cleanup(l_guid);
 54    end test_issue_read_token_creates_row;
 55  
 56    procedure test_check_fresh_true_when_unchanged is
 57      l_guid   raw(16);
 58      l_fresh  boolean;
 59    begin
 60      l_guid := road_audit_api.issue_read_token(
 61        p_caller_type => 'BROWSER',
 62        p_app_schema  => c_app_schema,
 63        p_endpoint    => 'get_event'
 64      );
 65  
 66      l_fresh := road_audit_api.check_fresh(
 67        p_guid               => l_guid,
 68        p_app_schema         => c_app_schema,
 69        p_entity_type        => 'EVENT_INSTANCES',
 70        p_entity_id          => '1001',
 71        p_current_updated_at => systimestamp - interval '1' second
 72      );
 73      assert_true('fresh when unchanged', l_fresh);
 74  
 75      cleanup(l_guid);
 76    end test_check_fresh_true_when_unchanged;
 77  
 78    procedure test_check_fresh_false_when_stale is
 79      l_guid   raw(16);
 80      l_fresh  boolean;
 81      l_outcome road_api_log.outcome%type;
 82    begin
 83      l_guid := road_audit_api.issue_read_token(
 84        p_caller_type => 'BROWSER',
 85        p_app_schema  => c_app_schema,
 86        p_endpoint    => 'get_event'
 87      );
 88  
 89      l_fresh := road_audit_api.check_fresh(
 90        p_guid               => l_guid,
 91        p_app_schema         => c_app_schema,
 92        p_entity_type        => 'EVENT_INSTANCES',
 93        p_entity_id          => '1001',
 94        p_current_updated_at => systimestamp + interval '1' second
 95      );
 96      assert_true('stale when row changed after token issued', not l_fresh);
 97  
 98      select outcome into l_outcome from road_api_log where log_id = l_guid;
 99      assert_eq('outcome', 'STALE_REJECTED', l_outcome);
100  
101      cleanup(l_guid);
102    end test_check_fresh_false_when_stale;
103  
104    procedure test_check_fresh_false_for_unknown_guid is
105      l_fresh boolean;
106    begin
107      l_fresh := road_audit_api.check_fresh(
108        p_guid               => sys_guid(),
109        p_app_schema         => c_app_schema,
110        p_entity_type        => 'EVENT_INSTANCES',
111        p_entity_id          => '1001',
112        p_current_updated_at => systimestamp
113      );
114      assert_true('unknown guid treated as stale', not l_fresh);
115    end test_check_fresh_false_for_unknown_guid;
116  
117    procedure run_all is
118      l_pass number := 0;
119      l_fail number := 0;
120  
121      -- cleanup() commits (autonomous rows can't be undone by ROLLBACK TO SAVEPOINT), which
122      -- invalidates any savepoint taken before that commit, so ROLLBACK TO SAVEPOINT here may
123      -- legitimately find nothing to roll back (ORA-01086). Expected, not a failure.
124      procedure rollback_if_possible is
125      begin
126        rollback to savepoint before_test;
127      exception
128        when others then
129          if sqlcode != -1086 then
130            raise;
131          end if;
132      end rollback_if_possible;
133  
134      procedure run(p_name in varchar2, p_proc in varchar2) is
135      begin
136        savepoint before_test;
137        case p_proc
138          when 'issue_creates_row'    then test_issue_read_token_creates_row;
139          when 'fresh_when_unchanged' then test_check_fresh_true_when_unchanged;
140          when 'stale_when_changed'   then test_check_fresh_false_when_stale;
141          when 'unknown_guid'         then test_check_fresh_false_for_unknown_guid;
142        end case;
143        rollback_if_possible;
144        dbms_output.put_line('PASS ' || p_name);
145        l_pass := l_pass + 1;
146      exception
147        when others then
148          rollback_if_possible;
149          dbms_output.put_line('FAIL ' || p_name || ': ' || sqlerrm);
150          l_fail := l_fail + 1;
151      end run;
152    begin
153      run('test_issue_read_token_creates_row', 'issue_creates_row');
154      run('test_check_fresh_true_when_unchanged', 'fresh_when_unchanged');
155      run('test_check_fresh_false_when_stale', 'stale_when_changed');
156      run('test_check_fresh_false_for_unknown_guid', 'unknown_guid');
157  
158      dbms_output.put_line('road_audit_api_test: ' || l_pass || ' passed, ' || l_fail || ' failed');
159    end run_all;
160  
161  end road_audit_api_test;
162  /

