 55    -- The two-tier split made explicit. road.role.grant lets a user_admin manage ordinary roles;
 56    -- touching a RESERVED role additionally needs road.role.define, which only road.system_admin
 57    -- holds. Nothing in the table structure prevents a user_admin granting road.system_admin --
 58    -- foreign keys do not know what the rows mean -- so it has to be a check, and a tested one.
 59    procedure assert_may_manage(p_role_name in varchar2) is
 60    begin
 61      if is_reserved(p_role_name) then
 62        road_ctx_pkg.require_permission('road.role.define');
 63      end if;
 64    end assert_may_manage;
 65  
 66    function get_principal_roles(p_request in json) return json is
 67      l_principal_id number;
 68      l_result       json;
 69    begin
 70      road_ctx_pkg.require_permission('road.role.grant');
 71  
 72      l_principal_id := json_value(p_request, '$.principal_id' returning number);
 73      if l_principal_id is null then
 74        raise_application_error(c_err_validation, 'principal_id is required');
 75      end if;
 76      assert_principal_exists(l_principal_id);
 77  
 78      select json_object(
 79               'principal_id' value p.principal_id,
 80               'subject'      value p.subject,
 81               'status'       value p.status,
 82               'roles'        value nvl((
 83                 select json_arrayagg(
 84                          json_object(
 85                            'role_name'  value pr.role_name,
 86                            'granted_at' value to_char(pr.granted_at, 'YYYY-MM-DD"T"HH24:MI:SSTZH:TZM'),
 87                            'granted_by' value pr.granted_by
 88                          )
 89                          order by pr.role_name returning json
 90                        )
 91                   from road_principal_roles pr
 92                  where pr.principal_id = p.principal_id
 93               ), json('[]'))
 94               returning json
 95             )
 96        into l_result
 97        from road_principals p
 98       where p.principal_id = l_principal_id;
 99  
100      return l_result;
101    end get_principal_roles;
102  
103    function grant_role(p_request in json) return json is
104      l_principal_id number;
105      l_role_name    varchar2(64 char);
106      l_granted_by   number;
107      l_existing     number;
108      l_granted      boolean := false;
109    begin
110      road_ctx_pkg.require_permission('road.role.grant');
111  
112      l_principal_id := json_value(p_request, '$.principal_id' returning number);
113      l_role_name    := json_value(p_request, '$.role_name' returning varchar2(64));
114  
115      if l_principal_id is null or l_role_name is null then
116        raise_application_error(c_err_validation, 'principal_id and role_name are required');
117      end if;
118  
119      assert_principal_exists(l_principal_id);
120      assert_role_exists(l_role_name);
121      assert_may_manage(l_role_name);
122  
123      -- Never from the request body. A caller who could nominate granted_by could forge the audit
124      -- trail of who authorised a privilege escalation, which is the one field that would expose it.
125      l_granted_by := road_ctx_pkg.principal_id;
126  
127      select count(*)
128        into l_existing
129        from road_principal_roles
130       where principal_id = l_principal_id
131         and role_name = l_role_name;
132  
133      if l_existing = 0 then
134        insert into road_principal_roles (principal_id, role_name, granted_by)
135        values (l_principal_id, l_role_name, l_granted_by);
136        l_granted := true;
137      end if;
138  
139      return json_object(
140               'principal_id' value l_principal_id,
141               'role_name'    value l_role_name,
142               'granted'      value l_granted,
143               'granted_by'   value l_granted_by
144               returning json
145             );
146    end grant_role;
147  
148    function revoke_role(p_request in json) return json is
149      l_principal_id number;
150      l_role_name    varchar2(64 char);
151      l_holders      number;
152      l_revoked      boolean := false;
153    begin
154      road_ctx_pkg.require_permission('road.role.revoke');
155  
156      l_principal_id := json_value(p_request, '$.principal_id' returning number);
157      l_role_name    := json_value(p_request, '$.role_name' returning varchar2(64));
158  
159      if l_principal_id is null or l_role_name is null then
160        raise_application_error(c_err_validation, 'principal_id and role_name are required');
161      end if;
162  
163      assert_principal_exists(l_principal_id);
164      assert_role_exists(l_role_name);
165      assert_may_manage(l_role_name);
166  
167      -- Refuse to remove the last system administrator. "The auth system works and nobody can
168      -- administer it" is the failure mode patch section 10 question 1 exists to prevent, and it is
169      -- reachable by an ordinary revoke as easily as by a bad deploy.
170      if l_role_name = 'road.system_admin' then
171        select count(*)
172          into l_holders
173          from road_principal_roles
174         where role_name = 'road.system_admin';
175  
176        if l_holders <= 1 then
177          raise_application_error(
178            c_err_validation,
179            'Refusing to revoke the last road.system_admin - grant it to another principal first'
180          );
181        end if;
182      end if;
183  
184      delete from road_principal_roles
185       where principal_id = l_principal_id
186         and role_name = l_role_name;
187  
188      l_revoked := sql%rowcount > 0;
189  
190      return json_object(
191               'principal_id' value l_principal_id,
192               'role_name'    value l_role_name,
193               'revoked'      value l_revoked
194               returning json
195             );
196    end revoke_role;
