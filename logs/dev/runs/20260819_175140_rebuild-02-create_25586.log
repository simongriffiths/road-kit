337    procedure test_grant_all_app_permissions_is_explicit is
338      l_before number;
339      l_after  number;
340    begin
341      insert into road_permissions (permission_name, description)
342      values ('test.appperm.one', 'road_admin test fixture');
343      insert into road_permissions (permission_name, description)
344      values ('test.appperm.two', 'road_admin test fixture');
345  
346      road_admin_api.grant_all_app_permissions('test.ordinary');
347  
348      -- three, not two: test.appperm.one and .two above, plus test.appperm.plain from setup.
349      -- test.appperm.reserved is the one that must NOT appear -- see below.
350      select count(*) into l_before
351        from road_role_permissions
352       where role_name = 'test.ordinary' and permission_name like 'test.appperm%';
353      assert_eq('unreserved app permissions granted', '3', to_char(l_before));
354  
355      -- No road.* permission may be picked up by the blanket grant.
356      select count(*) into l_after
357        from road_role_permissions
358       where role_name = 'test.ordinary' and permission_name like 'road.%';
359      assert_eq('no framework permissions granted', '0', to_char(l_after));
360  
361      -- THE regression test for spec-patch-08 section 7.1. Until 2026-08-19 this procedure filtered
362      -- on the road. prefix ALONE, so a RESERVED application permission -- events.purge in road-cal,
363      -- todo.purge in the demo app, test.appperm.reserved here -- was handed to whatever role was
364      -- named. That is the exact inference spec-patch-07 section 3.1 exists to forbid, in the package
365      -- spec-patch-07 amended. road-cal hit the symptom, hand-listed its user grants in 95_data.sql
366      -- to route around it, and left the cause shipping. This assertion is what stops it returning.
367      select count(*) into l_after
368        from road_role_permissions
369       where role_name = 'test.ordinary' and permission_name = 'test.appperm.reserved';
370      assert_eq('RESERVED app permission NOT granted', '0', to_char(l_after));
371  
372      -- A permission added AFTERWARDS must not be acquired -- that is rule 4, and the reason this is
373      -- a deploy-time write rather than a runtime wildcard.
374      insert into road_permissions (permission_name, description)
375      values ('test.appperm.three', 'added after the blanket grant');
376      select count(*) into l_after
377        from road_role_permissions
378       where role_name = 'test.ordinary' and permission_name = 'test.appperm.three';
379      assert_eq('later permission NOT silently acquired', '0', to_char(l_after));
380    end test_grant_all_app_permissions_is_explicit;
381  
382    ---------------------------------------------------------------------------
383    -- Role composition (spec-patch-07 section 7.1)
384    ---------------------------------------------------------------------------
385  
386    -- THE escalation test for this patch. If this check is removed the two-tier model collapses
387    -- silently: any road.role.compose holder could attach the framework's own reserved permissions
388    -- to any role.
389    procedure test_attach_reserved_permission_refused is
390      l_raised boolean := false;
391      l_res    json;
392      l_count  number;
393    begin
394      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then fail('establish'); end if;
395  
396      begin
397        -- test.idem, not test.ordinary: test_grant_all_app_permissions_is_explicit blanket-attaches
398        -- every unreserved non-road.* permission to test.ordinary (deploy-attached), so a row-count
399        -- check against it would be muddied by rows this test did not write.
400        -- test.appperm.reserved is reserved and does not start with road. -- proving the guard reads
401        -- the flag, not the name (spec-patch-07 section 3.1).
402        l_res := road_admin_api.attach_permission(
403                   json('{"role_name":"test.idem","permission_name":"test.appperm.reserved"}'));
404      exception
405        when others then
406          l_raised := true;
407          if sqlcode != road_ctx_pkg.c_forbidden then
408            fail('expected forbidden, got ' || sqlcode || ': ' || sqlerrm);
409          end if;
410      end;
411      if not l_raised then fail('attaching a reserved permission must be refused'); end if;
412  
413      select count(*) into l_count
414        from road_role_permissions
415       where role_name = 'test.idem' and permission_name = 'test.appperm.reserved';
416      assert_eq('no row written', '0', to_char(l_count));
417    end test_attach_reserved_permission_refused;
418  
419    -- A reserved ROLE's composition is framework-owned, even for an ordinary permission.
420    procedure test_attach_to_reserved_role_refused is
421      l_raised boolean := false;
422      l_res    json;
423      l_count  number;
424    begin
425      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then fail('establish'); end if;
426  
427      begin
428        l_res := road_admin_api.attach_permission(
429                   json('{"role_name":"road.user_admin","permission_name":"test.appperm.plain"}'));
430      exception
431        when others then
432          l_raised := true;
433          if sqlcode != road_ctx_pkg.c_forbidden then
434            fail('expected forbidden, got ' || sqlcode || ': ' || sqlerrm);
435          end if;
436      end;
437      if not l_raised then fail('attaching to a reserved role must be refused'); end if;
438  
439      select count(*) into l_count
440        from road_role_permissions
441       where role_name = 'road.user_admin' and permission_name = 'test.appperm.plain';
442      assert_eq('no row written', '0', to_char(l_count));
443    end test_attach_to_reserved_role_refused;
444  
445    -- THE test that proves spec-patch-07 section 1's claim end to end: composition is a data change,
446    -- not a release. Nothing tested this before now, because until this phase nothing COULD.
447    procedure test_composition_takes_effect_on_next_request is
448      l_res json;
449    begin
450      insert into road_permissions (permission_name, description)
451      values ('test.appperm.compose', 'road_admin test fixture');
452  
453      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then fail('establish'); end if;
454      l_res := road_admin_api.attach_permission(
455                 json('{"role_name":"test.composetarget","permission_name":"test.appperm.compose"}'));
456      assert_eq('attached', 'true', json_value(l_res, '$.attached'));
457  
458      -- TARGET holds test.composetarget (setup). Re-establishing loads effective permissions fresh
459      -- from road_role_permissions -- no deploy, no new machinery.
460      road_ctx_pkg.end_request;
461      if not road_ctx_pkg.begin_request('TARGET', c_issuer) then fail('TARGET should establish'); end if;
462      if not road_ctx_pkg.has_permission('test.appperm.compose') then
463        fail('composition did not take effect on the next request');
464      end if;
465    end test_composition_takes_effect_on_next_request;
466  
467    -- attached_by must come from the session, not the caller -- same forgery reason granted_by is
468    -- not read from the body on grant_role.
469    procedure test_attached_by_ignores_request_body is
470      l_res    json;
471      l_actual number;
472    begin
473      insert into road_permissions (permission_name, description)
474      values ('test.appperm.attachedby', 'road_admin test fixture');
475  
476      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then fail('establish'); end if;
477      l_res := road_admin_api.attach_permission(json(
478        '{"role_name":"test.ordinary","permission_name":"test.appperm.attachedby",'
479        || '"attached_by":999999}'));
480      assert_eq('attached', 'true', json_value(l_res, '$.attached'));
481  
482      select attached_by into l_actual
483        from road_role_permissions
484       where role_name = 'test.ordinary' and permission_name = 'test.appperm.attachedby';
485  
486      if l_actual = 999999 then
487        fail('attached_by was taken from the request body');
488      end if;
489      assert_eq('attached_by is the session principal',
490                to_char(principal_of('SYSADM')), to_char(l_actual));
491    end test_attached_by_ignores_request_body;
