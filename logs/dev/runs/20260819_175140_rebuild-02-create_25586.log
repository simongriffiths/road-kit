SQL> create or replace package road_ctx_pkg as
  2  
  3    -- Session identity and authorisation for ROAD applications (spec-patch-06 section 6).
  4    --
  5    -- The ROAD_CTX application context is created WITH THIS PACKAGE as its trusted setter
  6    -- (`create or replace context road_ctx using road_ctx_pkg`). That USING clause is the security
  7    -- control, not decoration: no other code in the schema can write identity into the context, so a
  8    -- handler cannot promote itself by calling dbms_session.set_context directly.
  9    --
 10    -- Usage at the top of a protected handler:
 11    --
 12    --   if not road_ctx_pkg.begin_request(:current_user) then
 13    --     :status_code := 401;
 14    --     return;
 15    --   end if;
 16    --   road_ctx_pkg.require_permission('events.create');
 17    --
 18    -- ORDS does not fire a schema-level pre-hook -- there is no registration API reachable from the
 19    -- schema -- so begin_request is called per handler. Everything here therefore fails closed: an
 20    -- unestablished context grants nothing, never everything.
 21  
 22    -- The application context namespace this schema uses.
 23    --
 24    -- Application contexts are DATABASE-GLOBAL, not schema-scoped: `create or replace context road_ctx
 25    -- using road_ctx_pkg` run from a second schema silently re-points the one shared namespace at that
 26    -- schema's package, and the first schema then gets ORA-01031 from dbms_session on every request.
 27    -- Found the hard way when the road-kit backport was deployed to the same ADB as road-cal.
 28    --
 29    -- Deriving it from the current schema makes two ROAD applications on one database independent.
 30    -- The deploy script creates a context with exactly this name.
 31    function namespace return varchar2;
 32  
 33    -- Raised by require_permission and require_role when an AUTHENTICATED principal lacks the
 34    -- requirement. Mapped by error_api to HTTP 403. The number is mnemonic: -20403 -> 403.
 35    -- A caller who is not authenticated at all is ORDS's 401 and never reaches here.
 36    c_forbidden constant number := -20403;
 37  
 38    -- Establishes session identity for one request. Resolves (issuer, subject) to a principal,
 39    -- requires status ACTIVE, and loads that principal's effective permissions into the context in
 40    -- one pass. Returns false -- never raises -- on any failure, including an unknown subject, a
 41    -- suspended principal, or an unresolvable issuer.
 42    --
 43    -- p_issuer defaults to null, in which case the issuer is read from the schema's own ORDS JWT
 44    -- profile. ORDS validates a token's iss against that profile before admitting the request, so the
 45    -- profile issuer is by construction the issuer the caller presented.
 46    --
 47    -- ALWAYS clears any existing context first. ORDS pools connections, so this session may still
 48    -- hold the previous caller's identity.
 49    function begin_request(
 50      p_subject in varchar2,
 51      p_issuer  in varchar2 default null
 52    ) return boolean;
 53  
 54    -- Clears all session identity. Safe to call when nothing was established.
 55    procedure end_request;
 56  
 57    function principal_id return number;
 58    function subject      return varchar2;
 59    function issuer       return varchar2;
 60  
 61    -- True only after a successful begin_request on this session.
 62    function is_authenticated return boolean;
 63  
 64    -- Coarse check, kept so a simple application can ignore permissions entirely. Permissions are
 65    -- what the framework teaches, because they make role composition a data change (section 6.1).
 66    function has_role(p_role_name in varchar2) return boolean;
 67  
 68    -- Reads the context, never the tables -- one query per request, not one per check.
 69    function has_permission(p_permission_name in varchar2) return boolean;
 70  
 71    -- Raise c_forbidden unless held.
 72    procedure require_role(p_role_name in varchar2);
 73    procedure require_permission(p_permission_name in varchar2);
 74  
 75  end road_ctx_pkg;
 76  /

