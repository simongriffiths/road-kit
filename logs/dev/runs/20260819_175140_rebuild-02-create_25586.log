SQL> create or replace package road_admin_api as
  2  
  3    -- Role administration (spec-patch-06 section 5, build plan phase 4).
  4    --
  5    -- Signature convention matches event_api: native JSON in, native JSON out, no ref cursors or
  6    -- PL/SQL collections across the package boundary. Never commits -- ORDS commits on success and
  7    -- tests roll back to a savepoint.
  8    --
  9    -- Authorisation is enforced HERE, not only in the handler. The handler's job is to establish
 10    -- session context from :current_user; the permission requirement travels with the operation, so
 11    -- a second caller -- an MCP tool, a batch job, another package -- cannot reach a privileged
 12    -- operation by not being an ORDS handler.
 13  
 14    -- GET /admin/principals/:principal_id/roles   requires road.role.grant
 15    -- p_request: { "principal_id": <number> }
 16    -- Returns:   { "principal_id": n, "subject": "...", "roles": [ { "role_name", "granted_at",
 17    --              "granted_by" }, ... ] }
 18    function get_principal_roles(p_request in json) return json;
 19  
 20    -- POST /admin/principals/:principal_id/roles   requires road.role.grant
 21    -- p_request: { "principal_id": <number>, "role_name": "<name>" }
 22    -- Returns:   { "principal_id": n, "role_name": "...", "granted": true|false }
 23    --            granted=false when the principal already held it -- idempotent, not an error.
 24    --
 25    -- granted_by is taken from road_ctx_pkg.principal_id and is never read from the request body.
 26    -- Granting a RESERVED role additionally requires road.role.define, which is what stops a
 27    -- road.user_admin promoting anyone -- including themselves -- to road.system_admin.
 28    function grant_role(p_request in json) return json;
 29  
 30    -- DELETE /admin/principals/:principal_id/roles/:role_name   requires road.role.revoke
 31    -- p_request: { "principal_id": <number>, "role_name": "<name>" }
 32    -- Returns:   { "principal_id": n, "role_name": "...", "revoked": true|false }
 33    --
 34    -- Revoking a reserved role also requires road.role.define, for the same reason as granting: a
 35    -- road.user_admin who could revoke road.system_admin could lock the real administrators out.
 36    -- Revoking the LAST holder of road.system_admin is refused outright.
 37    function revoke_role(p_request in json) return json;
 38  
 39    -- GET /admin/roles   requires road.role.grant
 40    -- Returns: { "roles": [ { "role_name", "display_name", "description", "is_reserved",
 41    --            "permissions": [...] }, ... ] }
 42    function get_roles(p_request in json default null) return json;
 43  
 44    -- GET /admin/principals   requires road.role.grant
 45    -- p_request: { "offset": n, "limit": n, "q": "<term>", "status": "ACTIVE|SUSPENDED|RETIRED" }
 46    --            all optional; offset defaults to 0, limit to 25 and is clamped to 1..100.
 47    -- Returns:   { "items": [ { "principal_id", "issuer", "subject", "email", "display_name",
 48    --              "status", "created_at",
 49    --              "roles": [ { "role_name", "is_reserved" }, ... ] }, ... ],
 50    --              "hasMore": bool, "limit": n, "offset": n, "count": n }
 51    --
 52    -- roles carries is_reserved (spec-patch-07 section 8.1), not bare names -- a client that infers
 53    -- reserved-ness from the road. prefix disagrees with assert_may_manage the moment they diverge.
 54    --
 55    -- The OrdsCollection wrapper the React conventions already define, so no new client type.
 56    -- hasMore comes from fetching limit+1 rows and discarding the extra -- there is deliberately no
 57    -- total count, which would be a second full scan to render a number nothing needs.
 58    --
 59    -- Gated on road.role.grant rather than road.role.define: reading who exists is what a
 60    -- road.user_admin needs to do their job, and they can already read anyone's grants.
 61    --
 62    -- Returns email. Someone who can grant roles can already read any principal's grants, so the
 63    -- login address does not widen that audience -- and subject is opaque by design (patch 4.2)
 64    -- while display_name is nullable, so without it an administrator often cannot tell two
 65    -- principals apart. It is still PII: never put q or the result in a URL a browser will log.
 66    --
 67    -- Deliberately NOT returned: effective permissions (they belong to roles, and get_roles already
 68    -- carries the mapping -- flattening them here would duplicate the composition in two places)
 69    -- and credentials_changed_at (credential-store surface, not role administration).
 70    function get_principals(p_request in json default null) return json;
 71  
 72    -- POST /admin/roles   requires road.role.define
 73    -- p_request: { "role_name": "<name>", "display_name": "...", "description": "..." }
 74    -- Returns:   the created role object.
 75    --
 76    -- Refuses the road. prefix: that namespace is reserved for the framework's own administration
 77    -- surface, and an application inventing a road.* role would be claiming framework authority.
 78    function define_role(p_request in json) return json;
 79  
 80    -- Deploy-time convenience (patch section 5.1). Grants every non-road. permission to a role by
 81    -- writing EXPLICIT ROWS -- it is not a runtime rule, because as a runtime rule it would be a
 82    -- wildcard and every permission added later would be acquired silently, violating rule 4.
 83    --
 84    -- Deliberately NOT permission-gated: it is called from deploy scripts running as the schema
 85    -- owner, where no session context exists. Gating it on "allow when no context is established"
 86    -- would be a fail-open, and gating it on a permission would make the deploy path need a
 87    -- principal. Do not call it from a handler.
 88    --
 89    -- Skips RESERVED permissions, and skips road.* ones. Both conditions, deliberately -- they are
 90    -- not the same question and neither implies the other. is_reserved answers "may a session attach
 91    -- this at all"; the road. prefix answers "is this the framework's own authority". A framework
 92    -- permission that is legitimately unreserved should still not be swept into an application role
 93    -- by a blanket grant, and an APPLICATION permission that is reserved (events.purge, todo.purge)
 94    -- does not start with road. at all -- which is precisely the case spec-patch-07 section 3.1 says
 95    -- a prefix rule gets wrong. This filter read the prefix ALONE until 2026-08-19; road-cal noticed
 96    -- the symptom when events.purge arrived and worked around it by hand-listing its user grants
 97    -- (95_data.sql), leaving the cause shipping. Do not "simplify" the two conditions back into one.
 98    --
 99    -- Even correct, it is only a convenience for the simple case. Any application with an admin-only
100    -- permission, or with an unreserved permission not every role should hold, spells its grants out
101    -- in 95_data.sql instead -- as road-cal does, and as the demo app in spec patch 08 does.
102    --
103    -- attached_by is written NULL explicitly (spec-patch-07 section 10 question 3), not by omission
104    -- -- this is the deploy-attached case road_reserved_composition's guard depends on being able to
105    -- tell apart from a session attach. See attach_permission below.
106    procedure grant_all_app_permissions(p_role_name in varchar2);
107  
108    -- Role composition (spec-patch-07 section 7). Attaching an existing permission to an existing
109    -- role is genuinely runtime data -- road_ctx_pkg.begin_request reloads effective permissions per
110    -- request, so the change takes effect on the caller's next request with no new machinery.
111    -- Creating a permission is NOT: that is a release-time act (section 2), and this package
112    -- deliberately has no function for it.
113  
114    -- GET /admin/permissions/   requires road.role.compose
115    -- Returns: { "permissions": [ { permission_name, description, is_reserved, roles: [...] }, ... ] }
116    --
117    -- Not a convenience: there is currently no other way to list road_permissions at all, so
118    -- nothing can offer a catalogue to compose from.
119    function get_permissions(p_request in json default null) return json;
120  
121    -- POST /admin/roles/:role_name/permissions/   requires road.role.compose
122    -- p_request: { "role_name": "<name>", "permission_name": "<name>" }
123    -- Returns:   { "role_name", "permission_name", "attached": true|false }
124    --            attached=false when already held -- idempotent, not an error, matching grant_role.
125    --
126    -- Refuses, as a flat refusal rather than a permission tier (unlike assert_may_manage's
127    -- road.role.define escalation for roles -- section 7 draws this distinction deliberately):
128    --   - a permission with is_reserved = 'Y' -- the framework's own authority is composed at
129    --     deploy time only, enforced in the database by road_reserved_composition
130    --   - a role with is_reserved = 'Y' -- a reserved role's composition is framework-owned
131    --
132    -- attached_by comes from road_ctx_pkg.principal_id and is never read from the body, for the same
133    -- reason granted_by is not on grant_role: a caller who could nominate it could forge the record
134    -- of who authorised an escalation.
135    function attach_permission(p_request in json) return json;
136  
137    -- DELETE /admin/roles/:role_name/permissions/:permission_name/   requires road.role.compose
138    -- p_request: { "role_name": "<name>", "permission_name": "<name>" }
139    -- Returns:   { "role_name", "permission_name", "detached": true|false }
140    --
141    -- Same two refusals as attach_permission. Detaching road.role.grant from the last role that
142    -- holds it is refused by the database (road_admin_reachable), not by this function -- that
143    -- assertion covers every writer, including ones that don't go through this package.
144    function detach_permission(p_request in json) return json;
145  
146  end road_admin_api;
147  /

