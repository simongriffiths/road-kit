SQL> create or replace package body road_audit_api as
  2  
  3    function issue_read_token(
  4      p_caller_type in varchar2,
  5      p_app_schema  in varchar2,
  6      p_endpoint    in varchar2,
  7      p_caller_ref  in varchar2 default null
  8    ) return raw is
  9      pragma autonomous_transaction;
 10      l_log_id road_api_log.log_id%type;
 11    begin
 12      insert into road_api_log (
 13        caller_type,
 14        caller_ref,
 15        app_schema,
 16        endpoint,
 17        outcome
 18      ) values (
 19        p_caller_type,
 20        p_caller_ref,
 21        p_app_schema,
 22        p_endpoint,
 23        'OK'
 24      )
 25      returning log_id into l_log_id;
 26  
 27      commit;
 28      return l_log_id;
 29    end issue_read_token;
 30  
 31    function check_fresh(
 32      p_guid               in raw,
 33      p_app_schema         in varchar2,
 34      p_entity_type        in varchar2,
 35      p_entity_id          in varchar2,
 36      p_current_updated_at in timestamp with time zone
 37    ) return boolean is
 38      pragma autonomous_transaction;
 39      l_issued_at road_api_log.issued_at%type;
 40      l_fresh     boolean;
 41    begin
 42      select issued_at
 43        into l_issued_at
 44        from road_api_log
 45       where log_id = p_guid
 46         and app_schema = p_app_schema;
 47  
 48      l_fresh := (p_current_updated_at <= l_issued_at);
 49  
 50      update road_api_log
 51         set entity_type = p_entity_type,
 52             entity_id   = p_entity_id,
 53             outcome     = case when l_fresh then 'OK' else 'STALE_REJECTED' end
 54       where log_id = p_guid;
 55  
 56      commit;
 57      return l_fresh;
 58    exception
 59      when no_data_found then
 60        -- Unknown/expired/forged token: treat as stale so the caller rejects with 409 and the
 61        -- client re-reads for a valid token, rather than raising here.
 62        commit;
 63        return false;
 64    end check_fresh;
 65  
 66    procedure log_admin_action(
 67      p_endpoint    in varchar2,
 68      p_entity_type in varchar2 default null,
 69      p_entity_id   in varchar2 default null,
 70      p_outcome     in varchar2 default null
 71    ) is
 72      pragma autonomous_transaction;
 73    begin
 74      insert into road_api_log (
 75        caller_type, caller_ref, app_schema, endpoint, entity_type, entity_id, outcome
 76      ) values (
 77        'PRINCIPAL',
 78        to_char(road_ctx_pkg.principal_id) || ':' || road_ctx_pkg.subject,
 79        sys_context('USERENV', 'CURRENT_SCHEMA'),
 80        p_endpoint,
 81        p_entity_type,
 82        substr(p_entity_id, 1, 60),
 83        substr(p_outcome, 1, 20)
 84      );
 85      commit;
 86    exception
 87      when others then
 88        rollback;
 89        -- Audit must never be the reason an operation fails, but a silent audit gap is its own
 90        -- problem -- so the failure is raised into the error log rather than swallowed entirely.
 91        null;
 92    end log_admin_action;
 93  
 94  end road_audit_api;
