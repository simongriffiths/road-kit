SQL> create or replace package body road_ctx_pkg as
  2  
  3    -- Namespace names are limited to 30 bytes, so this is the prefix plus as much of the schema name
  4    -- as fits. A schema name long enough to be truncated into a collision would fail loudly at deploy
  5    -- time -- dbms_session raises ORA-01031 when the namespace belongs to another schema's package --
  6    -- rather than silently sharing state, which is the failure mode that matters.
  7    c_namespace   constant varchar2(30)  :=
  8      substr('ROAD_CTX_' || sys_context('USERENV', 'CURRENT_SCHEMA'), 1, 30);
  9  
 10    -- Fixed attributes.
 11    c_attr_established  constant varchar2(30) := 'ESTABLISHED';
 12    c_attr_principal_id constant varchar2(30) := 'PRINCIPAL_ID';
 13    c_attr_subject      constant varchar2(30) := 'SUBJECT';
 14    c_attr_issuer       constant varchar2(30) := 'ISSUER';
 15  
 16    -- Roles and permissions are stored one attribute each, prefixed to keep them out of the fixed
 17    -- attribute space. Verified on ADB: context attribute names accept up to 128 bytes, so a 64-char
 18    -- role or permission name plus a 5-char prefix fits with room to spare. The alternative -- packing
 19    -- a delimited list into one 4000-byte value -- would have imposed a ceiling on how many
 20    -- permissions a role may compose, and needed parsing on every check.
 21    c_prefix_role constant varchar2(5) := 'ROLE$';
 22    c_prefix_perm constant varchar2(5) := 'PERM$';
 23  
 24    -- SYS_CONTEXT truncates at 256 bytes unless an explicit length is passed. issuer is
 25    -- varchar2(512 char) and subject varchar2(255 char), so the length argument is mandatory here,
 26    -- not defensive: without it a long issuer silently comes back truncated and no principal ever
 27    -- matches. Verified on dev -- a 1000-byte value read back as 256 without it, 1000 with it.
 28    c_len_issuer  constant pls_integer := 512;
 29    c_len_subject constant pls_integer := 255;
 30  
 31    -- Reads the issuer from the schema's own ORDS JWT profile. Correct only while trust is
 32    -- schema-level with a single profile; 99_verify asserts exactly one row for that reason. See
 33    -- planning/spike-06-1-iss-reachability.md section 4 for the constraint and the migration path.
 34    function resolve_issuer return varchar2 is
 35      l_issuer varchar2(512 char);
 36    begin
 37      select issuer into l_issuer from user_ords_jwt_profile;
 38      return l_issuer;
 39    exception
 40      -- Zero profiles or more than one: both are unresolvable, and guessing would be worse than
 41      -- denying. Fail closed.
 42      when others then
 43        return null;
 44    end resolve_issuer;
 45  
 46    function namespace return varchar2 is
 47    begin
 48      return c_namespace;
 49    end namespace;
 50  
 51    function config_value(p_key in varchar2) return varchar2 is
 52      l_value road_config.config_value%type;
 53    begin
 54      select config_value into l_value from road_config where config_key = p_key;
 55      return l_value;
 56    exception
 57      when no_data_found then
 58        return null;
 59    end config_value;
 60  
 61    -- Creates a principal for a subject the issuer has authenticated but this application has never
 62    -- seen, and grants it road_config.default_principal_role.
 63    --
 64    -- Gated on road_config.auto_provision_principals = 'Y'. Off means an unknown subject is denied,
 65    -- which is rule 3's default; on means the issuer is trusted to decide who exists. That is a
 66    -- posture decision per deployment, not a mechanism, which is why it is a row rather than code.
 67    --
 68    -- Returns the principal_id, or null when provisioning is off or fails.
 69    function provision_principal(
 70      p_issuer  in varchar2,
 71      p_subject in varchar2
 72    ) return number is
 73      pragma autonomous_transaction;
 74      l_principal_id number;
 75      l_role         road_config.config_value%type;
 76    begin
 77      if nvl(config_value('auto_provision_principals'), 'N') != 'Y' then
 78        rollback;
 79        return null;
 80      end if;
 81  
 82      l_role := config_value('default_principal_role');
 83  
 84      begin
 85        insert into road_principals (issuer, subject, display_name)
 86        values (p_issuer, p_subject, p_subject)
 87        returning principal_id into l_principal_id;
 88      exception
 89        when dup_val_on_index then
 90          -- Two first requests for the same new subject can race. The unique constraint on
 91          -- (issuer, subject) is what makes that safe: the loser reads the winner's row rather than
 92          -- failing the request, so a genuine user is never denied because they arrived twice at once.
 93          rollback;
 94          select principal_id into l_principal_id
 95            from road_principals
 96           where issuer = p_issuer and subject = p_subject;
 97          return l_principal_id;
 98      end;
 99  
100      -- No default role configured, or it has been deleted: the principal exists but holds nothing.
101      -- Fail closed -- an account with no permissions is recoverable by an administrator, whereas
102      -- silently substituting some other role would not be.
103      if l_role is not null then
104        begin
105          insert into road_principal_roles (principal_id, role_name)
106          values (l_principal_id, l_role);
107        exception
108          when others then
109            null;
110        end;
111      end if;
112  
113      -- Autonomous so the new principal survives even if the request that triggered it later rolls
114      -- back. Otherwise a failing first request would leave the user unprovisioned and they would hit
115      -- the same path again on every retry.
116      commit;
117      return l_principal_id;
118    exception
119      when others then
120        rollback;
121        return null;
122    end provision_principal;
123  
124    procedure end_request is
125    begin
126      dbms_session.clear_all_context(c_namespace);
127    end end_request;
128  
129    function begin_request(
130      p_subject in varchar2,
131      p_issuer  in varchar2 default null
132    ) return boolean is
133      l_issuer       varchar2(512 char);
134      l_subject      varchar2(255 char);
135      l_principal_id number;
136      l_status       varchar2(20 char);
137    begin
138      -- 1. Clear FIRST, unconditionally, before any validation. ORDS pools connections, so this
139      --    session may still be carrying the previous caller's principal and permissions. Clearing
140      --    up front means every failure path below -- including an exception -- leaves the session
141      --    holding nothing rather than holding somebody else.
142      dbms_session.clear_all_context(c_namespace);
143  
144      l_subject := trim(p_subject);
145      if l_subject is null then
146        return false;
147      end if;
148  
149      l_issuer := nvl(p_issuer, resolve_issuer);
150      if l_issuer is null then
151        return false;
152      end if;
153  
154      begin
155        select principal_id, status
156          into l_principal_id, l_status
157          from road_principals
158         where issuer = l_issuer
159           and subject = l_subject;
160      exception
161        when no_data_found then
162          -- The issuer authenticated them; this application has simply never seen them before.
163          l_principal_id := provision_principal(l_issuer, l_subject);
164          if l_principal_id is null then
165            return false;
166          end if;
167          l_status := 'ACTIVE';
168      end;
169  
170      -- 2. Only ACTIVE principals get a session. SUSPENDED and RETIRED authenticate at ORDS -- their
171      --    token is still valid -- and are denied here.
172      if l_status != 'ACTIVE' then
173        return false;
174      end if;
175  
176      dbms_session.set_context(c_namespace, c_attr_principal_id, to_char(l_principal_id));
177      dbms_session.set_context(c_namespace, c_attr_subject, l_subject);
178      dbms_session.set_context(c_namespace, c_attr_issuer, l_issuer);
179  
180      -- 3. Roles and effective permissions, loaded once. Permissions are the union across the
181      --    principal's roles with no hierarchy (rule 2), so a plain DISTINCT join is the whole rule.
182      for r in (
183        select role_name
184          from road_principal_roles
185         where principal_id = l_principal_id
186      ) loop
187        dbms_session.set_context(c_namespace, c_prefix_role || r.role_name, 'Y');
188      end loop;
189  
190      for p in (
191        select distinct rp.permission_name
192          from road_principal_roles pr
193          join road_role_permissions rp
194            on rp.role_name = pr.role_name
195         where pr.principal_id = l_principal_id
196      ) loop
197        dbms_session.set_context(c_namespace, c_prefix_perm || p.permission_name, 'Y');
198      end loop;
199  
200      -- 4. ESTABLISHED goes last, deliberately. If loading raised part-way through, this is never
201      --    set, so is_authenticated stays false and a half-populated context cannot be mistaken for
202      --    a complete one.
203      dbms_session.set_context(c_namespace, c_attr_established, 'Y');
204  
205      return true;
206    exception
207      when others then
208        -- Any unexpected failure denies and leaves nothing behind. Fail closed, per rule 3.
209        begin
210          dbms_session.clear_all_context(c_namespace);
211        exception
212          when others then
213            null;
214        end;
215        return false;
216    end begin_request;
217  
218    -- NVL is load-bearing, not decoration. SYS_CONTEXT returns NULL for an attribute that was never
219    -- set, and NULL = 'Y' evaluates to NULL rather than FALSE. A NULL returned from here would make
220    -- "if not is_authenticated then return false" fail to fire, and "if not has_permission then
221    -- raise" fail to raise -- so an unheld permission would pass silently. Rule 3 requires false,
222    -- never null. Caught by test_pooled_session_does_not_bleed, which asserted FALSE and got NULL.
223    function is_authenticated return boolean is
224    begin
225      return nvl(sys_context(c_namespace, c_attr_established), 'N') = 'Y';
226    end is_authenticated;
227  
228    function principal_id return number is
229    begin
230      if not is_authenticated then
231        return null;
232      end if;
233      return to_number(sys_context(c_namespace, c_attr_principal_id));
234    end principal_id;
235  
236    function subject return varchar2 is
237    begin
238      if not is_authenticated then
239        return null;
240      end if;
241      return sys_context(c_namespace, c_attr_subject, c_len_subject);
242    end subject;
243  
244    function issuer return varchar2 is
245    begin
246      if not is_authenticated then
247        return null;
248      end if;
249      return sys_context(c_namespace, c_attr_issuer, c_len_issuer);
250    end issuer;
251  
252    function has_role(p_role_name in varchar2) return boolean is
253    begin
254      -- The is_authenticated gate is what makes an unestablished context return false rather than
255      -- null-tolerant nonsense (section 6.3). Never true, never null.
256      if not is_authenticated or p_role_name is null then
257        return false;
258      end if;
259      return nvl(sys_context(c_namespace, c_prefix_role || p_role_name), 'N') = 'Y';
260    end has_role;
261  
262    function has_permission(p_permission_name in varchar2) return boolean is
263    begin
264      if not is_authenticated or p_permission_name is null then
265        return false;
266      end if;
267      return nvl(sys_context(c_namespace, c_prefix_perm || p_permission_name), 'N') = 'Y';
268    end has_permission;
269  
270    procedure require_role(p_role_name in varchar2) is
271    begin
272      if not has_role(p_role_name) then
273        raise_application_error(c_forbidden, 'Role required: ' || p_role_name);
274      end if;
275    end require_role;
276  
277    procedure require_permission(p_permission_name in varchar2) is
278    begin
279      if not has_permission(p_permission_name) then
280        raise_application_error(c_forbidden, 'Permission required: ' || p_permission_name);
281      end if;
282    end require_permission;
283  
284  end road_ctx_pkg;
285  /

