SQL> prompt --- bootstrap administrator ---
--- bootstrap administrator --
SQL> -- Phase 0.2 decision: road.system_admin is seeded from deploy configuration, not handed to whoever
SQL> -- authenticates first. Break-glass on first login is a race, and on an internet-facing dev host
SQL> -- whoever wins it owns the system.
SQL> --
SQL> -- The issuer is read from the schema's own JWT profile rather than configured separately. ORDS
SQL> -- validates a token's iss against that profile before admitting the request, so the profile issuer
SQL> -- is by construction the issuer any real caller will present -- which is what makes the seeded
SQL> -- principal actually matchable at login. See planning/spike-06-1-iss-reachability.md.
SQL> declare
  2    l_issuer       varchar2(512 char);
  3    l_subject      road_config.config_value%type;
  4    l_principal_id road_principals.principal_id%type;
  5    l_admin_count  number;
  6    l_profiles     number;
  7    l_default_role road_config.config_value%type;
  8  begin
  9    select count(*) into l_profiles from user_ords_jwt_profile;
 10  
 11    if l_profiles != 1 then
 12      -- Fail loudly rather than seeding a principal against a guessed issuer. 99_verify asserts this
 13      -- too; the deploy should not reach a state where identity exists but nobody can administer it.
 14      dbms_output.put_line(
 15        '[WARN] Expected exactly one ORDS JWT profile, found ' || l_profiles
 16        || ' - bootstrap administrator NOT seeded'
 17      );
 18      return;
 19    end if;
 20  
 21    select issuer into l_issuer from user_ords_jwt_profile;
 22  
 23    select config_value
 24      into l_subject
 25      from road_config
 26     where config_key = 'bootstrap_admin_subject';
 27  
 28    if l_subject is null then
 29      dbms_output.put_line('[WARN] road_config.bootstrap_admin_subject is empty - bootstrap administrator NOT seeded');
 30      return;
 31    end if;
 32  
 33    -- Ensure the principal exists. Matched on (issuer, subject), which is the real key.
 34    begin
 35      select principal_id
 36        into l_principal_id
 37        from road_principals
 38       where issuer = l_issuer
 39         and subject = l_subject;
 40    exception
 41      when no_data_found then
 42        insert into road_principals (issuer, subject, display_name)
 43        values (l_issuer, l_subject, 'Bootstrap Administrator')
 44        returning principal_id into l_principal_id;
 45  
 46        dbms_output.put_line('[INFO] Created bootstrap principal ' || l_principal_id
 47                             || ' for ' || l_issuer || ' / ' || l_subject);
 48    end;
 49  
 50    -- Grant road.system_admin only when nobody holds it at all. This makes a re-deploy a rescue for a
 51    -- deployment with zero administrators, without ever fighting an operator who deliberately revoked
 52    -- this particular principal while others remain. It is not break-glass: the identity is fixed by
 53    -- configuration in advance, so there is no race and no first-come-first-served.
 54    select count(*)
 55      into l_admin_count
 56      from road_principal_roles
 57     where role_name = 'road.system_admin';
 58  
 59    if l_admin_count = 0 then
 60      insert into road_principal_roles (principal_id, role_name)
 61      values (l_principal_id, 'road.system_admin');
 62  
 63      dbms_output.put_line('[INFO] Granted road.system_admin to principal ' || l_principal_id);
 64    else
 65      dbms_output.put_line('[INFO] ' || l_admin_count
 66                           || ' principal(s) already hold road.system_admin - no grant made');
 67    end if;
 68  
 69    -- The administrator also needs the ordinary application role. road.system_admin grants the four
 70    -- road.* permissions and NOTHING else -- rule 2 forbids hierarchy, so it does not inherit
 71    -- application permissions and never should. Without this the bootstrap admin can administer roles
 72    -- and cannot read its own session, which is exactly what happened the first time phase 6 ran.
 73    --
 74    -- Being an administrator is additional to being a user, not instead of it.
 75    select config_value into l_default_role
 76      from road_config where config_key = 'default_principal_role';
 77  
 78    if l_default_role is not null then
 79      insert into road_principal_roles (principal_id, role_name)
 80      select l_principal_id, l_default_role from dual
 81       where not exists (select 1 from road_principal_roles
 82                          where principal_id = l_principal_id and role_name = l_default_role)
 83         and exists (select 1 from road_roles where role_name = l_default_role);
 84    end if;
 85  end;
 86  /
