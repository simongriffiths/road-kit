 31    procedure setup is
 32      l_sys    number;
 33      l_usr    number;
 34      l_tgt    number;
 35      l_target number;
 36    begin
 37      execute immediate 'alter session disable parallel dml';
 38  
 39      insert into road_principals (issuer, subject, display_name, status)
 40      select c_issuer, 'SYSADM', 'road_admin test fixture', 'ACTIVE' from dual
 41       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'SYSADM');
 42      insert into road_principals (issuer, subject, display_name, status)
 43      select c_issuer, 'USRADM', 'road_admin test fixture', 'ACTIVE' from dual
 44       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'USRADM');
 45      insert into road_principals (issuer, subject, display_name, status)
 46      select c_issuer, 'TARGET', 'road_admin test fixture', 'ACTIVE' from dual
 47       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'TARGET');
 48  
 49      -- Distinctive name and address, so the get_principals search tests can assert an exact count
 50      -- against a database that also holds the real seeded principals.
 51      insert into road_principals (issuer, subject, display_name, email, status)
 52      select c_issuer, 'SEARCHME', 'Searchable Fixture', 'find.me@example.test', 'ACTIVE' from dual
 53       where not exists (select 1 from road_principals
 54                          where issuer = c_issuer and subject = 'SEARCHME');
 55  
 56      -- One role per grant test. Sharing a single role made two tests pass or fail depending on
 57      -- which ran first: whoever granted it first owned granted_by, and every later grant was a
 58      -- correct no-op that read as a failure.
 59      insert into road_roles (role_name, display_name, is_reserved)
 60      select 'test.ordinary', 'road_admin test fixture', 'N' from dual
 61       where not exists (select 1 from road_roles where role_name = 'test.ordinary');
 62      insert into road_roles (role_name, display_name, is_reserved)
 63      select 'test.grantedby', 'road_admin test fixture', 'N' from dual
 64       where not exists (select 1 from road_roles where role_name = 'test.grantedby');
 65      insert into road_roles (role_name, display_name, is_reserved)
 66      select 'test.idem', 'road_admin test fixture', 'N' from dual
 67       where not exists (select 1 from road_roles where role_name = 'test.idem');
 68  
 69      -- Two APPLICATION permission fixtures, one reserved and one not. Neither starts with road.,
 70      -- which is the whole point: spec-patch-07 section 3.1's rule is that reserved-ness is read
 71      -- from the column and never inferred from the name, and only an application permission can
 72      -- exercise it.
 73      --
 74      -- Seeded by this suite rather than borrowed from the adopting application's own data, so the
 75      -- file stays byte-identical across repos. It did borrow, until 2026-08-19: it named
 76      -- events.purge and session.read, which are road-cal's, and the two composition tests below
 77      -- therefore failed with ORA-20004 the first time this suite ran in road-kit. A framework test
 78      -- suite must not depend on any particular adopter existing.
 79      insert into road_permissions (permission_name, description, is_reserved)
 80      select 'test.appperm.reserved', 'road_admin test fixture, reserved', 'Y' from dual
 81       where not exists (select 1 from road_permissions
 82                          where permission_name = 'test.appperm.reserved');
 83      insert into road_permissions (permission_name, description, is_reserved)
 84      select 'test.appperm.plain', 'road_admin test fixture, unreserved', 'N' from dual
 85       where not exists (select 1 from road_permissions
 86                          where permission_name = 'test.appperm.plain');
 87      insert into road_roles (role_name, display_name, is_reserved)
 88      select 'test.searchable', 'road_admin test fixture', 'N' from dual
 89       where not exists (select 1 from road_roles where role_name = 'test.searchable');
 90      -- Dedicated to test_composition_takes_effect_on_next_request -- NOT test.ordinary, which
 91      -- test_grant_all_app_permissions_is_explicit blanket-attaches every application permission to
 92      -- (deploy-attached), and which test_user_admin_cannot_grant_reserved's own grant_role call
 93      -- assumes TARGET does not already hold.
 94      insert into road_roles (role_name, display_name, is_reserved)
 95      select 'test.composetarget', 'road_admin test fixture', 'N' from dual
 96       where not exists (select 1 from road_roles where role_name = 'test.composetarget');
 97  
 98      l_sys := principal_of('SYSADM');
 99      l_usr := principal_of('USRADM');
100      l_tgt := principal_of('SEARCHME');
101  
102      insert into road_principal_roles (principal_id, role_name)
103      select l_tgt, 'test.searchable' from dual
104       where not exists (select 1 from road_principal_roles
105                          where principal_id = l_tgt and role_name = 'test.searchable');
106  
107      insert into road_principal_roles (principal_id, role_name)
108      select l_sys, 'road.system_admin' from dual
109       where not exists (select 1 from road_principal_roles
110                          where principal_id = l_sys and role_name = 'road.system_admin');
111      insert into road_principal_roles (principal_id, role_name)
112      select l_usr, 'road.user_admin' from dual
113       where not exists (select 1 from road_principal_roles
114                          where principal_id = l_usr and role_name = 'road.user_admin');
115  
116      -- TARGET holds test.composetarget directly (not via another test's side effect), so
117      -- test_composition_takes_effect_on_next_request stays correct regardless of run order.
118      l_target := principal_of('TARGET');
119      insert into road_principal_roles (principal_id, role_name)
120      select l_target, 'test.composetarget' from dual
121       where not exists (select 1 from road_principal_roles
122                          where principal_id = l_target and role_name = 'test.composetarget');
123      commit;
124    end setup;
