 53                   when regexp_like(:requested_path, '\.[[:alnum:]]+$') then :requested_path
 54                   else 'index.html'
 55                 end as resolved_path
 56            from dual
 57        )
 58        select a.content_type as "Content-Type",
 59               a.content as blob
 60          from ui_assets a
 61          join request_path r
 62            on a.relative_path = r.resolved_path
 63         where a.app_name = 'hello_world'
 64           and r.resolved_path != '__invalid__'
 65      ]',
