SQL> create or replace package body error_api as
  2  
  3    -- Never raises: a logging failure must not cause a secondary failure
  4    -- (spec/error-handling-contract-v1.md §5.2). Autonomous so the log entry survives even when
  5    -- the caller's transaction rolls back around this error.
  6    procedure write_error_log(
  7      p_sqlcode   in number,
  8      p_sqlerrm   in varchar2,
  9      p_backtrace in varchar2,
 10      p_context   in varchar2
 11    ) is
 12      pragma autonomous_transaction;
 13    begin
 14      insert into error_log (sqlcode, sqlerrm, backtrace, context)
 15      values (p_sqlcode, p_sqlerrm, p_backtrace, p_context);
 16      commit;
 17    exception
 18      when others then
 19        null;
 20    end write_error_log;
 21  
 22    procedure handle_known(
 23      p_sqlcode     in number,
 24      p_sqlerrm     in varchar2,
 25      p_status_code out number,
 26      p_response    out clob
 27    ) is
 28      l_error   varchar2(60);
 29      l_message varchar2(4000);
 30    begin
 31      -- Fixed mapping per calendar-app-design-outline.md §"Error signalling from EVENT_API to
 32      -- ORDS". Not a generic range-based scheme (e.g. 20000-20099 => 400): each code is a
 33      -- deliberately chosen business meaning, so it is listed explicitly rather than derived.
 34      case p_sqlcode
 35        when -20001 then
 36          l_error := 'VALIDATION_ERROR';
 37          p_status_code := 400;
 38        when -20003 then
 39          l_error := 'AGENDA_LOCKED';
 40          p_status_code := 422;
 41        when -20004 then
 42          l_error := 'NOT_FOUND';
 43          p_status_code := 404;
 44        when -20009 then
 45          l_error := 'CONFLICT';
 46          p_status_code := 409;
 47        when -20403 then
 48          -- road_ctx_pkg.c_forbidden. An AUTHENTICATED principal that lacks a required permission or
 49          -- role. Distinct from 401 by design: ORDS returns 401 for no token, a bad token or a
 50          -- missing scope, before any PL/SQL runs. Reaching here means the caller is who they say
 51          -- they are and still may not do this (spec-patch-06 section 6.4). Without the distinction
 52          -- a permission failure would surface as a 500 or as a 401 that misreports the cause.
 53          -- The code is mnemonic: -20403 -> 403.
 54          l_error := 'FORBIDDEN';
 55          p_status_code := 403;
 56        when -8601 then
 57          -- road_reserved_composition or road_admin_reachable (spec-patch-07 section 5.5), outside
 58          -- the -20000..-20999 range this function's caller normally tests before dispatching here --
 59          -- the handlers that can reach this table widen their own routing check to include -8601.
 60          -- Defence in depth, not the primary path: road_admin_api checks is_reserved itself and
 61          -- raises -20403 first, so reaching an actual assertion violation means that package check
 62          -- was bypassed (a second caller, a hand-typed INSERT) or has a bug. 403, not 422 or 500:
 63          -- the caller is authenticated and the operation is refused -- that it is refused to
 64          -- everyone rather than to them specifically does not change the shape of the answer.
 65          l_error := 'FORBIDDEN';
 66          p_status_code := 403;
 67        else
 68          -- A code inside the reserved range but outside the fixed mapping is a coding mistake,
 69          -- not a known business error — escalate rather than emit a response with a null
 70          -- error/status. Never silently return a malformed body (contract §2 principle 1).
 71          handle_unknown(
 72            p_sqlerrm     => p_sqlerrm,
 73            p_backtrace   => dbms_utility.format_error_backtrace,
 74            p_context     => 'error_api.handle_known: unmapped known-range sqlcode ' || p_sqlcode,
 75            p_status_code => p_status_code,
 76            p_response    => p_response
 77          );
 78          return;
 79      end case;
 80  
 81      -- raise_application_error(-20001, 'msg') surfaces as sqlerrm = 'ORA-20001: msg'; strip the
 82      -- code prefix so message carries only the user-safe text passed to raise_application_error.
 83      l_message := regexp_replace(p_sqlerrm, '^ORA-[0-9]+:\s*', '');
 84  
 85      select json_object(
 86               'error'    value l_error,
 87               'message'  value l_message,
 88               'ora_code' value 'ORA-' || to_char(-p_sqlcode, 'FM00000')
 89               returning clob
 90             )
 91        into p_response
 92        from dual;
 93    end handle_known;
 94  
 95    procedure handle_unknown(
 96      p_sqlerrm     in varchar2,
 97      p_backtrace   in varchar2,
 98      p_context     in varchar2 default null,
 99      p_status_code out number,
100      p_response    out clob
101    ) is
102    begin
103      write_error_log(
104        p_sqlcode   => sqlcode,
105        p_sqlerrm   => p_sqlerrm,
106        p_backtrace => p_backtrace,
107        p_context   => p_context
108      );
109  
110      p_status_code := 500;
111  
112      -- Generic message only — never echo sqlerrm/backtrace to the client (contract §3.2).
113      select json_object(
114               'error'   value 'INTERNAL_ERROR',
115               'message' value 'An unexpected error occurred'
116               returning clob
117             )
118        into p_response
119        from dual;
120    end handle_unknown;
121  
122  end error_api;
123  /

