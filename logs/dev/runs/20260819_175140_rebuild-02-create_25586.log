516    -- A road.user_admin holds neither road.role.compose. Denial must hold for both mutators.
517    procedure test_compose_denied_without_permission is
518      l_raised boolean := false;
519      l_res    json;
520    begin
521      if not road_ctx_pkg.begin_request('USRADM', c_issuer) then fail('establish'); end if;
522  
523      begin
524        l_res := road_admin_api.attach_permission(
525                   json('{"role_name":"test.ordinary","permission_name":"session.read"}'));
526      exception
527        when others then
528          l_raised := true;
529          if sqlcode != road_ctx_pkg.c_forbidden then
530            fail('expected forbidden, got ' || sqlcode);
531          end if;
532      end;
533      if not l_raised then fail('attach_permission must deny without road.role.compose'); end if;
534  
535      l_raised := false;
536      begin
537        l_res := road_admin_api.detach_permission(
538                   json('{"role_name":"test.ordinary","permission_name":"session.read"}'));
539      exception
540        when others then
541          l_raised := true;
542          if sqlcode != road_ctx_pkg.c_forbidden then
543            fail('expected forbidden, got ' || sqlcode);
544          end if;
545      end;
546      if not l_raised then fail('detach_permission must deny without road.role.compose'); end if;
547    end test_compose_denied_without_permission;
