198    function get_roles(p_request in json default null) return json is
199      l_result json;
200    begin
201      road_ctx_pkg.require_permission('road.role.grant');
202  
203      select json_object(
204               'roles' value nvl((
205                 select json_arrayagg(
206                          json_object(
207                            'role_name'    value r.role_name,
208                            'display_name' value r.display_name,
209                            'description'  value r.description,
210                            'is_reserved'  value r.is_reserved,
211                            'permissions'  value nvl((
212                              select json_arrayagg(rp.permission_name
213                                                   order by rp.permission_name returning json)
214                                from road_role_permissions rp
215                               where rp.role_name = r.role_name
216                            ), json('[]'))
217                          )
218                          order by r.role_name returning json
219                        )
220                   from road_roles r
221               ), json('[]'))
222               returning json
223             )
224        into l_result
225        from dual;
226  
227      return l_result;
228    end get_roles;
229  
230    -- A search term is user input reaching a LIKE pattern, so its wildcards have to be neutralised or
231    -- a user typing '%' silently matches everything and a user typing '_' matches one of anything.
232    -- Escape the escape character first, or escaping the wildcards re-introduces it.
233    function like_term(p_term in varchar2) return varchar2 is
234    begin
235      return '%' || replace(replace(replace(lower(p_term), '\', '\\'), '%', '\%'), '_', '\_') || '%';
236    end like_term;
237  
238    function get_principals(p_request in json default null) return json is
239      c_default_limit constant number := 25;
240      c_max_limit     constant number := 100;
241  
242      l_offset  number;
243      l_limit   number;
244      l_q       varchar2(4000 char);
245      l_status  varchar2(20 char);
246      l_pattern varchar2(4000 char);
247  
248      l_items   json;
249      l_fetched number;
250    begin
251      road_ctx_pkg.require_permission('road.role.grant');
252  
253      l_offset := nvl(json_value(p_request, '$.offset' returning number), 0);
254      l_limit  := nvl(json_value(p_request, '$.limit'  returning number), c_default_limit);
255      l_q      := json_value(p_request, '$.q'      returning varchar2(4000));
256      l_status := json_value(p_request, '$.status' returning varchar2(20));
257  
258      -- Clamped rather than rejected: an out-of-range page size is a client bug, not a caller error,
259      -- and an unclamped limit is a denial-of-service parameter.
260      l_offset := greatest(nvl(l_offset, 0), 0);
261      l_limit  := least(greatest(nvl(l_limit, c_default_limit), 1), c_max_limit);
262  
263      -- An unrecognised status IS rejected, because silently ignoring it would return the unfiltered
264      -- list and the caller would believe it had filtered.
265      if l_status is not null
266         and l_status not in ('ACTIVE', 'SUSPENDED', 'RETIRED') then
267        raise_application_error(
268          c_err_validation,
269          'status must be one of ACTIVE, SUSPENDED, RETIRED: ' || l_status
270        );
271      end if;
272  
273      if l_q is not null and length(trim(l_q)) > 0 then
274        l_pattern := like_term(trim(l_q));
275      end if;
276  
277      -- One pass. row_number over the filtered set lets the page and the "is there another page"
278      -- answer come from the same predicate -- two statements would mean two copies of the WHERE
279      -- clause, which is exactly the pair that drifts. limit+1 rows are counted and the extra one is
280      -- dropped from the array by the CASE (json_arrayagg is ABSENT ON NULL by default), so hasMore
281      -- costs no second scan and no count(*) over the whole table.
282      select nvl(json_arrayagg(
283               case when rn <= l_limit then
284                 json_object(
285                   'principal_id' value principal_id,
286                   'issuer'       value issuer,
287                   'subject'      value subject,
288                   'email'        value email,
289                   'display_name' value display_name,
290                   'status'       value status,
291                   'created_at'   value to_char(created_at, 'YYYY-MM-DD"T"HH24:MI:SSTZH:TZM'),
292                   'roles'        value nvl((
293                     -- {role_name, is_reserved} objects, not bare names (spec-patch-07 section 8.1):
294                     -- PrincipalsPanel.tsx used to style pills by testing role.startsWith('road.'),
295                     -- justified as cosmetic-only because this endpoint returned names only. Under
296                     -- rule 6 that justification is weaker than it reads -- the flag is the answer,
297                     -- the prefix is a convention it happens to follow today -- so the panel now
298                     -- reads the flag, like PrincipalRolesDialog already does.
299                     select json_arrayagg(
300                              json_object('role_name' value pr.role_name, 'is_reserved' value r.is_reserved)
301                              order by pr.role_name returning json
302                            )
303                       from road_principal_roles pr, road_roles r
304                      where pr.principal_id = paged.principal_id
305                        and r.role_name = pr.role_name
306                   ), json('[]'))
307                   returning json
308                 )
309               end
310               order by rn returning json
311             ), json('[]')),
312             count(*)
313        into l_items, l_fetched
314        from (
315          select p.principal_id,
316                 p.issuer,
317                 p.subject,
318                 p.email,
319                 p.display_name,
320                 p.status,
321                 p.created_at,
322                 row_number() over (
323                   order by lower(coalesce(p.display_name, p.subject)), p.principal_id
324                 ) - l_offset as rn
325            from road_principals p
326           where (l_status is null or p.status = l_status)
327             and (l_pattern is null
328                  or lower(p.display_name) like l_pattern escape '\'
329                  or lower(p.email)        like l_pattern escape '\'
330                  or lower(p.subject)      like l_pattern escape '\')
331        ) paged
332       where rn between 1 and l_limit + 1;
333  
334      return json_object(
335               'items'   value l_items,
336               'hasMore' value case when l_fetched > l_limit then 'true' else 'false' end
337                               format json,
338               'limit'   value l_limit,
339               'offset'  value l_offset,
340               'count'   value least(l_fetched, l_limit)
341               returning json
342             );
343    end get_principals;
344  
345    function define_role(p_request in json) return json is
346      l_role_name    varchar2(64 char);
347      l_display_name varchar2(255 char);
348      l_description  varchar2(4000 char);
349      l_existing     number;
350    begin
351      road_ctx_pkg.require_permission('road.role.define');
352  
353      l_role_name    := json_value(p_request, '$.role_name' returning varchar2(64));
354      l_display_name := json_value(p_request, '$.display_name' returning varchar2(255));
355      l_description  := json_value(p_request, '$.description' returning varchar2(4000));
356  
357      if l_role_name is null then
358        raise_application_error(c_err_validation, 'role_name is required');
359      end if;
360  
361      -- road. is the framework's reserved namespace (rule 5). An application defining a road.* role
362      -- would be claiming framework authority for an application concern, and the reserved flag would
363      -- then mean two different things.
364      if lower(l_role_name) like 'road.%' then
365        raise_application_error(
366          c_err_validation,
367          'The road. namespace is reserved for the framework: ' || l_role_name
368        );
369      end if;
370  
371      select count(*) into l_existing from road_roles where role_name = l_role_name;
372      if l_existing > 0 then
373        raise_application_error(c_err_validation, 'Role already exists: ' || l_role_name);
374      end if;
375  
376      insert into road_roles (role_name, display_name, description, is_reserved)
377      values (l_role_name, l_display_name, l_description, 'N');
378  
379      return json_object(
380               'role_name'    value l_role_name,
381               'display_name' value l_display_name,
382               'description'  value l_description,
383               'is_reserved'  value 'N'
384               returning json
385             );
386    end define_role;
387  
388    procedure grant_all_app_permissions(p_role_name in varchar2) is
389    begin
390      assert_role_exists(p_role_name);
391  
392      -- Explicit rows, written once, for the permissions that exist RIGHT NOW. Anything added after
393      -- this runs is not acquired -- that is the point (rule 4), not a limitation.
394      --
395      -- attached_by is written NULL explicitly (spec-patch-07 section 10 question 3) -- this is the
396      -- deploy-attached case road_reserved_composition depends on being able to tell apart from a
397      -- session attach via attach_permission below.
398      insert into road_role_permissions (role_name, permission_name, attached_by)
399      select p_role_name, p.permission_name, null
400        from road_permissions p
401       where p.permission_name not like 'road.%'
402         and p.is_reserved = 'N'
403         and not exists (
404               select 1
405                 from road_role_permissions x
406                where x.role_name = p_role_name
407                  and x.permission_name = p.permission_name
408             );
409    end grant_all_app_permissions;
410  
411    function get_permissions(p_request in json default null) return json is
412      l_result json;
413    begin
414      road_ctx_pkg.require_permission('road.role.compose');
415  
416      select json_object(
417               'permissions' value nvl((
418                 select json_arrayagg(
419                          json_object(
420                            'permission_name' value p.permission_name,
421                            'description'     value p.description,
422                            'is_reserved'     value p.is_reserved,
423                            'roles'           value nvl((
424                              select json_arrayagg(rp.role_name order by rp.role_name returning json)
425                                from road_role_permissions rp
426                               where rp.permission_name = p.permission_name
427                            ), json('[]'))
428                          )
429                          order by p.permission_name returning json
430                        )
431                   from road_permissions p
432               ), json('[]'))
433               returning json
434             )
435        into l_result
436        from dual;
437  
438      return l_result;
439    end get_permissions;
440  
441    -- Shared refusal for attach/detach: a reserved permission or a reserved role, as a flat refusal
442    -- rather than the road.role.define escalation tier assert_may_manage uses for roles. Composing
443    -- the framework's own authority is composed at deploy time only, enforced in the database by
444    -- road_reserved_composition -- this check exists to give a clean 403 on the ordinary path rather
445    -- than surfacing the assertion's ORA-08601 (spec-patch-07 section 5.3, 5.5).
446    procedure assert_may_compose(p_role_name in varchar2, p_permission_name in varchar2) is
447    begin
448      if permission_is_reserved(p_permission_name) then
449        raise_application_error(
450          road_ctx_pkg.c_forbidden,
451          'Permission is reserved and cannot be composed at runtime: ' || p_permission_name
452        );
453      end if;
454      if is_reserved(p_role_name) then
455        raise_application_error(
456          road_ctx_pkg.c_forbidden,
457          'Role is reserved; its composition is framework-owned: ' || p_role_name
458        );
459      end if;
460    end assert_may_compose;
461  
462    function attach_permission(p_request in json) return json is
463      l_role_name       varchar2(64 char);
464      l_permission_name varchar2(64 char);
465      l_attached_by     number;
466      l_existing        number;
467      l_attached        boolean := false;
468    begin
469      road_ctx_pkg.require_permission('road.role.compose');
470  
471      l_role_name       := json_value(p_request, '$.role_name' returning varchar2(64));
472      l_permission_name := json_value(p_request, '$.permission_name' returning varchar2(64));
473  
474      if l_role_name is null or l_permission_name is null then
475        raise_application_error(c_err_validation, 'role_name and permission_name are required');
476      end if;
477  
478      assert_role_exists(l_role_name);
479      assert_permission_exists(l_permission_name);
480      assert_may_compose(l_role_name, l_permission_name);
481  
482      -- Never from the request body -- see the package spec comment: a caller who could nominate
483      -- attached_by could forge the audit trail of who authorised an escalation.
484      l_attached_by := road_ctx_pkg.principal_id;
485  
486      select count(*)
487        into l_existing
488        from road_role_permissions
489       where role_name = l_role_name
490         and permission_name = l_permission_name;
491  
492      if l_existing = 0 then
493        insert into road_role_permissions (role_name, permission_name, attached_by)
494        values (l_role_name, l_permission_name, l_attached_by);
495        l_attached := true;
496      end if;
497  
498      return json_object(
499               'role_name'       value l_role_name,
500               'permission_name' value l_permission_name,
501               'attached'        value l_attached
502               returning json
503             );
504    end attach_permission;
505  
506    function detach_permission(p_request in json) return json is
507      l_role_name       varchar2(64 char);
508      l_permission_name varchar2(64 char);
509      l_detached        boolean := false;
510    begin
511      road_ctx_pkg.require_permission('road.role.compose');
512  
513      l_role_name       := json_value(p_request, '$.role_name' returning varchar2(64));
514      l_permission_name := json_value(p_request, '$.permission_name' returning varchar2(64));
515  
516      if l_role_name is null or l_permission_name is null then
517        raise_application_error(c_err_validation, 'role_name and permission_name are required');
518      end if;
519  
520      assert_role_exists(l_role_name);
521      assert_permission_exists(l_permission_name);
522      assert_may_compose(l_role_name, l_permission_name);
523  
524      -- No last-holder guard here for road.role.grant, unlike revoke_role's for road.system_admin --
525      -- road_admin_reachable enforces it in the database, and it must: this table has other writers
526      -- (grant_all_app_permissions) that a package-level check here would not cover.
527      delete from road_role_permissions
528       where role_name = l_role_name
529         and permission_name = l_permission_name;
530  
531      l_detached := sql%rowcount > 0;
532  
533      return json_object(
534               'role_name'       value l_role_name,
535               'permission_name' value l_permission_name,
536               'detached'        value l_detached
537               returning json
538             );
539    end detach_permission;
540  
541  end road_admin_api;
542  /

