SQL> declare
  2    l_count    number;
  3    l_expected constant number := 6;
  4  
  5    procedure assert(p_condition in boolean, p_message in varchar2) is
  6    begin
  7      if not nvl(p_condition, false) then
  8        raise_application_error(-20000, p_message);
  9      end if;
 10    end assert;
 11  begin
 12    -- 1. All six tables present. A half-applied deploy is the thing this catches.
 13    select count(*)
 14      into l_count
 15      from user_tables
 16     where table_name in ('ROAD_PRINCIPALS', 'ROAD_ROLES', 'ROAD_PERMISSIONS',
 17                          'ROAD_ROLE_PERMISSIONS', 'ROAD_PRINCIPAL_ROLES', 'ROAD_CONFIG');
 18    assert(l_count = l_expected,
 19           'Expected ' || l_expected || ' identity tables, found ' || l_count);
 20  
 21    -- 2. The three baseline roles, with the two road.* ones reserved.
 22    select count(*)
 23      into l_count
 24      from road_roles
 25     where role_name in ('road.system_admin', 'road.user_admin', 'user');
 26    assert(l_count = 3, 'Expected 3 baseline roles, found ' || l_count);
 27  
 28    select count(*)
 29      into l_count
 30      from road_roles
 31     where role_name in ('road.system_admin', 'road.user_admin')
 32       and is_reserved = 'Y';
 33    assert(l_count = 2, 'Both road.* baseline roles must be reserved, found ' || l_count);
 34  
 35    -- 3. road.system_admin actually composes its permissions.
 36    select count(*)
 37      into l_count
 38      from road_role_permissions
 39     where role_name = 'road.system_admin'
 40       and permission_name = 'road.role.define';
 41    assert(l_count = 1, 'road.system_admin must hold road.role.define');
 42  
 43    -- 4. road.user_admin must NOT be able to define roles -- the two-tier split is the point.
 44    select count(*)
 45      into l_count
 46      from road_role_permissions
 47     where role_name = 'road.user_admin'
 48       and permission_name in ('road.role.define', 'road.permission.define');
 49    assert(l_count = 0,
 50           'road.user_admin must not hold define permissions, found ' || l_count);
 51  
 52    -- 5. Exactly one principal can administer the system. Zero means the deploy produced an
 53    --    identity model nobody can administer, which is the failure mode section 10 question 1
 54    --    exists to prevent.
 55    select count(*)
 56      into l_count
 57      from road_principal_roles
 58     where role_name = 'road.system_admin';
 59    assert(l_count >= 1,
 60           'No principal holds road.system_admin - check road_config.bootstrap_admin_subject');
 61  
 62    -- 6. Exactly one ORDS JWT profile. This is the tripwire for the phase 0.1 spike constraint:
 63    --    road_ctx resolves the issuer from this view, which is only unambiguous while trust is
 64    --    schema-level with a single profile. A second profile means the implementation must move to
 65    --    reading the token header instead. See planning/spike-06-1-iss-reachability.md section 4.
 66    select count(*) into l_count from user_ords_jwt_profile;
 67    assert(l_count = 1,
 68           'Expected exactly 1 ORDS JWT profile, found ' || l_count
 69           || ' - road_ctx issuer resolution is ambiguous, see spike-06-1');
 70  
 71    dbms_output.put_line('[INFO] Identity model verified: 6 tables, 3 roles, 5 permissions, bootstrap admin present');
 72  end;
