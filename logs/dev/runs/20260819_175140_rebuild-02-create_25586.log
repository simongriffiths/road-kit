493    procedure test_attach_detach_idempotent is
494      l_res json;
495    begin
496      insert into road_permissions (permission_name, description)
497      values ('test.appperm.idem', 'road_admin test fixture');
498  
499      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then fail('establish'); end if;
500  
501      l_res := road_admin_api.attach_permission(
502                 json('{"role_name":"test.ordinary","permission_name":"test.appperm.idem"}'));
503      assert_eq('first attach', 'true', json_value(l_res, '$.attached'));
