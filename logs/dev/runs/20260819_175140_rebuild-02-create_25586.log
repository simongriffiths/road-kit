SQL> create or replace package body road_ctx_pkg_test as
  2  
  3    -- Fail-closed tests for road_ctx_pkg. Build plan 06 phase 2.3 -- "the ones the design rests on".
  4    --
  5    -- The pooled-session test is written first because it is the highest risk in the whole patch
  6    -- (risk 10.1): ORDS reuses connections, so a session genuinely does carry the previous caller's
  7    -- state. Confirmed on dev during phase 0.1 -- PROXY_USER is ORDS_PUBLIC_USER over a shared
  8    -- service. If context survived between requests, road_ctx_pkg.principal_id would return the wrong
  9    -- principal, and concurrency-only bugs reach production.
 10  
 11    c_issuer constant varchar2(64) := 'urn:road:test:road_ctx';
 12  
 13    procedure fail(p_message in varchar2) is
 14    begin
 15      raise_application_error(-20000, p_message);
 16    end fail;
 17  
 18    procedure assert_true(p_label in varchar2, p_actual in boolean) is
 19    begin
 20      if not nvl(p_actual, false) then
 21        fail(p_label || ': expected TRUE, got ' ||
 22             case when p_actual is null then 'NULL' else 'FALSE' end);
 23      end if;
 24    end assert_true;
 25  
 26    procedure assert_false(p_label in varchar2, p_actual in boolean) is
 27    begin
 28      -- Note "not false" is not the same as "null" here: rule 3 requires false, never null.
 29      if nvl(p_actual, true) then
 30        fail(p_label || ': expected FALSE, got ' ||
 31             case when p_actual is null then 'NULL' else 'TRUE' end);
 32      end if;
 33    end assert_false;
 34  
 35    procedure assert_null(p_label in varchar2, p_actual in varchar2) is
 36    begin
 37      if p_actual is not null then
 38        fail(p_label || ': expected NULL, got [' || p_actual || ']');
 39      end if;
 40    end assert_null;
 41  
 42    function principal_of(p_subject in varchar2) return number is
 43      l_id number;
 44    begin
 45      select principal_id into l_id
 46        from road_principals
 47       where issuer = c_issuer and subject = p_subject;
 48      return l_id;
 49    end principal_of;
 50  
 51    procedure setup is
 52      l_a    number;
 53      l_b    number;
 54      l_susp number;
 55    begin
 56      -- Autonomous Database enables parallel DML by default, and every insert below reads the table
 57      -- it writes (the NOT EXISTS guard). Once serial DML has happened in the transaction a parallel
 58      -- one raises ORA-12839, which then surfaces as a deadlock in teardown. Same reason
 59      -- deploy/create/95_data.sql disables it.
 60      execute immediate 'alter session disable parallel dml';
 61  
 62      -- Two roles sharing one permission, so the union case has something to collapse.
 63      insert into road_permissions (permission_name, description)
 64      select 'test.perm.a', 'road_ctx test fixture' from dual
 65       where not exists (select 1 from road_permissions where permission_name = 'test.perm.a');
 66      insert into road_permissions (permission_name, description)
 67      select 'test.perm.b', 'road_ctx test fixture' from dual
 68       where not exists (select 1 from road_permissions where permission_name = 'test.perm.b');
 69      insert into road_permissions (permission_name, description)
 70      select 'test.perm.shared', 'road_ctx test fixture' from dual
 71       where not exists (select 1 from road_permissions where permission_name = 'test.perm.shared');
 72  
 73      insert into road_roles (role_name, display_name, is_reserved)
 74      select 'test.role1', 'road_ctx test fixture', 'N' from dual
 75       where not exists (select 1 from road_roles where role_name = 'test.role1');
 76      insert into road_roles (role_name, display_name, is_reserved)
 77      select 'test.role2', 'road_ctx test fixture', 'N' from dual
 78       where not exists (select 1 from road_roles where role_name = 'test.role2');
 79  
 80      insert into road_role_permissions (role_name, permission_name)
 81      select 'test.role1', 'test.perm.a' from dual
 82       where not exists (select 1 from road_role_permissions
 83                          where role_name = 'test.role1' and permission_name = 'test.perm.a');
 84      insert into road_role_permissions (role_name, permission_name)
 85      select 'test.role1', 'test.perm.shared' from dual
 86       where not exists (select 1 from road_role_permissions
 87                          where role_name = 'test.role1' and permission_name = 'test.perm.shared');
 88      insert into road_role_permissions (role_name, permission_name)
 89      select 'test.role2', 'test.perm.b' from dual
 90       where not exists (select 1 from road_role_permissions
 91                          where role_name = 'test.role2' and permission_name = 'test.perm.b');
 92      insert into road_role_permissions (role_name, permission_name)
 93      select 'test.role2', 'test.perm.shared' from dual
 94       where not exists (select 1 from road_role_permissions
 95                          where role_name = 'test.role2' and permission_name = 'test.perm.shared');
 96  
 97      -- TESTA holds both roles, TESTB only the first, TESTSUSP is suspended.
 98      insert into road_principals (issuer, subject, display_name, status)
 99      select c_issuer, 'TESTA', 'road_ctx test fixture', 'ACTIVE' from dual
100       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'TESTA');
101      insert into road_principals (issuer, subject, display_name, status)
102      select c_issuer, 'TESTB', 'road_ctx test fixture', 'ACTIVE' from dual
103       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'TESTB');
104      insert into road_principals (issuer, subject, display_name, status)
105      select c_issuer, 'TESTSUSP', 'road_ctx test fixture', 'SUSPENDED' from dual
106       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'TESTSUSP');
107  
108      -- Resolved into locals first: principal_of is body-private, and a private packaged function
109      -- cannot be referenced from inside SQL (PLS-00231).
110      l_a := principal_of('TESTA');
111      l_b := principal_of('TESTB');
112      l_susp := principal_of('TESTSUSP');
113  
114      insert into road_principal_roles (principal_id, role_name)
115      select l_a, 'test.role1' from dual
116       where not exists (select 1 from road_principal_roles
117                          where principal_id = l_a and role_name = 'test.role1');
118      insert into road_principal_roles (principal_id, role_name)
119      select l_a, 'test.role2' from dual
120       where not exists (select 1 from road_principal_roles
121                          where principal_id = l_a and role_name = 'test.role2');
122      insert into road_principal_roles (principal_id, role_name)
123      select l_b, 'test.role1' from dual
124       where not exists (select 1 from road_principal_roles
125                          where principal_id = l_b and role_name = 'test.role1');
126      insert into road_principal_roles (principal_id, role_name)
127      select l_susp, 'test.role1' from dual
128       where not exists (select 1 from road_principal_roles
129                          where principal_id = l_susp and role_name = 'test.role1');
130  
131      commit;
132    end setup;
133  
134    procedure teardown is
135    begin
136      delete from road_principal_roles
137       where principal_id in (select principal_id from road_principals
138                               where issuer like 'urn:road:test:%');
139      -- Covers NEWCOMER, STRANGER and anything auto-provisioned under a second test issuer.
140      delete from road_principals where issuer like 'urn:road:test:%';
141      delete from road_role_permissions where role_name in ('test.role1', 'test.role2');
142      delete from road_roles where role_name in ('test.role1', 'test.role2');
143      delete from road_permissions
144       where permission_name in ('test.perm.a', 'test.perm.b', 'test.perm.shared');
145      commit;
146      road_ctx_pkg.end_request;
147    end teardown;
148  
149    -- THE test. B must never see A's permissions on a reused session.
150    procedure test_pooled_session_does_not_bleed is
151    begin
152      assert_true('A establishes', road_ctx_pkg.begin_request('TESTA', c_issuer));
153      assert_true('A has perm.b', road_ctx_pkg.has_permission('test.perm.b'));
154      assert_true('A has role2', road_ctx_pkg.has_role('test.role2'));
155  
156      -- Same session, no end_request in between -- exactly what a pooled connection does.
157      assert_true('B establishes', road_ctx_pkg.begin_request('TESTB', c_issuer));
158      assert_false('B must NOT inherit A perm.b', road_ctx_pkg.has_permission('test.perm.b'));
159      assert_false('B must NOT inherit A role2', road_ctx_pkg.has_role('test.role2'));
160      assert_true('B keeps its own perm.a', road_ctx_pkg.has_permission('test.perm.a'));
161  
162      if road_ctx_pkg.principal_id != principal_of('TESTB') then
163        fail('principal_id must be B, got ' || road_ctx_pkg.principal_id);
164      end if;
165    end test_pooled_session_does_not_bleed;
166  
167    -- A FAILED begin_request must also clear the previous caller, not leave them established.
168    --
169    -- The failure used to be an unknown subject. With auto-provisioning enabled that is no longer a
170    -- failure -- it creates the principal -- so this uses a SUSPENDED one, which also exercises a
171    -- later exit point: past the lookup, with identity partially resolved.
172    procedure test_failed_begin_clears_previous is
173    begin
174      assert_true('A establishes', road_ctx_pkg.begin_request('TESTA', c_issuer));
175      assert_false('suspended principal denied', road_ctx_pkg.begin_request('TESTSUSP', c_issuer));
176      assert_false('previous identity gone', road_ctx_pkg.is_authenticated);
177      assert_false('previous permission gone', road_ctx_pkg.has_permission('test.perm.a'));
178      assert_null('principal_id cleared', to_char(road_ctx_pkg.principal_id));
179  
180      -- A null subject fails earliest of all, and must also leave nothing behind.
181      assert_true('A re-establishes', road_ctx_pkg.begin_request('TESTA', c_issuer));
182      assert_false('null subject denied', road_ctx_pkg.begin_request(null, c_issuer));
183      assert_false('and cleared', road_ctx_pkg.is_authenticated);
184    end test_failed_begin_clears_previous;
185  
186    procedure test_unestablished_denies_everything is
187    begin
188      road_ctx_pkg.end_request;
189      assert_false('is_authenticated', road_ctx_pkg.is_authenticated);
190      assert_false('has_permission', road_ctx_pkg.has_permission('test.perm.a'));
191      assert_false('has_role', road_ctx_pkg.has_role('test.role1'));
192      assert_null('principal_id', to_char(road_ctx_pkg.principal_id));
193      assert_null('subject', road_ctx_pkg.subject);
194      assert_null('issuer', road_ctx_pkg.issuer);
195      -- Null arguments must deny too, not error.
196      assert_false('null permission', road_ctx_pkg.has_permission(null));
197      assert_false('null role', road_ctx_pkg.has_role(null));
198    end test_unestablished_denies_everything;
199  
200    procedure test_suspended_principal_denied is
201    begin
202      assert_false('suspended denied', road_ctx_pkg.begin_request('TESTSUSP', c_issuer));
203      assert_false('context not established', road_ctx_pkg.is_authenticated);
204      assert_false('no permissions loaded', road_ctx_pkg.has_permission('test.perm.a'));
205    end test_suspended_principal_denied;
206  
207    -- Same subject, different issuer: the whole reason section 4.1 keys on both.
208    --
209    -- With auto-provisioning on, the property under test is no longer "denied" -- a subject from
210    -- another issuer is a legitimate new person, and gets their own principal. What must NEVER happen
211    -- is that they resolve to the EXISTING principal and inherit its permissions. That is precisely
212    -- the collision section 4.1 exists to prevent: two issuers may both legitimately mint 'TESTA'.
213    procedure test_wrong_issuer_is_a_different_principal is
214      l_other constant varchar2(64) := 'urn:road:test:somewhere-else';
215      l_mine  number;
216      l_other_id number;
217    begin
218      assert_true('A establishes under its own issuer', road_ctx_pkg.begin_request('TESTA', c_issuer));
219      l_mine := road_ctx_pkg.principal_id;
220      assert_true('and holds its permission', road_ctx_pkg.has_permission('test.perm.a'));
221  
222      -- Created explicitly rather than relying on auto-provisioning: this test is about issuer
223      -- isolation, and must pass whether or not the deployment provisions on first sight. road-kit
224      -- defaults auto_provision_principals to N, and the earlier version of this test failed there --
225      -- caught by the phase 8 backport running the suite rather than reading it.
226      insert into road_principals (issuer, subject, display_name, status)
227      select l_other, 'TESTA', 'road_ctx test fixture (other issuer)', 'ACTIVE' from dual
228       where not exists (select 1 from road_principals
229                          where issuer = l_other and subject = 'TESTA');
230      commit;
231  
232      assert_true('same subject under another issuer establishes separately',
233                  road_ctx_pkg.begin_request('TESTA', l_other));
234      l_other_id := road_ctx_pkg.principal_id;
235  
236      if l_mine = l_other_id then
237        fail('same subject from a different issuer resolved to the SAME principal');
238      end if;
239      assert_false('and must NOT inherit the other issuer''s permissions',
240                   road_ctx_pkg.has_permission('test.perm.a'));
241    end test_wrong_issuer_is_a_different_principal;
242  
243    procedure test_permission_union_no_duplicates is
244      l_expected number;
245      l_a        number;
246    begin
247      l_a := principal_of('TESTA');
248      assert_true('A establishes', road_ctx_pkg.begin_request('TESTA', c_issuer));
249      assert_true('perm.a from role1', road_ctx_pkg.has_permission('test.perm.a'));
250      assert_true('perm.b from role2', road_ctx_pkg.has_permission('test.perm.b'));
251      assert_true('perm.shared from both', road_ctx_pkg.has_permission('test.perm.shared'));
252  
253      -- The union really is three distinct permissions, not four rows collapsed by luck.
254      select count(distinct rp.permission_name)
255        into l_expected
256        from road_principal_roles pr
257        join road_role_permissions rp on rp.role_name = pr.role_name
258       where pr.principal_id = l_a;
259      if l_expected != 3 then
260        fail('fixture wrong: expected 3 distinct permissions, got ' || l_expected);
261      end if;
262  
263      assert_false('unheld permission still denied', road_ctx_pkg.has_permission('road.role.define'));
264    end test_permission_union_no_duplicates;
265  
266    procedure test_require_permission_raises_403 is
267      l_raised boolean := false;
268    begin
269      assert_true('B establishes', road_ctx_pkg.begin_request('TESTB', c_issuer));
270  
271      -- Held: must not raise.
272      road_ctx_pkg.require_permission('test.perm.a');
273  
274      -- Not held: must raise the dedicated forbidden code, which error_api maps to 403.
275      begin
276        road_ctx_pkg.require_permission('test.perm.b');
277      exception
278        when others then
279          l_raised := true;
280          if sqlcode != road_ctx_pkg.c_forbidden then
281            fail('expected ' || road_ctx_pkg.c_forbidden || ', got ' || sqlcode);
282          end if;
283      end;
284      assert_true('require_permission raised', l_raised);
285  
286      l_raised := false;
287      begin
288        road_ctx_pkg.require_role('test.role2');
289      exception
290        when others then
291          l_raised := true;
292          if sqlcode != road_ctx_pkg.c_forbidden then
293            fail('expected ' || road_ctx_pkg.c_forbidden || ', got ' || sqlcode);
294          end if;
295      end;
296      assert_true('require_role raised', l_raised);
297    end test_require_permission_raises_403;
298  
299    -- require_* on an UNESTABLISHED session must deny, not pass. The dangerous failure would be a
300    -- handler that forgot begin_request sailing through its permission check.
301    procedure test_require_denies_when_unestablished is
302      l_raised boolean := false;
303    begin
304      road_ctx_pkg.end_request;
305      begin
306        road_ctx_pkg.require_permission('test.perm.a');
307      exception
308        when others then
309          l_raised := true;
310      end;
311      assert_true('require_permission denied with no session', l_raised);
312    end test_require_denies_when_unestablished;
313  
314    -- p_issuer defaulted: resolved from the schema's ORDS JWT profile. Uses the seeded bootstrap
315    -- principal, which is the only one that exists under the real issuer.
316    procedure test_default_issuer_resolution is
317      l_subject road_config.config_value%type;
318    begin
319      select config_value into l_subject
320        from road_config where config_key = 'bootstrap_admin_subject';
321  
322      assert_true('bootstrap principal establishes with defaulted issuer',
323                  road_ctx_pkg.begin_request(l_subject));
324      assert_true('and holds road.role.define', road_ctx_pkg.has_permission('road.role.define'));
325  
326      -- The resolved issuer must equal the JWT profile's, not a guess.
327      for r in (select issuer from user_ords_jwt_profile) loop
328        if road_ctx_pkg.issuer != r.issuer then
329          fail('issuer mismatch: context [' || road_ctx_pkg.issuer || '] profile [' || r.issuer || ']');
330        end if;
331      end loop;
332    end test_default_issuer_resolution;
333  
334    -- The USING clause is the security control. Prove it: this package is not road_ctx_pkg, so it
335    -- must not be able to write the namespace. Without this, "secured context" is an unverified
336    -- claim and any handler could grant itself permissions.
337    procedure test_context_is_not_writable_by_others is
338      l_raised boolean := false;
339    begin
340      -- Start from a genuinely cleared session, otherwise the second assertion would just be
341      -- observing the previous test's establishment rather than this one's failure to establish.
342      road_ctx_pkg.end_request;
343      begin
344        dbms_session.set_context(road_ctx_pkg.namespace, 'ESTABLISHED', 'Y');
345      exception
346        when others then
347          l_raised := true;
348      end;
349      assert_true('non-trusted package must not write the namespace', l_raised);
350      assert_false('and identity must not be established', road_ctx_pkg.is_authenticated);
351    end test_context_is_not_writable_by_others;
352  
353    -- Auto-provisioning: a subject the issuer authenticated but this application has never seen.
354    procedure test_auto_provision_creates_principal is
355      l_before number;
356      l_after  number;
357      l_role   road_config.config_value%type;
358      l_saved  road_config.config_value%type;
359    begin
360      select config_value into l_role from road_config where config_key = 'default_principal_role';
361  
362      -- Enabled for the duration and restored afterwards. road-cal ships this on and road-kit ships
363      -- it off, so a test that assumed either would fail in the other repo.
364      select config_value into l_saved
365        from road_config where config_key = 'auto_provision_principals';
366      update road_config set config_value = 'Y' where config_key = 'auto_provision_principals';
367      commit;
368  
369      delete from road_principal_roles
370       where principal_id in (select principal_id from road_principals
371                               where issuer = c_issuer and subject = 'NEWCOMER');
372      delete from road_principals where issuer = c_issuer and subject = 'NEWCOMER';
373      commit;
374  
375      select count(*) into l_before
376        from road_principals where issuer = c_issuer and subject = 'NEWCOMER';
377      assert_true('fixture starts absent', l_before = 0);
378  
379      assert_true('unknown subject is provisioned and establishes',
380                  road_ctx_pkg.begin_request('NEWCOMER', c_issuer));
381  
382      select count(*) into l_after
383        from road_principals where issuer = c_issuer and subject = 'NEWCOMER';
384      assert_true('principal row created', l_after = 1);
385      assert_true('holds the default role', road_ctx_pkg.has_role(l_role));
386  
387      -- Second visit must reuse the row, not create another.
388      assert_true('second request establishes', road_ctx_pkg.begin_request('NEWCOMER', c_issuer));
389      select count(*) into l_after
390        from road_principals where issuer = c_issuer and subject = 'NEWCOMER';
391      assert_true('still exactly one principal', l_after = 1);
392  
393      update road_config set config_value = l_saved where config_key = 'auto_provision_principals';
394      commit;
395    exception
396      when others then
397        update road_config set config_value = l_saved where config_key = 'auto_provision_principals';
398        commit;
399        raise;
400    end test_auto_provision_creates_principal;
401  
402    -- With provisioning off, an unknown subject must be denied -- rule 3's default.
403    procedure test_auto_provision_off_denies is
404      l_saved road_config.config_value%type;
405    begin
406      select config_value into l_saved
407        from road_config where config_key = 'auto_provision_principals';
408  
409      update road_config set config_value = 'N' where config_key = 'auto_provision_principals';
410      commit;
411  
412      begin
413        assert_false('unknown subject denied when provisioning is off',
414                     road_ctx_pkg.begin_request('STRANGER', c_issuer));
415        assert_false('context not established', road_ctx_pkg.is_authenticated);
416  
417        declare
418          l_count number;
419        begin
420          select count(*) into l_count
421            from road_principals where issuer = c_issuer and subject = 'STRANGER';
422          assert_true('no principal created', l_count = 0);
423        end;
424      exception
425        when others then
426          update road_config set config_value = l_saved
427           where config_key = 'auto_provision_principals';
428          commit;
429          raise;
430      end;
431  
432      update road_config set config_value = l_saved where config_key = 'auto_provision_principals';
433      commit;
434    end test_auto_provision_off_denies;
435  
436    -- A SUSPENDED principal must stay denied even with provisioning on: it is a known subject, so
437    -- provisioning never runs, and the status check is what holds. Getting this wrong would let a
438    -- suspended user be silently re-provisioned as active.
439    procedure test_suspended_is_not_reprovisioned is
440      l_count number;
441    begin
442      assert_false('suspended still denied', road_ctx_pkg.begin_request('TESTSUSP', c_issuer));
443      select count(*) into l_count
444        from road_principals where issuer = c_issuer and subject = 'TESTSUSP';
445      assert_true('still exactly one TESTSUSP row', l_count = 1);
446      assert_false('context not established', road_ctx_pkg.is_authenticated);
447    end test_suspended_is_not_reprovisioned;
448  
449    procedure run_all is
450    begin
451      setup;
452  
453      test_pooled_session_does_not_bleed;
454      test_failed_begin_clears_previous;
455      test_unestablished_denies_everything;
456      test_suspended_principal_denied;
457      test_wrong_issuer_is_a_different_principal;
458      test_permission_union_no_duplicates;
459      test_require_permission_raises_403;
460      test_require_denies_when_unestablished;
461      test_default_issuer_resolution;
462      test_context_is_not_writable_by_others;
463      test_auto_provision_creates_principal;
464      test_suspended_is_not_reprovisioned;
465      test_auto_provision_off_denies;
466  
467      teardown;
468      dbms_output.put_line('[PASS] road_ctx_pkg_test: 13 tests');
469    exception
470      when others then
471        teardown;
472        raise;
473    end run_all;
474  
475  end road_ctx_pkg_test;
476  /

