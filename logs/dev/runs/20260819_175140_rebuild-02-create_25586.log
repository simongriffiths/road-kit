104                                       'session.me', l_status_code, l_error_response);
105            end if;
106            owa_util.status_line(l_status_code);
107            htp.p(l_error_response);
108        end;
109      ~',
110      p_comments    => 'Returns the authenticated session identity, roles and effective permissions'
111    );
