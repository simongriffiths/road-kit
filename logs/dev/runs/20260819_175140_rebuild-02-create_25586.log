SQL> begin
  2    ords.define_module(
  3      p_module_name    => 'hello_api.session',
  4      p_base_path      => '/api/v1/session/',
  5      p_items_per_page => 25,
  6      p_status         => 'PUBLISHED',
  7      p_comments       => 'ROAD protected session module'
  8    );
  9  
 10    ords.define_template(
 11      p_module_name => 'hello_api.session',
 12      p_pattern     => 'me/',
 13      p_comments    => 'Protected session endpoint'
 14    );
 15  
 16    -- Converted from a collection_item query to PL/SQL by the spec patch 06 backport. A SELECT-based
 17    -- handler cannot establish session context or return 401 on failure, and this endpoint is the
 18    -- one place the UI asks "who am I" -- so it should answer from the resolved principal rather
 19    -- than by echoing the token's subject back.
 20    --
 21    -- Every field the previous shape returned is still returned, with the same names and the same
 22    -- values; principal_id, roles and permissions are added. The existing endpoint assertions check
 23    -- for fragments, so additive fields do not break them.
 24    ords.define_handler(
 25      p_module_name => 'hello_api.session',
 26      p_pattern     => 'me/',
 27      p_method      => 'GET',
 28      p_source_type => ords.source_type_plsql,
 29      -- NOTE the q'~ ~' delimiter instead of the repo's usual q'[ ]'. This handler's body contains
 30      -- json('[]'), and the two characters ]' terminate a q'[ ]' literal -- so the PL/SQL silently
 31      -- ended early, the remainder leaked out as SQL*Plus input, and the only symptom was
 32      -- "SP2-0552: Bind variable CURRENT_USER not declared" from a completely different line.
 33      p_source      => q'~
 34        declare
 35          l_response       json;
 36          l_status_code    number;
 37          l_error_response clob;
 38          l_principal_id   number;
 39          l_roles          json;
 40          l_permissions    json;
 41        begin
 42          if not road_ctx_pkg.begin_request(:current_user) then
 43            owa_util.status_line(401);
 44            htp.p('{"error":"UNAUTHORIZED","message":"No session could be established"}');
 45            return;
 46          end if;
 47          -- No require_permission: reading your own identity is inherently self-scoped, and road-kit
 48          -- ships no application permissions to gate it with. An adopting application may add one --
 49          -- road-cal gates this on session.read as part of its own taxonomy -- but the framework only
 50          -- requires that a session exists.
 51          l_principal_id := road_ctx_pkg.principal_id;
 52  
 53          -- Built as locals rather than inline scalar subqueries: NVL does not accept JSON-typed
 54          -- arguments inside SQL, and JSON_ARRAYAGG returns NULL rather than an empty array when the
 55          -- principal holds nothing. The UI expects [] in that case, not null.
 56          select json_arrayagg(pr.role_name order by pr.role_name returning json)
 57            into l_roles
 58            from road_principal_roles pr
 59           where pr.principal_id = l_principal_id;
 60  
 61          -- JSON_ARRAYAGG does not accept DISTINCT, so de-duplication happens in an inline view. A
 62          -- principal holding two roles that share a permission would otherwise list it twice.
 63          select json_arrayagg(x.permission_name order by x.permission_name returning json)
 64            into l_permissions
 65            from (
 66              select distinct rp.permission_name
 67                from road_principal_roles pr
 68                join road_role_permissions rp on rp.role_name = pr.role_name
 69               where pr.principal_id = l_principal_id
 70            ) x;
