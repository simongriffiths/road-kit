 73            l_roles := json('[]');
 74          end if;
 75          if l_permissions is null then
 76            l_permissions := json('[]');
 77          end if;
 78  
 79          select json_object(
 80                   'principal'     value session_api.get_principal(:current_user),
 81                   'issuer'        value road_ctx_pkg.issuer,
 82                   'audience'      value session_api.get_audience,
 83                   'scope'         value session_api.get_scope,
 84                   'authenticated' value case when road_ctx_pkg.is_authenticated then 'true'
 85                                              else 'false' end,
 86                   'current_user'  value :current_user,
 87                   'db_user'       value sys_context('USERENV', 'CURRENT_USER'),
 88                   'principal_id'  value l_principal_id,
 89                   'roles'         value l_roles,
 90                   'permissions'   value l_permissions
 91                   returning json
 92                 )
 93            into l_response
 94            from dual;
