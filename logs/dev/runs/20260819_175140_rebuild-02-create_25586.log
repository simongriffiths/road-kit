549    ---------------------------------------------------------------------------
550    -- The composition guard assertions (spec-patch-07 section 5.2), proven directly against the
551    -- real tables, bypassing road_admin_api entirely -- the point of an assertion over a package
552    -- check is that it holds when the package does not run. Every insert here targets a
553    -- (role, permission) pair not already in road_role_permissions, and every branch rolls back, so
554    -- these leave no state behind for teardown to clean up.
555    ---------------------------------------------------------------------------
556  
557    procedure test_assertion_permits_ordinary_session_attach is
558      l_sys number := principal_of('SYSADM');
559    begin
560      insert into road_permissions (permission_name, description)
561      values ('test.appperm.assertok', 'road_admin test fixture');
562      insert into road_role_permissions (role_name, permission_name, attached_by)
563      values ('test.idem', 'test.appperm.assertok', l_sys);
564      rollback;
565    exception
566      when others then
567        rollback;
568        fail('ordinary permission, session-attached, must be permitted: ' || sqlerrm);
569    end test_assertion_permits_ordinary_session_attach;
570  
571    procedure test_assertion_refuses_reserved_session_attach is
572      l_sys    number := principal_of('SYSADM');
573      l_raised boolean := false;
574    begin
575      begin
576        insert into road_role_permissions (role_name, permission_name, attached_by)
577        values ('test.grantedby', 'road.role.compose', l_sys);
578        rollback;
579      exception
580        when others then
581          rollback;
582          l_raised := true;
583          if sqlcode != -8601 then
584            fail('expected ORA-08601, got ' || sqlcode || ': ' || sqlerrm);
585          end if;
586      end;
587      if not l_raised then
588        fail('reserved permission, session-attached, must be refused by road_reserved_composition');
589      end if;
590    end test_assertion_refuses_reserved_session_attach;
591  
592    -- The row that earns the assertion over a BEFORE INSERT trigger: the PARENT table
593    -- (road_permissions) is what changes, not the child row being inserted.
594    procedure test_assertion_refuses_flip_under_session_attach is
595      l_sys    number := principal_of('SYSADM');
596      l_raised boolean := false;
597    begin
598      begin
599        insert into road_permissions (permission_name, description)
600        values ('test.appperm.flip', 'road_admin test fixture');
601        insert into road_role_permissions (role_name, permission_name, attached_by)
602        values ('test.idem', 'test.appperm.flip', l_sys);
603  
604        update road_permissions set is_reserved = 'Y' where permission_name = 'test.appperm.flip';
605        rollback;
606      exception
607        when others then
608          rollback;
609          l_raised := true;
610          if sqlcode != -8601 then
611            fail('expected ORA-08601, got ' || sqlcode || ': ' || sqlerrm);
612          end if;
613      end;
614      if not l_raised then
615        fail('flipping is_reserved under a session-attached row must be refused (the back door)');
616      end if;
617    end test_assertion_refuses_flip_under_session_attach;
618  
619    -- Proves the guard does not break the seed path: 95_data.sql and grant_all_app_permissions must
620    -- still be able to attach a reserved permission with attached_by null.
621    procedure test_assertion_permits_reserved_deploy_attach is
622    begin
623      insert into road_role_permissions (role_name, permission_name, attached_by)
624      values ('test.grantedby', 'road.role.compose', null);
625      rollback;
626    exception
627      when others then
628        rollback;
629        fail('reserved permission, deploy-attached (attached_by null), must be permitted: '
630             || sqlerrm);
631    end test_assertion_permits_reserved_deploy_attach;
632  
633    ---------------------------------------------------------------------------
634    -- get_principals (ui-authorisation-design-v1.md section 5.2)
635    ---------------------------------------------------------------------------
636  
637    -- The gate is road.role.grant, so a principal who holds neither admin role must be denied even
638    -- though they are perfectly well authenticated. Without this the endpoint would be a directory of
639    -- everyone's email address readable by every signed-in user.
640    procedure test_get_principals_requires_permission is
641      l_res    json;
642      l_raised boolean := false;
643    begin
644      -- SEARCHME, not TARGET: TARGET has been granted road.user_admin by an earlier test in this
645      -- run, so it would pass the gate and the assertion would prove nothing. SEARCHME holds one
646      -- ordinary role with no permissions attached.
647      if not road_ctx_pkg.begin_request('SEARCHME', c_issuer) then
648        fail('SEARCHME should establish');
649      end if;
650  
651      begin
652        l_res := road_admin_api.get_principals(json('{}'));
653      exception
654        when others then
655          l_raised := true;
656          if sqlcode != road_ctx_pkg.c_forbidden then
657            fail('expected c_forbidden, got ' || sqlcode);
658          end if;
659      end;
660      if not l_raised then fail('get_principals must deny a principal without road.role.grant'); end if;
661  
662      -- And with no session at all, for the "handler forgot begin_request" path.
663      road_ctx_pkg.end_request;
664      l_raised := false;
665      begin
666        l_res := road_admin_api.get_principals(json('{}'));
667      exception
668        when others then
669          l_raised := true;
670      end;
671      if not l_raised then fail('get_principals must deny with no session'); end if;
672    end test_get_principals_requires_permission;
673  
674    procedure test_get_principals_search is
675      l_res json;
676    begin
677      if not road_ctx_pkg.begin_request('USRADM', c_issuer) then
678        fail('USRADM should establish');
679      end if;
680  
681      -- Case-insensitive, and matching on display_name.
682      l_res := road_admin_api.get_principals(json('{"q":"sEaRcHaBlE"}'));
683      assert_eq('display_name match count', '1', json_value(l_res, '$.count'));
684      assert_eq('display_name match subject', 'SEARCHME', json_value(l_res, '$.items[0].subject'));
685  
686      -- Matching on email, which is the column the screen exists to make usable.
687      l_res := road_admin_api.get_principals(json('{"q":"find.me@example.test"}'));
688      assert_eq('email match count', '1', json_value(l_res, '$.count'));
689      assert_eq('email is returned', 'find.me@example.test', json_value(l_res, '$.items[0].email'));
690  
691      -- Matching on subject, for the case where a principal has neither name nor address yet.
692      l_res := road_admin_api.get_principals(json('{"q":"SEARCHME"}'));
693      assert_eq('subject match count', '1', json_value(l_res, '$.count'));
694  
695      -- The row carries its roles, so the table renders without a request per principal. Objects,
696      -- not bare names (spec-patch-07 section 8.1) -- role_name and is_reserved both travel.
697      assert_eq('roles travel with the row', 'test.searchable',
698                json_value(l_res, '$.items[0].roles[0].role_name'));
699      assert_eq('reserved-ness travels with the row', 'N',
700                json_value(l_res, '$.items[0].roles[0].is_reserved'));
701  
702      -- A LIKE wildcard typed into the search box must be a literal. Unescaped, this matches every
703      -- principal and the user believes they have searched.
704      l_res := road_admin_api.get_principals(json('{"q":"%"}'));
705      assert_eq('percent is a literal, not a wildcard', '0', json_value(l_res, '$.count'));
706  
707      -- A valid status filter narrows rather than empties.
708      l_res := road_admin_api.get_principals(json('{"q":"searchable","status":"ACTIVE"}'));
709      assert_eq('active filter keeps the row', '1', json_value(l_res, '$.count'));
710  
711      l_res := road_admin_api.get_principals(json('{"q":"searchable","status":"RETIRED"}'));
712      assert_eq('retired filter excludes it', '0', json_value(l_res, '$.count'));
713  
714      -- An unrecognised status is refused rather than ignored: silently returning the unfiltered
715      -- list would let the caller believe it had filtered.
716      declare
717        l_raised boolean := false;
718      begin
719        begin
720          l_res := road_admin_api.get_principals(json('{"status":"BANNED"}'));
721        exception
722          when others then
723            l_raised := true;
724        end;
725        if not l_raised then fail('an unrecognised status must be refused, not ignored'); end if;
726      end;
727    end test_get_principals_search;
728  
729    procedure test_get_principals_paging is
730      l_res   json;
731      l_first varchar2(255 char);
732    begin
733      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then
734        fail('SYSADM should establish');
735      end if;
736  
737      -- At least four principals exist by now (three fixtures plus the searchable one), so a page of
738      -- one must report more to come.
739      l_res := road_admin_api.get_principals(json('{"limit":1,"offset":0}'));
740      assert_eq('one row on the page', '1', json_value(l_res, '$.count'));
741      assert_eq('hasMore is true',   'true', json_value(l_res, '$.hasMore'));
742      l_first := json_value(l_res, '$.items[0].subject');
743  
744      -- The second page must not repeat the first. Stable ordering is what a prev/next pager rests
745      -- on; without it paging silently duplicates and skips rows.
746      l_res := road_admin_api.get_principals(json('{"limit":1,"offset":1}'));
747      if json_value(l_res, '$.items[0].subject') = l_first then
748        fail('offset did not advance the page');
749      end if;
750  
751      -- Clamped, not rejected: an out-of-range page size is a client bug, and an unclamped limit is
752      -- a denial-of-service parameter.
753      l_res := road_admin_api.get_principals(json('{"limit":9999}'));
754      assert_eq('limit clamped to the maximum', '100', json_value(l_res, '$.limit'));
755  
756      l_res := road_admin_api.get_principals(json('{"limit":0}'));
757      assert_eq('limit clamped to the minimum', '1', json_value(l_res, '$.limit'));
758  
759      l_res := road_admin_api.get_principals(json('{"offset":-5}'));
760      assert_eq('negative offset clamped', '0', json_value(l_res, '$.offset'));
761  
762      -- Past the end is an empty page, not an error.
763      l_res := road_admin_api.get_principals(json('{"offset":100000}'));
764      assert_eq('past the end returns nothing', '0', json_value(l_res, '$.count'));
765      assert_eq('past the end has no more',  'false', json_value(l_res, '$.hasMore'));
766    end test_get_principals_paging;
767  
768    procedure run(p_name in varchar2, p_which in varchar2) is
769    begin
770      case p_which
771        when 'user_admin_reserved'   then test_user_admin_cannot_grant_reserved;
772        when 'sysadmin_reserved'     then test_system_admin_can_grant_reserved;
773        when 'granted_by'            then test_granted_by_ignores_request_body;
774        when 'idempotent'            then test_grant_is_idempotent;
775        when 'last_admin'            then test_cannot_revoke_last_system_admin;
776        when 'define_namespace'      then test_define_role_rejects_road_namespace;
777        when 'user_admin_define'     then test_user_admin_cannot_define_roles;
778        when 'unauthenticated'       then test_unauthenticated_denied;
779        when 'grant_all'             then test_grant_all_app_permissions_is_explicit;
780        when 'principals_permission' then test_get_principals_requires_permission;
781        when 'principals_search'     then test_get_principals_search;
782        when 'principals_paging'     then test_get_principals_paging;
783        when 'attach_reserved_perm'  then test_attach_reserved_permission_refused;
784        when 'attach_reserved_role'  then test_attach_to_reserved_role_refused;
785        when 'compose_effect'        then test_composition_takes_effect_on_next_request;
786        when 'attached_by'           then test_attached_by_ignores_request_body;
787        when 'compose_idempotent'    then test_attach_detach_idempotent;
788        when 'compose_denied'        then test_compose_denied_without_permission;
789        when 'assert_permit_ord'     then test_assertion_permits_ordinary_session_attach;
790        when 'assert_refuse_res'     then test_assertion_refuses_reserved_session_attach;
791        when 'assert_refuse_flip'    then test_assertion_refuses_flip_under_session_attach;
792        when 'assert_permit_deploy'  then test_assertion_permits_reserved_deploy_attach;
793      end case;
794      dbms_output.put_line('PASS ' || p_name);
795      l_pass := l_pass + 1;
796    exception
797      when others then
798        dbms_output.put_line('FAIL ' || p_name || ': ' || sqlerrm);
799        l_fail := l_fail + 1;
800    end run;
801  
802    procedure run_all is
803    begin
804      l_pass := 0;
805      l_fail := 0;
806      setup;
807  
808      run('test_user_admin_cannot_grant_reserved', 'user_admin_reserved');
809      run('test_system_admin_can_grant_reserved', 'sysadmin_reserved');
810      run('test_granted_by_ignores_request_body', 'granted_by');
811      run('test_grant_is_idempotent', 'idempotent');
812      run('test_define_role_rejects_road_namespace', 'define_namespace');
813      run('test_user_admin_cannot_define_roles', 'user_admin_define');
814      run('test_unauthenticated_denied', 'unauthenticated');
815      run('test_grant_all_app_permissions_is_explicit', 'grant_all');
816      run('test_get_principals_requires_permission', 'principals_permission');
817      run('test_get_principals_search', 'principals_search');
818      run('test_get_principals_paging', 'principals_paging');
819  
820      run('test_attach_reserved_permission_refused', 'attach_reserved_perm');
821      run('test_attach_to_reserved_role_refused', 'attach_reserved_role');
822      run('test_composition_takes_effect_on_next_request', 'compose_effect');
823      run('test_attached_by_ignores_request_body', 'attached_by');
824      run('test_attach_detach_idempotent', 'compose_idempotent');
825      run('test_compose_denied_without_permission', 'compose_denied');
826      run('test_assertion_permits_ordinary_session_attach', 'assert_permit_ord');
827      run('test_assertion_refuses_reserved_session_attach', 'assert_refuse_res');
828      run('test_assertion_refuses_flip_under_session_attach', 'assert_refuse_flip');
829      run('test_assertion_permits_reserved_deploy_attach', 'assert_permit_deploy');
830  
831      -- Last: it deliberately revokes admin grants, so it must not run before the others.
832      run('test_cannot_revoke_last_system_admin', 'last_admin');
833  
834      teardown;
835      dbms_output.put_line('road_admin_api_test: ' || l_pass || ' passed, ' || l_fail || ' failed');
836      if l_fail > 0 then
837        raise_application_error(-20000, l_fail || ' road_admin_api test(s) failed');
838      end if;
839    exception
840      when others then
841        teardown;
842        raise;
843    end run_all;
844  
845  end road_admin_api_test;
846  /

