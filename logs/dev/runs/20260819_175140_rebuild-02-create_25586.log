SQL> create or replace package body jwt_scaffold_auth_api as
  2    c_admin_username constant varchar2(30) := 'ADMIN';
  3    c_admin_salt     constant raw(16)      := hextoraw('81DAE563DC239D38FEBF76FAD3885104');
  4    c_admin_hash     constant raw(32)      := hextoraw('5C104866B778B69DBC36E06B3230FF5BCBBBC76E5E3FAE85CF1C503499960B69');
  5  
  6    c_user1_username constant varchar2(30) := 'USER1';
  7    c_user1_salt     constant raw(16)      := hextoraw('A244EF5B579898203EC68A3F1B40E3B6');
  8    c_user1_hash     constant raw(32)      := hextoraw('9C1DB83A7656BE02AEAE6F1ED10759AC15266CDB8ABE85099A5EE1C31154BCF8');
  9  
 10    c_user2_username constant varchar2(30) := 'USER2';
 11    c_user2_salt     constant raw(16)      := hextoraw('C7FFDC97A465A438E3BB68C0E597CFC5');
 12    c_user2_hash     constant raw(32)      := hextoraw('B96BF0DBAC303473AEB14507EA73F6795DDE1ADD502760E9FD4A83488F35C3DB');
 13  
 14    type t_config is record (
 15      issuer           jwt_scaffold_config.issuer%type,
 16      audience         jwt_scaffold_config.audience%type,
 17      scope_name       jwt_scaffold_config.scope_name%type,
 18      ttl_minutes      jwt_scaffold_config.ttl_minutes%type,
 19      jwk_url          jwt_scaffold_config.jwk_url%type,
 20      kid              jwt_scaffold_config.kid%type,
 21      private_key_b64  jwt_scaffold_config.private_key_b64%type,
 22      public_n         jwt_scaffold_config.public_n%type,
 23      public_e         jwt_scaffold_config.public_e%type
 24    );
 25  
 26    function get_config return t_config is
 27      l_config t_config;
 28    begin
 29      select issuer,
 30             audience,
 31             scope_name,
 32             ttl_minutes,
 33             jwk_url,
 34             kid,
 35             private_key_b64,
 36             public_n,
 37             public_e
 38        into l_config
 39        from jwt_scaffold_config
 40       where config_id = 1;
 41  
 42      return l_config;
 43    end get_config;
 44  
 45    function password_digest(
 46      p_password in varchar2,
 47      p_salt     in raw
 48    ) return raw is
 49    begin
 50      return dbms_crypto.hash(
 51        src => utl_i18n.string_to_raw(nvl(p_password, ''), 'AL32UTF8') || p_salt,
 52        typ => dbms_crypto.hash_sh256
 53      );
 54    end password_digest;
 55  
 56    function base64url_from_raw(p_raw in raw) return varchar2 is
 57      l_b64 varchar2(32767);
 58    begin
 59      l_b64 := utl_raw.cast_to_varchar2(utl_encode.base64_encode(p_raw));
 60      l_b64 := replace(l_b64, chr(10), '');
 61      l_b64 := replace(l_b64, chr(13), '');
 62      l_b64 := replace(l_b64, '+', '-');
 63      l_b64 := replace(l_b64, '/', '_');
 64      l_b64 := rtrim(l_b64, '=');
 65      return l_b64;
 66    end base64url_from_raw;
 67  
 68    function base64url_from_text(p_text in clob) return varchar2 is
 69    begin
 70      return base64url_from_raw(
 71        utl_i18n.string_to_raw(dbms_lob.substr(p_text, 32767, 1), 'AL32UTF8')
 72      );
 73    end base64url_from_text;
 74  
 75    function epoch_seconds_now return number is
 76    begin
 77      return floor(
 78        (cast(systimestamp at time zone 'UTC' as date) - date '1970-01-01') * 86400
 79      );
 80    end epoch_seconds_now;
 81  
 82    function check_credentials(
 83      p_username in varchar2,
 84      p_password in varchar2
 85    ) return boolean is
 86      l_username varchar2(30) := upper(trim(p_username));
 87      l_digest   raw(32);
 88    begin
 89      if l_username = c_admin_username then
 90        l_digest := password_digest(p_password, c_admin_salt);
 91        return l_digest = c_admin_hash;
 92      elsif l_username = c_user1_username then
 93        l_digest := password_digest(p_password, c_user1_salt);
 94        return l_digest = c_user1_hash;
 95      elsif l_username = c_user2_username then
 96        l_digest := password_digest(p_password, c_user2_salt);
 97        return l_digest = c_user2_hash;
 98      end if;
 99  
100      return false;
101    end check_credentials;
102  
103    function issue_token(
104      p_username    in varchar2,
105      p_scope       in varchar2 default null,
106      p_issuer      in varchar2 default null,
107      p_audience    in varchar2 default null,
108      p_ttl_minutes in number   default null
109    ) return clob is
110      l_config        t_config;
111      l_iat           number;
112      l_exp           number;
113      l_scope         varchar2(4000);
114      l_header_json   clob;
115      l_payload_json  clob;
116      l_header_b64    varchar2(32767);
117      l_payload_b64   varchar2(32767);
118      l_signing_input varchar2(32767);
119      l_signature_raw raw(32767);
120    begin
121      l_config := get_config;
122      l_iat := epoch_seconds_now;
123      -- A negative TTL yields an already-expired token, which is how the conformance suite builds the
124      -- "expired token" case without touching the stored configuration.
125      l_exp := l_iat + (nvl(p_ttl_minutes, l_config.ttl_minutes) * 60);
126      l_scope := nvl(p_scope, l_config.scope_name);
127  
128      select json_object(
129               'alg' value 'RS256',
130               'typ' value 'JWT',
131               'kid' value l_config.kid
132               returning clob
133             )
134        into l_header_json
135        from dual;
136  
137      select json_object(
138               'sub'   value upper(trim(p_username)),
139               'iss'   value nvl(p_issuer, l_config.issuer),
140               'aud'   value nvl(p_audience, l_config.audience),
141               'exp'   value l_exp,
142               'iat'   value l_iat,
143               'scope' value l_scope,
144               'env'   value 'dev-scaffold'
145               returning clob
146             )
147        into l_payload_json
148        from dual;
149  
150      l_header_b64 := base64url_from_text(l_header_json);
151      l_payload_b64 := base64url_from_text(l_payload_json);
152      l_signing_input := l_header_b64 || '.' || l_payload_b64;
153  
154      l_signature_raw := dbms_crypto.sign(
155        src        => utl_i18n.string_to_raw(l_signing_input, 'AL32UTF8'),
156        prv_key    => utl_i18n.string_to_raw(l_config.private_key_b64, 'AL32UTF8'),
157        pubkey_alg => dbms_crypto.key_type_rsa,
158        sign_alg   => dbms_crypto.sign_sha256_rsa
159      );
160  
161      return l_signing_input || '.' || base64url_from_raw(l_signature_raw);
162    end issue_token;
163  
164    function jwks_document return clob is
165      l_config t_config;
166      l_jwks   clob;
167    begin
168      l_config := get_config;
169  
170      select json_object(
171               'keys' value json_array(
172                 json_object(
173                   'kty' value 'RSA',
174                   'use' value 'sig',
175                   'kid' value l_config.kid,
176                   'alg' value 'RS256',
177                   'n'   value l_config.public_n,
178                   'e'   value l_config.public_e
179                   returning clob
180                 )
181                 returning clob
182               )
183               returning clob
184             )
185        into l_jwks
186        from dual;
187  
188      return l_jwks;
189    end jwks_document;
190  
191    procedure authenticate_json(
192      p_body              in  clob,
193      p_access_token      out varchar2,
194      p_token_type        out varchar2,
195      p_expires_in        out number,
196      p_kid               out varchar2,
197      p_error             out varchar2,
198      p_error_description out varchar2,
199      p_http_status       out number
200    ) is
201      l_payload  json_object_t;
202      l_username varchar2(255);
203      l_password varchar2(255);
204      l_config   t_config;
205    begin
206      p_access_token := null;
207      p_token_type := null;
208      p_expires_in := null;
209      p_kid := null;
210      p_error := null;
211      p_error_description := null;
212      p_http_status := 200;
213  
214      l_payload := json_object_t.parse(p_body);
215      l_username := upper(trim(l_payload.get_string('username')));
216      l_password := l_payload.get_string('password');
217  
218      if l_username is null or l_password is null then
219        p_error := 'invalid_request';
220        p_error_description := 'username and password are required';
221        p_http_status := 400;
222        return;
223      end if;
224  
225      if not check_credentials(l_username, l_password) then
226        p_error := 'invalid_credentials';
227        p_error_description := 'invalid username or password';
228        p_http_status := 401;
229        return;
230      end if;
231  
232      l_config := get_config;
233  
234      p_access_token := issue_token(l_username, l_config.scope_name);
235      p_token_type := 'Bearer';
236      p_expires_in := l_config.ttl_minutes * 60;
237      p_kid := l_config.kid;
238      p_http_status := 200;
239    exception
240      when others then
241        if sqlcode in (-40441, -40587) then
242          p_error := 'invalid_request';
243          p_error_description := 'request body must be valid JSON';
244          p_http_status := 400;
245        else
246          p_error := 'server_error';
247          p_error_description := substr(sqlerrm, 1, 250);
248          p_http_status := 500;
249        end if;
250    end authenticate_json;
251  end jwt_scaffold_auth_api;
252  /

