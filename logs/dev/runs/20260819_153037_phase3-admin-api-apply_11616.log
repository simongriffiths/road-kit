398      exception
399        when others then
400          l_raised := true;
401          if sqlcode != road_ctx_pkg.c_forbidden then
402            fail('expected forbidden, got ' || sqlcode || ': ' || sqlerrm);
403          end if;
404      end;
405      if not l_raised then fail('attaching to a reserved role must be refused'); end if;
406  
407      select count(*) into l_count
408        from road_role_permissions
409       where role_name = 'road.user_admin' and permission_name = 'session.read';
410      assert_eq('no row written', '0', to_char(l_count));
