544        insert into road_role_permissions (role_name, permission_name, attached_by)
545        values ('test.grantedby', 'road.role.compose', l_sys);
546        rollback;
547      exception
548        when others then
549          rollback;
550          l_raised := true;
551          if sqlcode != -8601 then
552            fail('expected ORA-08601, got ' || sqlcode || ': ' || sqlerrm);
