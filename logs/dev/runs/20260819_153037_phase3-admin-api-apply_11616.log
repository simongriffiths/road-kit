413    -- THE test that proves spec-patch-07 section 1's claim end to end: composition is a data change,
414    -- not a release. Nothing tested this before now, because until this phase nothing COULD.
415    procedure test_composition_takes_effect_on_next_request is
416      l_res json;
417    begin
418      insert into road_permissions (permission_name, description)
419      values ('test.appperm.compose', 'road_admin test fixture');
420  
421      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then fail('establish'); end if;
422      l_res := road_admin_api.attach_permission(
423                 json('{"role_name":"test.composetarget","permission_name":"test.appperm.compose"}'));
424      assert_eq('attached', 'true', json_value(l_res, '$.attached'));
425  
426      -- TARGET holds test.composetarget (setup). Re-establishing loads effective permissions fresh
427      -- from road_role_permissions -- no deploy, no new machinery.
428      road_ctx_pkg.end_request;
429      if not road_ctx_pkg.begin_request('TARGET', c_issuer) then fail('TARGET should establish'); end if;
430      if not road_ctx_pkg.has_permission('test.appperm.compose') then
431        fail('composition did not take effect on the next request');
432      end if;
433    end test_composition_takes_effect_on_next_request;
