  2  
  3    -- The two tests that carry this phase are test_user_admin_cannot_grant_reserved and
  4    -- test_granted_by_ignores_request_body. Everything else is ordinary coverage.
  5  
  6    c_issuer constant varchar2(64) := 'urn:road:test:road_admin';
  7  
  8    l_pass number := 0;
  9    l_fail number := 0;
 10  
 11    procedure fail(p_message in varchar2) is
 12    begin
 13      raise_application_error(-20000, p_message);
 14    end fail;
 15  
 16    procedure assert_eq(p_label in varchar2, p_expected in varchar2, p_actual in varchar2) is
 17    begin
 18      if nvl(p_actual, '<null>') != nvl(p_expected, '<null>') then
 19        fail(p_label || ': expected [' || p_expected || '] got [' || p_actual || ']');
 20      end if;
 21    end assert_eq;
 22  
 23    function principal_of(p_subject in varchar2) return number is
 24      l_id number;
 25    begin
 26      select principal_id into l_id
 27        from road_principals where issuer = c_issuer and subject = p_subject;
 28      return l_id;
 29    end principal_of;
 30  
 31    procedure setup is
 32      l_sys    number;
 33      l_usr    number;
 34      l_tgt    number;
 35      l_target number;
 36    begin
 37      execute immediate 'alter session disable parallel dml';
 38  
 39      insert into road_principals (issuer, subject, display_name, status)
 40      select c_issuer, 'SYSADM', 'road_admin test fixture', 'ACTIVE' from dual
 41       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'SYSADM');
 42      insert into road_principals (issuer, subject, display_name, status)
 43      select c_issuer, 'USRADM', 'road_admin test fixture', 'ACTIVE' from dual
 44       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'USRADM');
 45      insert into road_principals (issuer, subject, display_name, status)
 46      select c_issuer, 'TARGET', 'road_admin test fixture', 'ACTIVE' from dual
 47       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'TARGET');
 48  
 49      -- Distinctive name and address, so the get_principals search tests can assert an exact count
 50      -- against a database that also holds the real seeded principals.
 51      insert into road_principals (issuer, subject, display_name, email, status)
 52      select c_issuer, 'SEARCHME', 'Searchable Fixture', 'find.me@example.test', 'ACTIVE' from dual
 53       where not exists (select 1 from road_principals
 54                          where issuer = c_issuer and subject = 'SEARCHME');
 55  
 56      -- One role per grant test. Sharing a single role made two tests pass or fail depending on
 57      -- which ran first: whoever granted it first owned granted_by, and every later grant was a
 58      -- correct no-op that read as a failure.
 59      insert into road_roles (role_name, display_name, is_reserved)
 60      select 'test.ordinary', 'road_admin test fixture', 'N' from dual
 61       where not exists (select 1 from road_roles where role_name = 'test.ordinary');
 62      insert into road_roles (role_name, display_name, is_reserved)
 63      select 'test.grantedby', 'road_admin test fixture', 'N' from dual
 64       where not exists (select 1 from road_roles where role_name = 'test.grantedby');
 65      insert into road_roles (role_name, display_name, is_reserved)
 66      select 'test.idem', 'road_admin test fixture', 'N' from dual
 67       where not exists (select 1 from road_roles where role_name = 'test.idem');
 68      insert into road_roles (role_name, display_name, is_reserved)
 69      select 'test.searchable', 'road_admin test fixture', 'N' from dual
 70       where not exists (select 1 from road_roles where role_name = 'test.searchable');
 71      -- Dedicated to test_composition_takes_effect_on_next_request -- NOT test.ordinary, which
 72      -- test_grant_all_app_permissions_is_explicit blanket-attaches every application permission to
 73      -- (deploy-attached), and which test_user_admin_cannot_grant_reserved's own grant_role call
 74      -- assumes TARGET does not already hold.
 75      insert into road_roles (role_name, display_name, is_reserved)
 76      select 'test.composetarget', 'road_admin test fixture', 'N' from dual
 77       where not exists (select 1 from road_roles where role_name = 'test.composetarget');
 78  
 79      l_sys := principal_of('SYSADM');
 80      l_usr := principal_of('USRADM');
 81      l_tgt := principal_of('SEARCHME');
 82  
 83      insert into road_principal_roles (principal_id, role_name)
 84      select l_tgt, 'test.searchable' from dual
 85       where not exists (select 1 from road_principal_roles
 86                          where principal_id = l_tgt and role_name = 'test.searchable');
 87  
 88      insert into road_principal_roles (principal_id, role_name)
 89      select l_sys, 'road.system_admin' from dual
 90       where not exists (select 1 from road_principal_roles
 91                          where principal_id = l_sys and role_name = 'road.system_admin');
 92      insert into road_principal_roles (principal_id, role_name)
 93      select l_usr, 'road.user_admin' from dual
 94       where not exists (select 1 from road_principal_roles
 95                          where principal_id = l_usr and role_name = 'road.user_admin');
 96  
 97      -- TARGET holds test.composetarget directly (not via another test's side effect), so
 98      -- test_composition_takes_effect_on_next_request stays correct regardless of run order.
 99      l_target := principal_of('TARGET');
100      insert into road_principal_roles (principal_id, role_name)
101      select l_target, 'test.composetarget' from dual
102       where not exists (select 1 from road_principal_roles
103                          where principal_id = l_target and role_name = 'test.composetarget');
104      commit;
105    end setup;
106  
107    procedure teardown is
108    begin
109      -- road_role_permissions BEFORE road_principals: spec-patch-07 added ATTACHED_BY, a nullable FK
110      -- to road_principals, and the composition tests below leave rows attached_by one of this
111      -- fixture's own principals (SYSADM). Deleting road_principals first would raise ORA-02292
112      -- (child record found) against those rows.
113      delete from road_role_permissions
114       where role_name in ('test.ordinary', 'test.definedrole', 'test.grantedby', 'test.idem',
115                           'test.searchable', 'test.composetarget');
116      delete from road_principal_roles
117       where principal_id in (select principal_id from road_principals where issuer = c_issuer);
118      delete from road_principals where issuer = c_issuer;
119      delete from road_roles
120       where role_name in ('test.ordinary', 'test.definedrole', 'test.grantedby', 'test.idem',
121                           'test.searchable', 'test.composetarget');
122      delete from road_permissions where permission_name like 'test.appperm%';
123      commit;
124      road_ctx_pkg.end_request;
125    end teardown;
126  
127    -- THE test for this phase. Nothing in the table structure prevents it, so if this check is ever
128    -- removed the model silently collapses to one tier: any user_admin could promote themselves.
129    procedure test_user_admin_cannot_grant_reserved is
130      l_res    json;
131      l_raised boolean := false;
132    begin
133      if not road_ctx_pkg.begin_request('USRADM', c_issuer) then
134        fail('USRADM should establish');
135      end if;
136  
137      -- It CAN grant an ordinary role -- proving the denial below is about the role, not a blanket
138      -- lack of permission.
139      l_res := road_admin_api.grant_role(
140                 json('{"principal_id":' || principal_of('TARGET') || ',"role_name":"test.ordinary"}'));
141      assert_eq('ordinary grant succeeded', 'true', json_value(l_res, '$.granted'));
142  
143      begin
144        l_res := road_admin_api.grant_role(
145                   json('{"principal_id":' || principal_of('TARGET')
146                        || ',"role_name":"road.system_admin"}'));
147      exception
148        when others then
149          l_raised := true;
150          if sqlcode != road_ctx_pkg.c_forbidden then
151            fail('expected forbidden, got ' || sqlcode || ': ' || sqlerrm);
152          end if;
153      end;
154  
155      if not l_raised then
156        fail('a road.user_admin must NOT be able to grant road.system_admin');
157      end if;
158  
159      -- And it must not have happened anyway.
160      declare
161        l_count  number;
162        l_target number := principal_of('TARGET');  -- body-private, so not usable inside SQL
163      begin
164        select count(*) into l_count
165          from road_principal_roles
166         where principal_id = l_target and role_name = 'road.system_admin';
167        assert_eq('no reserved grant written', '0', to_char(l_count));
168      end;
169    end test_user_admin_cannot_grant_reserved;
170  
171    procedure test_system_admin_can_grant_reserved is
172      l_res json;
173    begin
174      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then
175        fail('SYSADM should establish');
176      end if;
177      l_res := road_admin_api.grant_role(
178                 json('{"principal_id":' || principal_of('TARGET') || ',"role_name":"road.user_admin"}'));
179      assert_eq('system_admin granted reserved role', 'true', json_value(l_res, '$.granted'));
180    end test_system_admin_can_grant_reserved;
181  
182    -- granted_by must come from the session, not the caller. A caller who could nominate it could
183    -- forge the record of who authorised an escalation.
184    procedure test_granted_by_ignores_request_body is
185      l_res    json;
186      l_actual number;
187      l_target number;
188    begin
189      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then
190        fail('SYSADM should establish');
191      end if;
192  
193      l_res := road_admin_api.grant_role(json(
194        '{"principal_id":' || principal_of('TARGET')
195        || ',"role_name":"test.grantedby","granted_by":999999}'));
196  
197      l_target := principal_of('TARGET');
198      select granted_by into l_actual
199        from road_principal_roles
200       where principal_id = l_target and role_name = 'test.grantedby';
201  
202      if l_actual = 999999 then
203        fail('granted_by was taken from the request body');
204      end if;
205      assert_eq('granted_by is the session principal', to_char(principal_of('SYSADM')), to_char(l_actual));
206    end test_granted_by_ignores_request_body;
207  
208    procedure test_grant_is_idempotent is
209      l_res json;
210    begin
211      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then fail('establish'); end if;
212      l_res := road_admin_api.grant_role(
213                 json('{"principal_id":' || principal_of('TARGET') || ',"role_name":"test.idem"}'));
214      assert_eq('first grant', 'true', json_value(l_res, '$.granted'));
215      l_res := road_admin_api.grant_role(
216                 json('{"principal_id":' || principal_of('TARGET') || ',"role_name":"test.idem"}'));
217      assert_eq('second grant is a no-op, not an error', 'false', json_value(l_res, '$.granted'));
218    end test_grant_is_idempotent;
219  
220    procedure test_cannot_revoke_last_system_admin is
221      l_raised boolean := false;
222      l_res    json;
223    begin
224      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then fail('establish'); end if;
225  
226      -- The fixture SYSADM plus the seeded bootstrap admin means more than one holder exists, so
227      -- revoke the fixture's own to get down to the last one, then prove the last is refused.
228      l_res := road_admin_api.revoke_role(
229                 json('{"principal_id":' || principal_of('SYSADM')
230                      || ',"role_name":"road.system_admin"}'));
231      assert_eq('fixture admin revoked', 'true', json_value(l_res, '$.revoked'));
232  
233      -- Re-establish as the seeded bootstrap admin, now the only holder, and try to remove itself.
234      road_ctx_pkg.end_request;
235      declare
236        l_subject road_config.config_value%type;
237        l_boot    number;
238      begin
239        select config_value into l_subject
240          from road_config where config_key = 'bootstrap_admin_subject';
241        if not road_ctx_pkg.begin_request(l_subject) then fail('bootstrap admin should establish'); end if;
242        select principal_id into l_boot
243          from road_principals
244         where subject = l_subject and issuer = road_ctx_pkg.issuer;
245  
246        begin
247          l_res := road_admin_api.revoke_role(
248                     json('{"principal_id":' || l_boot || ',"role_name":"road.system_admin"}'));
249        exception
250          when others then
251            l_raised := true;
252            if sqlcode != -20001 then
253              fail('expected validation error, got ' || sqlcode || ': ' || sqlerrm);
254            end if;
255        end;
256      end;
257  
258      if not l_raised then
259        fail('revoking the last road.system_admin must be refused');
260      end if;
261    end test_cannot_revoke_last_system_admin;
262  
263    procedure test_define_role_rejects_road_namespace is
264      l_raised boolean := false;
265      l_res    json;
266    begin
267      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then fail('establish'); end if;
268  
269      l_res := road_admin_api.define_role(
270                 json('{"role_name":"test.definedrole","display_name":"Defined"}'));
271      assert_eq('ordinary role defined', 'test.definedrole', json_value(l_res, '$.role_name'));
272  
273      begin
274        l_res := road_admin_api.define_role(json('{"role_name":"road.sneaky"}'));
275      exception
276        when others then
277          l_raised := true;
278      end;
279      if not l_raised then
280        fail('the road. namespace must be refused');
281      end if;
282    end test_define_role_rejects_road_namespace;
283  
284    -- A user_admin holds road.role.grant but NOT road.role.define, so defining must 403.
285    procedure test_user_admin_cannot_define_roles is
286      l_raised boolean := false;
287      l_res    json;
288    begin
289      if not road_ctx_pkg.begin_request('USRADM', c_issuer) then fail('establish'); end if;
290      begin
291        l_res := road_admin_api.define_role(json('{"role_name":"test.notallowed"}'));
292      exception
293        when others then
294          l_raised := true;
