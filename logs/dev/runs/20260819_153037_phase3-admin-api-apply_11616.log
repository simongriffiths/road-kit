601    ---------------------------------------------------------------------------
602    -- get_principals (ui-authorisation-design-v1.md section 5.2)
603    ---------------------------------------------------------------------------
604  
605    -- The gate is road.role.grant, so a principal who holds neither admin role must be denied even
606    -- though they are perfectly well authenticated. Without this the endpoint would be a directory of
607    -- everyone's email address readable by every signed-in user.
608    procedure test_get_principals_requires_permission is
609      l_res    json;
610      l_raised boolean := false;
611    begin
612      -- SEARCHME, not TARGET: TARGET has been granted road.user_admin by an earlier test in this
613      -- run, so it would pass the gate and the assertion would prove nothing. SEARCHME holds one
614      -- ordinary role with no permissions attached.
615      if not road_ctx_pkg.begin_request('SEARCHME', c_issuer) then
616        fail('SEARCHME should establish');
617      end if;
618  
619      begin
620        l_res := road_admin_api.get_principals(json('{}'));
621      exception
622        when others then
623          l_raised := true;
624          if sqlcode != road_ctx_pkg.c_forbidden then
625            fail('expected c_forbidden, got ' || sqlcode);
626          end if;
627      end;
628      if not l_raised then fail('get_principals must deny a principal without road.role.grant'); end if;
629  
630      -- And with no session at all, for the "handler forgot begin_request" path.
631      road_ctx_pkg.end_request;
632      l_raised := false;
633      begin
634        l_res := road_admin_api.get_principals(json('{}'));
635      exception
636        when others then
637          l_raised := true;
638      end;
639      if not l_raised then fail('get_principals must deny with no session'); end if;
640    end test_get_principals_requires_permission;
641  
642    procedure test_get_principals_search is
643      l_res json;
644    begin
645      if not road_ctx_pkg.begin_request('USRADM', c_issuer) then
646        fail('USRADM should establish');
647      end if;
648  
649      -- Case-insensitive, and matching on display_name.
650      l_res := road_admin_api.get_principals(json('{"q":"sEaRcHaBlE"}'));
651      assert_eq('display_name match count', '1', json_value(l_res, '$.count'));
652      assert_eq('display_name match subject', 'SEARCHME', json_value(l_res, '$.items[0].subject'));
653  
654      -- Matching on email, which is the column the screen exists to make usable.
655      l_res := road_admin_api.get_principals(json('{"q":"find.me@example.test"}'));
656      assert_eq('email match count', '1', json_value(l_res, '$.count'));
657      assert_eq('email is returned', 'find.me@example.test', json_value(l_res, '$.items[0].email'));
658  
659      -- Matching on subject, for the case where a principal has neither name nor address yet.
660      l_res := road_admin_api.get_principals(json('{"q":"SEARCHME"}'));
661      assert_eq('subject match count', '1', json_value(l_res, '$.count'));
662  
663      -- The row carries its roles, so the table renders without a request per principal. Objects,
664      -- not bare names (spec-patch-07 section 8.1) -- role_name and is_reserved both travel.
665      assert_eq('roles travel with the row', 'test.searchable',
666                json_value(l_res, '$.items[0].roles[0].role_name'));
667      assert_eq('reserved-ness travels with the row', 'N',
668                json_value(l_res, '$.items[0].roles[0].is_reserved'));
669  
670      -- A LIKE wildcard typed into the search box must be a literal. Unescaped, this matches every
671      -- principal and the user believes they have searched.
672      l_res := road_admin_api.get_principals(json('{"q":"%"}'));
673      assert_eq('percent is a literal, not a wildcard', '0', json_value(l_res, '$.count'));
674  
675      -- A valid status filter narrows rather than empties.
676      l_res := road_admin_api.get_principals(json('{"q":"searchable","status":"ACTIVE"}'));
677      assert_eq('active filter keeps the row', '1', json_value(l_res, '$.count'));
678  
679      l_res := road_admin_api.get_principals(json('{"q":"searchable","status":"RETIRED"}'));
680      assert_eq('retired filter excludes it', '0', json_value(l_res, '$.count'));
681  
682      -- An unrecognised status is refused rather than ignored: silently returning the unfiltered
683      -- list would let the caller believe it had filtered.
684      declare
685        l_raised boolean := false;
686      begin
687        begin
688          l_res := road_admin_api.get_principals(json('{"status":"BANNED"}'));
689        exception
690          when others then
691            l_raised := true;
692        end;
693        if not l_raised then fail('an unrecognised status must be refused, not ignored'); end if;
694      end;
695    end test_get_principals_search;
696  
697    procedure test_get_principals_paging is
698      l_res   json;
699      l_first varchar2(255 char);
700    begin
701      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then
702        fail('SYSADM should establish');
703      end if;
704  
705      -- At least four principals exist by now (three fixtures plus the searchable one), so a page of
706      -- one must report more to come.
707      l_res := road_admin_api.get_principals(json('{"limit":1,"offset":0}'));
708      assert_eq('one row on the page', '1', json_value(l_res, '$.count'));
709      assert_eq('hasMore is true',   'true', json_value(l_res, '$.hasMore'));
710      l_first := json_value(l_res, '$.items[0].subject');
711  
712      -- The second page must not repeat the first. Stable ordering is what a prev/next pager rests
713      -- on; without it paging silently duplicates and skips rows.
714      l_res := road_admin_api.get_principals(json('{"limit":1,"offset":1}'));
715      if json_value(l_res, '$.items[0].subject') = l_first then
716        fail('offset did not advance the page');
717      end if;
718  
719      -- Clamped, not rejected: an out-of-range page size is a client bug, and an unclamped limit is
720      -- a denial-of-service parameter.
721      l_res := road_admin_api.get_principals(json('{"limit":9999}'));
722      assert_eq('limit clamped to the maximum', '100', json_value(l_res, '$.limit'));
723  
724      l_res := road_admin_api.get_principals(json('{"limit":0}'));
725      assert_eq('limit clamped to the minimum', '1', json_value(l_res, '$.limit'));
726  
727      l_res := road_admin_api.get_principals(json('{"offset":-5}'));
728      assert_eq('negative offset clamped', '0', json_value(l_res, '$.offset'));
729  
730      -- Past the end is an empty page, not an error.
731      l_res := road_admin_api.get_principals(json('{"offset":100000}'));
732      assert_eq('past the end returns nothing', '0', json_value(l_res, '$.count'));
733      assert_eq('past the end has no more',  'false', json_value(l_res, '$.hasMore'));
734    end test_get_principals_paging;
735  
736    procedure run(p_name in varchar2, p_which in varchar2) is
737    begin
738      case p_which
739        when 'user_admin_reserved'   then test_user_admin_cannot_grant_reserved;
740        when 'sysadmin_reserved'     then test_system_admin_can_grant_reserved;
741        when 'granted_by'            then test_granted_by_ignores_request_body;
742        when 'idempotent'            then test_grant_is_idempotent;
743        when 'last_admin'            then test_cannot_revoke_last_system_admin;
744        when 'define_namespace'      then test_define_role_rejects_road_namespace;
745        when 'user_admin_define'     then test_user_admin_cannot_define_roles;
746        when 'unauthenticated'       then test_unauthenticated_denied;
747        when 'grant_all'             then test_grant_all_app_permissions_is_explicit;
748        when 'principals_permission' then test_get_principals_requires_permission;
749        when 'principals_search'     then test_get_principals_search;
750        when 'principals_paging'     then test_get_principals_paging;
751        when 'attach_reserved_perm'  then test_attach_reserved_permission_refused;
752        when 'attach_reserved_role'  then test_attach_to_reserved_role_refused;
753        when 'compose_effect'        then test_composition_takes_effect_on_next_request;
754        when 'attached_by'           then test_attached_by_ignores_request_body;
755        when 'compose_idempotent'    then test_attach_detach_idempotent;
756        when 'compose_denied'        then test_compose_denied_without_permission;
757        when 'assert_permit_ord'     then test_assertion_permits_ordinary_session_attach;
758        when 'assert_refuse_res'     then test_assertion_refuses_reserved_session_attach;
759        when 'assert_refuse_flip'    then test_assertion_refuses_flip_under_session_attach;
760        when 'assert_permit_deploy'  then test_assertion_permits_reserved_deploy_attach;
761      end case;
762      dbms_output.put_line('PASS ' || p_name);
763      l_pass := l_pass + 1;
764    exception
765      when others then
766        dbms_output.put_line('FAIL ' || p_name || ': ' || sqlerrm);
767        l_fail := l_fail + 1;
768    end run;
769  
770    procedure run_all is
771    begin
772      l_pass := 0;
773      l_fail := 0;
774      setup;
775  
776      run('test_user_admin_cannot_grant_reserved', 'user_admin_reserved');
777      run('test_system_admin_can_grant_reserved', 'sysadmin_reserved');
778      run('test_granted_by_ignores_request_body', 'granted_by');
779      run('test_grant_is_idempotent', 'idempotent');
780      run('test_define_role_rejects_road_namespace', 'define_namespace');
781      run('test_user_admin_cannot_define_roles', 'user_admin_define');
782      run('test_unauthenticated_denied', 'unauthenticated');
783      run('test_grant_all_app_permissions_is_explicit', 'grant_all');
784      run('test_get_principals_requires_permission', 'principals_permission');
785      run('test_get_principals_search', 'principals_search');
786      run('test_get_principals_paging', 'principals_paging');
787  
788      run('test_attach_reserved_permission_refused', 'attach_reserved_perm');
789      run('test_attach_to_reserved_role_refused', 'attach_reserved_role');
790      run('test_composition_takes_effect_on_next_request', 'compose_effect');
791      run('test_attached_by_ignores_request_body', 'attached_by');
792      run('test_attach_detach_idempotent', 'compose_idempotent');
793      run('test_compose_denied_without_permission', 'compose_denied');
794      run('test_assertion_permits_ordinary_session_attach', 'assert_permit_ord');
795      run('test_assertion_refuses_reserved_session_attach', 'assert_refuse_res');
796      run('test_assertion_refuses_flip_under_session_attach', 'assert_refuse_flip');
