318    procedure test_grant_all_app_permissions_is_explicit is
319      l_before number;
320      l_after  number;
321    begin
322      insert into road_permissions (permission_name, description)
323      values ('test.appperm.one', 'road_admin test fixture');
324      insert into road_permissions (permission_name, description)
325      values ('test.appperm.two', 'road_admin test fixture');
326  
327      road_admin_api.grant_all_app_permissions('test.ordinary');
328  
329      select count(*) into l_before
330        from road_role_permissions
331       where role_name = 'test.ordinary' and permission_name like 'test.appperm%';
332      assert_eq('both app permissions granted', '2', to_char(l_before));
333  
334      -- No road.* permission may be picked up by the blanket grant.
335      select count(*) into l_after
336        from road_role_permissions
337       where role_name = 'test.ordinary' and permission_name like 'road.%';
338      assert_eq('no framework permissions granted', '0', to_char(l_after));
339  
340      -- A permission added AFTERWARDS must not be acquired -- that is rule 4, and the reason this is
341      -- a deploy-time write rather than a runtime wildcard.
342      insert into road_permissions (permission_name, description)
343      values ('test.appperm.three', 'added after the blanket grant');
344      select count(*) into l_after
345        from road_role_permissions
346       where role_name = 'test.ordinary' and permission_name = 'test.appperm.three';
347      assert_eq('later permission NOT silently acquired', '0', to_char(l_after));
348    end test_grant_all_app_permissions_is_explicit;
