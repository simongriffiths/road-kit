350    ---------------------------------------------------------------------------
351    -- Role composition (spec-patch-07 section 7.1)
352    ---------------------------------------------------------------------------
353  
354    -- THE escalation test for this patch. If this check is removed the two-tier model collapses
355    -- silently: any road.role.compose holder could attach the framework's own reserved permissions
356    -- to any role.
357    procedure test_attach_reserved_permission_refused is
358      l_raised boolean := false;
359      l_res    json;
360      l_count  number;
361    begin
362      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then fail('establish'); end if;
363  
364      begin
365        -- test.idem, not test.ordinary: test_grant_all_app_permissions_is_explicit blanket-attaches
366        -- every non-road.* permission to test.ordinary (deploy-attached, legally including
367        -- events.purge), so a row-count check against it would pass even if this refusal were
368        -- broken. events.purge is reserved (spec-patch-07 section 3.1's worked example) and does not
369        -- start with road. -- proving the guard reads the flag, not the name.
370        l_res := road_admin_api.attach_permission(
371                   json('{"role_name":"test.idem","permission_name":"events.purge"}'));
372      exception
373        when others then
374          l_raised := true;
375          if sqlcode != road_ctx_pkg.c_forbidden then
376            fail('expected forbidden, got ' || sqlcode || ': ' || sqlerrm);
377          end if;
378      end;
379      if not l_raised then fail('attaching a reserved permission must be refused'); end if;
380  
381      select count(*) into l_count
382        from road_role_permissions
383       where role_name = 'test.idem' and permission_name = 'events.purge';
384      assert_eq('no row written', '0', to_char(l_count));
385    end test_attach_reserved_permission_refused;
