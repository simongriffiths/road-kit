528      insert into road_permissions (permission_name, description)
529      values ('test.appperm.assertok', 'road_admin test fixture');
530      insert into road_role_permissions (role_name, permission_name, attached_by)
531      values ('test.idem', 'test.appperm.assertok', l_sys);
532      rollback;
533    exception
534      when others then
535        rollback;
536        fail('ordinary permission, session-attached, must be permitted: ' || sqlerrm);
537    end test_assertion_permits_ordinary_session_attach;
