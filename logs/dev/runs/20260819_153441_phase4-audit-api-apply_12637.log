SQL> create or replace package road_audit_api as
  2  
  3    -- Issues a read-token GUID and logs the read as a road_api_log row (caller_type/caller_ref/
  4    -- app_schema/endpoint). Per spec-patch-01-concurrency.md §6.
  5    function issue_read_token(
  6      p_caller_type in varchar2,
  7      p_app_schema  in varchar2,
  8      p_endpoint    in varchar2,
  9      p_caller_ref  in varchar2 default null
 10    ) return raw;
 11  
 12    -- TRUE if p_current_updated_at is no later than the token's issued_at (nothing touched by
 13    -- this entity has changed since the read that issued p_guid) — FALSE otherwise, including
 14    -- when p_guid does not correspond to any issued token. Also annotates the token's
 15    -- road_api_log row with entity_type/entity_id/outcome ('OK' or 'STALE_REJECTED') so the one
 16    -- row serves concurrency, observability and audit together (spec-patch-01-concurrency.md §5).
 17    function check_fresh(
 18      p_guid               in raw,
 19      p_app_schema         in varchar2,
 20      p_entity_type        in varchar2,
 21      p_entity_id          in varchar2,
 22      p_current_updated_at in timestamp with time zone
 23    ) return boolean;
 24  
 25    -- Records an administrative action against road_api_log, taking the actor from road_ctx rather
 26    -- than from a parameter -- the caller cannot misattribute what it did.
 27    --
 28    -- Autonomous, so the audit row survives a failed or rolled-back operation. An action that was
 29    -- attempted and failed is exactly the one worth having a record of.
 30    procedure log_admin_action(
 31      p_endpoint    in varchar2,
 32      p_entity_type in varchar2 default null,
 33      p_entity_id   in varchar2 default null,
 34      p_outcome     in varchar2 default null
 35    );
 36  
 37  end road_audit_api;
 38  /

