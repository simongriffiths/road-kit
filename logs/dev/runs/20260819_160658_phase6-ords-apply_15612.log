SQL> declare
  2    l_count number;
  3  
  4    procedure assert(p_condition in boolean, p_message in varchar2) is
  5    begin
  6      if not nvl(p_condition, false) then
  7        raise_application_error(-20000, p_message);
  8      end if;
  9    end assert;
 10  begin
 11    -- 1. todo.purge is reserved. If this ever reads 'N', the composition UI can hand the most
 12    --    destructive operation in the app to any role.
 13    select count(*) into l_count
 14      from road_permissions
 15     where permission_name = 'todo.purge' and is_reserved = 'Y';
 16    assert(l_count = 1, 'todo.purge must exist and be reserved');
 17  
 18    -- 2. And it is held by todo_admin alone (spec-patch-08 section 8, assertion 3).
 19    select count(*) into l_count
 20      from road_role_permissions
 21     where permission_name = 'todo.purge';
 22    assert(l_count = 1, 'todo.purge must be held by exactly one role, found ' || l_count);
 23  
 24    select count(*) into l_count
 25      from road_role_permissions
 26     where permission_name = 'todo.purge' and role_name = 'todo_admin';
 27    assert(l_count = 1, 'todo.purge must be held by todo_admin');
 28  
 29    -- 3. todo_admin holds no ordinary todo permission. Administering todos is not using them.
 30    select count(*) into l_count
 31      from road_role_permissions
 32     where role_name = 'todo_admin'
 33       and permission_name in ('todo.list', 'todo.get', 'todo.create', 'todo.update', 'todo.delete');
 34    assert(l_count = 0, 'todo_admin must hold no ordinary todo permissions, found ' || l_count);
 35  
