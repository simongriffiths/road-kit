SQL> create or replace package body demo_todo_api_test as
  2  
  3    -- The tests that carry this package are test_other_owners_todo_is_not_found (the ownership seam)
  4    -- and test_stale_read_token_conflicts (the concurrency seam). Everything else is ordinary
  5    -- coverage of the handler contract.
  6  
  7    c_issuer constant varchar2(64) := 'urn:road:test:demo_todo';
  8  
  9    l_pass number := 0;
 10    l_fail number := 0;
 11  
 12    procedure fail(p_message in varchar2) is
 13    begin
 14      raise_application_error(-20000, p_message);
 15    end fail;
 16  
 17    procedure assert_eq(p_label in varchar2, p_expected in varchar2, p_actual in varchar2) is
 18    begin
 19      if nvl(p_actual, '<null>') != nvl(p_expected, '<null>') then
 20        fail(p_label || ': expected [' || p_expected || '] got [' || p_actual || ']');
 21      end if;
 22    end assert_eq;
 23  
 24    function principal_of(p_subject in varchar2) return number is
 25      l_id number;
 26    begin
 27      select principal_id into l_id
 28        from road_principals where issuer = c_issuer and subject = p_subject;
 29      return l_id;
 30    end principal_of;
 31  
 32    procedure setup is
 33      l_owner number;
 34      l_other number;
 35      l_admin number;
 36    begin
 37      execute immediate 'alter session disable parallel dml';
 38  
 39      -- OWNER holds the ordinary todo permissions; OTHER holds the same but owns different rows;
 40      -- ADMIN holds todo_admin only. Three principals is the minimum that can show ownership
 41      -- isolation AND that an administrator crosses it.
 42      insert into road_principals (issuer, subject, display_name, status)
 43      select c_issuer, 'OWNER', 'demo_todo test fixture', 'ACTIVE' from dual
 44       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'OWNER');
 45      insert into road_principals (issuer, subject, display_name, status)
 46      select c_issuer, 'OTHER', 'demo_todo test fixture', 'ACTIVE' from dual
 47       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'OTHER');
 48      insert into road_principals (issuer, subject, display_name, status)
 49      select c_issuer, 'ADMIN', 'demo_todo test fixture', 'ACTIVE' from dual
 50       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'ADMIN');
 51  
 52      -- Resolved into locals first: a private packaged function may not be used inside a SQL
 53      -- statement (PLS-00231).
 54      l_owner := principal_of('OWNER');
 55      l_other := principal_of('OTHER');
 56      l_admin := principal_of('ADMIN');
 57  
 58      insert into road_principal_roles (principal_id, role_name)
 59      select l_owner, 'user' from dual
 60       where not exists (select 1 from road_principal_roles
 61                          where principal_id = l_owner and role_name = 'user');
 62      insert into road_principal_roles (principal_id, role_name)
 63      select l_other, 'user' from dual
 64       where not exists (select 1 from road_principal_roles
 65                          where principal_id = l_other and role_name = 'user');
 66      insert into road_principal_roles (principal_id, role_name)
 67      select l_admin, 'todo_admin' from dual
 68       where not exists (select 1 from road_principal_roles
 69                          where principal_id = l_admin and role_name = 'todo_admin');
 70  
 71      commit;
 72    end setup;
 73  
 74    procedure teardown is
 75    begin
 76      delete from demo_todos
 77       where owner_principal_id in (select principal_id from road_principals where issuer = c_issuer);
 78      delete from road_principal_roles
 79       where principal_id in (select principal_id from road_principals where issuer = c_issuer);
 80      delete from road_principals where issuer = c_issuer;
 81      commit;
 82      road_ctx_pkg.end_request;
 83    end teardown;
 84  
 85    -- Creates a todo directly, bypassing the API, so a test can arrange state without depending on
 86    -- create_todo being correct.
 87    function seed_todo(p_subject in varchar2, p_title in varchar2,
 88                       p_status in varchar2 default 'OPEN') return number is
 89      l_id    number;
 90      l_owner number;
 91    begin
 92      l_owner := principal_of(p_subject);
 93      insert into demo_todos (owner_principal_id, title, status)
 94      values (l_owner, p_title, p_status)
 95      returning todo_id into l_id;
 96      return l_id;
 97    end seed_todo;
 98  
 99    ---------------------------------------------------------------------------
100    -- Ownership (spec-patch-08 section 6.1)
101    ---------------------------------------------------------------------------
102  
103    -- THE ownership test. A todo belonging to someone else is NOT FOUND, not FORBIDDEN -- a 403
104    -- would confirm the row exists, which the caller has not earned.
105    procedure test_other_owners_todo_is_not_found is
106      l_id     number;
107      l_raised boolean := false;
108      l_res    json;
109    begin
110      l_id := seed_todo('OTHER', 'not yours');
111      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
112  
113      begin
114        l_res := demo_todo_api.get_todo(json('{"todo_id":' || l_id || '}'));
115      exception
116        when others then
117          l_raised := true;
118          if sqlcode != demo_todo_api.c_not_found then
119            fail('expected NOT_FOUND (' || demo_todo_api.c_not_found || '), got '
120                 || sqlcode || ': ' || sqlerrm);
121          end if;
122      end;
123      if not l_raised then fail('another owner''s todo must not be readable'); end if;
124    end test_other_owners_todo_is_not_found;
125  
126    -- todo_admin holds todo.list_all but NOT todo.list, so it cannot list at all. That is the
127    -- separation rule 2 of spec patch 06 applies to road.system_admin, carried into the application:
128    -- administering todos is not using them. It also proves list_all does not imply list -- an
129    -- easy and invisible mistake to make when wiring the two.
130    --
131    -- Naming this honestly matters. An earlier draft called it test_admin_can_list_another_owner,
132    -- which is the opposite of what it asserts.
133    procedure test_list_all_does_not_imply_list is
134      l_ignore number;
135      l_res    json;
136      l_raised boolean := false;
137    begin
138      l_ignore := seed_todo('OWNER', 'admin cannot see me either');
139      if not road_ctx_pkg.begin_request('ADMIN', c_issuer) then fail('establish'); end if;
140  
141      begin
142        l_res := demo_todo_api.get_todos(json('{"owner":' || principal_of('OWNER') || '}'));
143      exception
144        when others then
145          l_raised := true;
146          if sqlcode != road_ctx_pkg.c_forbidden then
147            fail('expected forbidden, got ' || sqlcode || ': ' || sqlerrm);
148          end if;
149      end;
150      if not l_raised then fail('todo_admin holds no todo.list and must not be able to list'); end if;
151    end test_list_all_does_not_imply_list;
152  
153    -- Naming your own principal_id explicitly is not an escalation and must not be treated as one.
154    procedure test_own_owner_param_is_not_escalation is
155      l_res json;
156    begin
157      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
158      l_res := demo_todo_api.get_todos(json('{"owner":' || principal_of('OWNER') || '}'));
159      assert_eq('own rows listed', '0', json_value(l_res, '$.offset'));
160    end test_own_owner_param_is_not_escalation;
161  
162    procedure test_listing_another_owner_requires_list_all is
163      l_raised boolean := false;
164      l_res    json;
165    begin
166      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
167      begin
168        l_res := demo_todo_api.get_todos(json('{"owner":' || principal_of('OTHER') || '}'));
169      exception
170        when others then
171          l_raised := true;
172          if sqlcode != road_ctx_pkg.c_forbidden then
173            fail('expected forbidden, got ' || sqlcode || ': ' || sqlerrm);
174          end if;
175      end;
176      if not l_raised then fail('listing another owner must require todo.list_all'); end if;
177    end test_listing_another_owner_requires_list_all;
178  
179    ---------------------------------------------------------------------------
180    -- Ownership is taken from the session, never the body
181    ---------------------------------------------------------------------------
182  
183    procedure test_owner_ignores_request_body is
184      l_raised boolean := false;
185      l_res    json;
186    begin
187      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
188      begin
189        l_res := demo_todo_api.create_todo(
190                   json('{"title":"forged","owner_principal_id":' || principal_of('OTHER') || '}'));
191      exception
192        when others then
193          l_raised := true;
194          if sqlcode != demo_todo_api.c_validation then
195            fail('expected validation, got ' || sqlcode || ': ' || sqlerrm);
196          end if;
197      end;
198      if not l_raised then
199        fail('supplying owner_principal_id must be refused, not silently ignored');
200      end if;
201    end test_owner_ignores_request_body;
202  
203    procedure test_create_takes_owner_from_session is
204      l_res json;
205    begin
206      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
207      l_res := demo_todo_api.create_todo(json('{"title":"mine"}'));
208      assert_eq('owner is the caller', to_char(principal_of('OWNER')),
209                json_value(l_res, '$.owner_principal_id'));
210      assert_eq('starts OPEN', 'OPEN', json_value(l_res, '$.status'));
211    end test_create_takes_owner_from_session;
212  
213    ---------------------------------------------------------------------------
214    -- Concurrency (spec-patch-08 section 6.2)
215    ---------------------------------------------------------------------------
216  
217    -- THE concurrency test. A second writer moved the row after this caller read it; the update
218    -- must be refused, not silently applied over the top.
219    procedure test_stale_read_token_conflicts is
220      l_id     number;
221      l_token  varchar2(100);
222      l_read   json;
223      l_raised boolean := false;
224      l_res    json;
225    begin
226      l_id := seed_todo('OWNER', 'contended');
227      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
228  
229      l_read  := demo_todo_api.get_todo(json('{"todo_id":' || l_id || '}'));
230      l_token := json_value(l_read, '$.read_token');
231  
232      -- Somebody else moves it. The trigger advances updated_at past the token's issued_at.
233      update demo_todos set title = 'moved by someone else' where todo_id = l_id;
234  
235      begin
236        l_res := demo_todo_api.update_todo(
237                   json('{"todo_id":' || l_id || ',"read_token":"' || l_token || '","title":"mine"}'));
238      exception
239        when others then
240          l_raised := true;
241          if sqlcode != demo_todo_api.c_conflict then
242            fail('expected CONFLICT, got ' || sqlcode || ': ' || sqlerrm);
243          end if;
244      end;
245      if not l_raised then fail('a stale read_token must be refused'); end if;
246  
247      declare
248        l_title varchar2(200 char);
249      begin
250        select title into l_title from demo_todos where todo_id = l_id;
251        assert_eq('the losing write did not land', 'moved by someone else', l_title);
252      end;
253    end test_stale_read_token_conflicts;
254  
255    procedure test_fresh_read_token_updates is
256      l_id    number;
257      l_token varchar2(100);
258      l_read  json;
259      l_res   json;
260    begin
261      l_id := seed_todo('OWNER', 'before');
262      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
263  
264      l_read  := demo_todo_api.get_todo(json('{"todo_id":' || l_id || '}'));
265      l_token := json_value(l_read, '$.read_token');
266  
267      l_res := demo_todo_api.update_todo(
268                 json('{"todo_id":' || l_id || ',"read_token":"' || l_token || '","title":"after"}'));
269      assert_eq('title updated', 'after', json_value(l_res, '$.title'));
270    end test_fresh_read_token_updates;
271  
272    procedure test_update_requires_read_token is
273      l_id     number;
274      l_raised boolean := false;
275      l_res    json;
276    begin
277      l_id := seed_todo('OWNER', 'no token');
278      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
279      begin
280        l_res := demo_todo_api.update_todo(json('{"todo_id":' || l_id || ',"title":"x"}'));
281      exception
282        when others then
283          l_raised := true;
284          if sqlcode != demo_todo_api.c_validation then
285            fail('expected validation, got ' || sqlcode || ': ' || sqlerrm);
286          end if;
287      end;
288      if not l_raised then fail('update without a read_token must be refused'); end if;
289    end test_update_requires_read_token;
290  
291    ---------------------------------------------------------------------------
292    -- Status transitions
293    ---------------------------------------------------------------------------
294  
295    -- DELETED is not reachable through update. "I finished it" and "I want it gone" are different
296    -- intentions and the audit trail should keep them apart.
297    procedure test_update_cannot_set_deleted is
298      l_id     number;
299      l_token  varchar2(100);
300      l_raised boolean := false;
301      l_res    json;
302    begin
303      l_id := seed_todo('OWNER', 'not via update');
304      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
305      l_token := json_value(demo_todo_api.get_todo(json('{"todo_id":' || l_id || '}')), '$.read_token');
306  
307      begin
308        l_res := demo_todo_api.update_todo(
309                   json('{"todo_id":' || l_id || ',"read_token":"' || l_token
310                        || '","status":"DELETED"}'));
311      exception
312        when others then
313          l_raised := true;
314          if sqlcode != demo_todo_api.c_validation then
315            fail('expected validation, got ' || sqlcode || ': ' || sqlerrm);
316          end if;
317      end;
318      if not l_raised then fail('update must not set DELETED'); end if;
319    end test_update_cannot_set_deleted;
