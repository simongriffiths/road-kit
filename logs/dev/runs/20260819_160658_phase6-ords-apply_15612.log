SQL> @db/package_bodies/demo_todo_api.pkb
SQL> create or replace package body demo_todo_api as
  2  
  3    c_app_schema constant varchar2(30) := 'ROAD_KIT_DEMO';
  4  
  5    c_default_limit constant number := 25;
  6    c_max_limit     constant number := 100;
  7  
  8    -- A search term is user input reaching a LIKE pattern, so its wildcards have to be neutralised
  9    -- or a user typing '%' silently matches everything. Escape the escape character first, or
 10    -- escaping the wildcards re-introduces it. Lifted verbatim from road_admin_api.like_term -- the
 11    -- demo copies the framework's idioms rather than inventing its own.
 12    function like_term(p_term in varchar2) return varchar2 is
 13    begin
 14      return '%' || replace(replace(replace(lower(p_term), '\', '\\'), '%', '\%'), '_', '\_') || '%';
 15    end like_term;
 16  
 17    function parse_ts(p_text in varchar2, p_field in varchar2) return timestamp with time zone is
 18    begin
 19      if p_text is null then
 20        return null;
 21      end if;
 22      return to_timestamp_tz(p_text, 'YYYY-MM-DD"T"HH24:MI:SS.FFTZH:TZM');
 23    exception
 24      when others then
 25        raise_application_error(c_validation, p_field || ' must be ISO 8601 with a UTC offset');
 26    end parse_ts;
 27  
 28    -- The canonical todo object (spec-patch-08 section 6).
 29    --
 30    -- owner_principal_id is returned; owner email and display_name are not. The id is an opaque
 31    -- internal number, and an administrator who needs to put a name to it can resolve it through
 32    -- /admin/principals/, which they already hold road.role.grant for. Duplicating principal PII
 33    -- into a second endpoint widens the audience for it and gains nothing.
 34    function build_todo_json(p_todo_id in number) return json is
 35      l_result json;
 36    begin
 37      select json_object(
 38               'todo_id'            value t.todo_id,
 39               'owner_principal_id' value t.owner_principal_id,
 40               'title'              value t.title,
 41               'notes'              value t.notes,
 42               'due_at'             value t.due_at,
 43               'status'             value t.status,
 44               'created_at'         value t.created_at,
 45               'updated_at'         value t.updated_at
 46               returning json
 47             )
 48        into l_result
 49        from demo_todos t
 50       where t.todo_id = p_todo_id;
 51  
 52      return l_result;
 53    end build_todo_json;
 54  
 55    -- Resolves a todo the caller is entitled to see, or raises NOT_FOUND.
 56    --
 57    -- 404 rather than 403 for another owner's row, DELIBERATELY, and it is the one place the demo
 58    -- departs from the framework's own 403-on-refusal contract (spec-patch-08 section 6.1, decided
 59    -- 2026-08-19). There, the PERMISSION is missing and saying so is useful. Here the permission is
 60    -- held and the ROW is out of scope -- a 403 would confirm the row exists, which the caller has
 61    -- not earned. Same reason a login form should not say "no such user".
 62    function owned_todo_id(p_todo_id in number) return number is
 63      l_owner number;
 64    begin
 65      if p_todo_id is null then
 66        raise_application_error(c_validation, 'todo_id is required');
 67      end if;
 68  
 69      begin
 70        select owner_principal_id into l_owner from demo_todos where todo_id = p_todo_id;
 71      exception
 72        when no_data_found then
 73          raise_application_error(c_not_found, 'Todo ' || p_todo_id || ' not found');
 74      end;
 75  
 76      if l_owner != road_ctx_pkg.principal_id
 77         and not road_ctx_pkg.has_permission('todo.list_all') then
 78        raise_application_error(c_not_found, 'Todo ' || p_todo_id || ' not found');
 79      end if;
 80  
 81      return p_todo_id;
 82    end owned_todo_id;
 83  
 84    -- Shared by update_todo and delete_todo. Both mutate a row the caller read, so both must prove
 85    -- the read is still current (spec-patch-08 section 6.2).
 86    procedure require_fresh(p_todo_id in number, p_request in json) is
 87      l_token_txt varchar2(100);
 88      l_token     raw(16);
 89      l_updated   timestamp with time zone;
 90    begin
 91      l_token_txt := json_value(p_request, '$.read_token');
 92      if l_token_txt is null then
 93        raise_application_error(c_validation, 'read_token is required');
 94      end if;
 95  
 96      begin
 97        l_token := hextoraw(l_token_txt);
 98      exception
 99        when others then
100          raise_application_error(c_validation, 'read_token is not a valid token');
101      end;
102  
103      select updated_at into l_updated from demo_todos where todo_id = p_todo_id;
104  
105      if not road_audit_api.check_fresh(
106           p_guid               => l_token,
107           p_app_schema         => c_app_schema,
108           p_entity_type        => 'DEMO_TODOS',
109           p_entity_id          => to_char(p_todo_id),
110           p_current_updated_at => l_updated
111         )
112      then
113        raise_application_error(c_conflict, c_conflict_message);
114      end if;
115    end require_fresh;
116  
117    function get_todos(p_request in json default null) return json is
118      l_offset      number;
119      l_limit       number;
120      l_status      varchar2(10 char);
121      l_q           varchar2(200 char);
122      l_owner       number;
123      l_caller_type varchar2(30);
124      l_caller_ref  varchar2(200);
125      l_read_token  raw(16);
126      l_pattern     varchar2(400 char);
127      l_items       json;
128      l_fetched     number;
129    begin
130      road_ctx_pkg.require_permission('todo.list');
131  
132      select nvl(json_value(p_request, '$.offset' returning number), 0),
133             nvl(json_value(p_request, '$.limit'  returning number), c_default_limit),
134             upper(json_value(p_request, '$.status')),
135             json_value(p_request, '$.q'),
136             json_value(p_request, '$.owner' returning number),
137             nvl(json_value(p_request, '$.caller_type'), 'BROWSER'),
138             json_value(p_request, '$.caller_ref')
139        into l_offset, l_limit, l_status, l_q, l_owner, l_caller_type, l_caller_ref
140        from dual;
141  
142      if l_offset < 0 then
143        raise_application_error(c_validation, 'offset must not be negative');
144      end if;
145      l_limit := least(greatest(l_limit, 1), c_max_limit);
146  
147      if l_status is not null and l_status not in ('OPEN', 'DONE', 'DELETED') then
148        raise_application_error(c_validation, 'status must be one of OPEN, DONE, DELETED');
149      end if;
150  
151      -- THE authorisation case this demo exists to show. Reading your own rows needs todo.list;
152      -- reading anyone else's needs todo.list_all as well. Note the check is on the VALUE, not on
153      -- whether the parameter was supplied -- passing your own id explicitly is not an escalation
154      -- and must not be treated as one.
155      l_owner := nvl(l_owner, road_ctx_pkg.principal_id);
156      if l_owner != road_ctx_pkg.principal_id then
157        road_ctx_pkg.require_permission('todo.list_all');
158      end if;
159  
160      if l_q is not null and length(trim(l_q)) > 0 then
161        l_pattern := like_term(trim(l_q));
162      end if;
163  
164      -- One pass, lifted from road_admin_api.get_principals: row_number over the filtered set lets
165      -- the page and the "is there another page" answer come from the same predicate. Two statements
166      -- would mean two copies of the WHERE clause, which is exactly the pair that drifts. limit+1
167      -- rows are counted and the extra is dropped by the CASE (json_arrayagg is ABSENT ON NULL by
168      -- default), so hasMore costs no second scan.
169      --
170      -- like_term is called ABOVE, not inside the query: a private packaged function may not be used
171      -- in a SQL statement (PLS-00231). Same for parse_ts in the writers below.
172      select nvl(json_arrayagg(
173               case when rn <= l_limit then
174                 json_object(
175                   'todo_id'            value todo_id,
176                   'owner_principal_id' value owner_principal_id,
177                   'title'              value title,
178                   'notes'              value notes,
179                   'due_at'             value to_char(due_at, 'YYYY-MM-DD"T"HH24:MI:SSTZH:TZM'),
180                   'status'             value status,
181                   'created_at'         value to_char(created_at, 'YYYY-MM-DD"T"HH24:MI:SSTZH:TZM'),
182                   'updated_at'         value to_char(updated_at, 'YYYY-MM-DD"T"HH24:MI:SSTZH:TZM')
183                   returning json
184                 )
185               end
186               order by rn returning json
187             ), json('[]')),
188             count(*)
189        into l_items, l_fetched
190        from (
191          select t.todo_id,
192                 t.owner_principal_id,
193                 t.title,
194                 t.notes,
195                 t.due_at,
196                 t.status,
197                 t.created_at,
198                 t.updated_at,
199                 row_number() over (order by t.created_at desc, t.todo_id desc) as rn
200            from demo_todos t
201           where t.owner_principal_id = l_owner
202             and (   (l_status is null and t.status != 'DELETED')
203                  or t.status = l_status)
204             and (l_pattern is null or lower(t.title) like l_pattern escape '\')
205        )
206       where rn > l_offset
207         and rn <= l_offset + l_limit + 1;
208  
209      l_read_token := road_audit_api.issue_read_token(
210        p_caller_type => l_caller_type,
211        p_app_schema  => c_app_schema,
212        p_endpoint    => 'get_todos',
213        p_caller_ref  => l_caller_ref
214      );
215  
216      return json_object(
217               'items'      value l_items,
218               'hasMore'    value case when l_fetched > l_limit then 'true' else 'false' end
219                                  format json,
220               'limit'      value l_limit,
221               'offset'     value l_offset,
222               'count'      value least(l_fetched, l_limit),
223               'read_token' value rawtohex(l_read_token)
224               returning json
225             );
226    end get_todos;
227  
228    function create_todo(p_request in json) return json is
229      l_title   varchar2(200 char);
230      l_notes   varchar2(4000 char);
231      l_due_txt varchar2(100);
232      l_due     timestamp with time zone;
233      l_todo_id number;
234    begin
235      road_ctx_pkg.require_permission('todo.create');
236  
237      -- An attempt to nominate the owner is REFUSED, not ignored. Silently dropping it would tell a
238      -- caller probing for the hole that their forgery was accepted.
239      if json_exists(p_request, '$.owner_principal_id') then
240        raise_application_error(c_validation,
241          'owner_principal_id is taken from the session and must not be supplied');
242      end if;
243  
244      select json_value(p_request, '$.title'),
245             json_value(p_request, '$.notes'),
246             json_value(p_request, '$.due_at')
247        into l_title, l_notes, l_due_txt
248        from dual;
249  
250      if l_title is null then
251        raise_application_error(c_validation, 'title is required');
252      end if;
253  
254      l_due := parse_ts(l_due_txt, 'due_at');
255  
256      insert into demo_todos (owner_principal_id, title, notes, due_at)
257      values (road_ctx_pkg.principal_id, l_title, l_notes, l_due)
258      returning todo_id into l_todo_id;
259  
260      return build_todo_json(l_todo_id);
261    end create_todo;
262  
263    function get_todo(p_request in json) return json is
264      l_todo_id     number;
265      l_caller_type varchar2(30);
266      l_caller_ref  varchar2(200);
267      l_read_token  raw(16);
268    begin
269      road_ctx_pkg.require_permission('todo.get');
270  
271      select json_value(p_request, '$.todo_id' returning number),
272             nvl(json_value(p_request, '$.caller_type'), 'BROWSER'),
273             json_value(p_request, '$.caller_ref')
274        into l_todo_id, l_caller_type, l_caller_ref
275        from dual;
276  
277      l_todo_id := owned_todo_id(l_todo_id);
278  
279      l_read_token := road_audit_api.issue_read_token(
280        p_caller_type => l_caller_type,
281        p_app_schema  => c_app_schema,
282        p_endpoint    => 'get_todo',
283        p_caller_ref  => l_caller_ref
284      );
285  
286      return json_object(
287               'todo'       value build_todo_json(l_todo_id),
288               'read_token' value rawtohex(l_read_token)
289               returning json
290             );
291    end get_todo;
292  
293    function update_todo(p_request in json) return json is
294      l_todo_id   number;
295      l_status    varchar2(10 char);
296      l_has_due   boolean;
297      l_due       timestamp with time zone;
298    begin
299      road_ctx_pkg.require_permission('todo.update');
300  
301      l_todo_id := owned_todo_id(json_value(p_request, '$.todo_id' returning number));
302      require_fresh(l_todo_id, p_request);
303  
304      l_status := upper(json_value(p_request, '$.status'));
305  
306      -- DELETED is deliberately not reachable here. "I finished it" and "I want it gone" are
307      -- different intentions and the audit trail should keep them apart.
308      if l_status is not null and l_status not in ('OPEN', 'DONE') then
309        raise_application_error(c_validation,
310          'status must be OPEN or DONE - use DELETE /todos/{todo_id}/ to remove a todo');
311      end if;
312  
313      l_has_due := json_exists(p_request, '$.due_at');
314      if l_has_due then
315        l_due := parse_ts(json_value(p_request, '$.due_at'), 'due_at');
316      end if;
317  
318      update demo_todos
319         set title  = case when json_exists(p_request, '$.title')
320                           then json_value(p_request, '$.title') else title end,
321             notes  = case when json_exists(p_request, '$.notes')
322                           then json_value(p_request, '$.notes') else notes end,
323             due_at = case when l_has_due then l_due else due_at end,
324             status = nvl(l_status, status)
325       where todo_id = l_todo_id;
326  
327      return build_todo_json(l_todo_id);
328    end update_todo;
329  
330    function delete_todo(p_request in json) return json is
331      l_todo_id number;
332      l_status  varchar2(10 char);
333    begin
334      road_ctx_pkg.require_permission('todo.delete');
335  
336      l_todo_id := owned_todo_id(json_value(p_request, '$.todo_id' returning number));
337      require_fresh(l_todo_id, p_request);
338  
339      select status into l_status from demo_todos where todo_id = l_todo_id;
340  
341      if l_status = 'DELETED' then
342        -- Idempotent, not an error: same shape as grant_role and attach_permission.
343        return json_object('todo_id' value l_todo_id, 'deleted' value 'false' format json
344                           returning json);
345      end if;
346  
347      update demo_todos set status = 'DELETED' where todo_id = l_todo_id;
348  
349      return json_object('todo_id' value l_todo_id, 'deleted' value 'true' format json
350                         returning json);
351    end delete_todo;
352  
353    function purge(p_request in json) return json is
354      l_before_txt varchar2(100);
355      l_before     timestamp with time zone;
356      l_purged     number;
357    begin
358      -- todo.purge is RESERVED. Nothing here reads that flag -- the reservation governs who may
359      -- attach the permission to a role, not what the handler does once someone holds it. The
360      -- guard is road_reserved_composition, in the database, one layer down.
361      road_ctx_pkg.require_permission('todo.purge');
362  
363      l_before_txt := json_value(p_request, '$.before');
364      if l_before_txt is null then
365        raise_application_error(c_validation, 'before is required');
366      end if;
367      l_before := parse_ts(l_before_txt, 'before');
368  
369      -- Across ALL owners, and no ownership filter anywhere: that is what makes this the dangerous
370      -- operation worth reserving.
371      delete from demo_todos
372       where status in ('DONE', 'DELETED')
373         and updated_at < l_before;
374      l_purged := sql%rowcount;
375  
376      road_audit_api.log_admin_action(
377        p_endpoint    => 'purge',
378        p_entity_type => 'DEMO_TODOS',
379        p_entity_id   => to_char(l_purged),
380        p_outcome     => 'OK'
381      );
382  
383      return json_object('purged' value l_purged returning json);
384    end purge;
385  
386  end demo_todo_api;
387  /

