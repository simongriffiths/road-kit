368    -- Purge -- the reserved permission's subject
369    ---------------------------------------------------------------------------
370  
371    procedure test_purge_denied_without_permission is
372      l_raised boolean := false;
373      l_res    json;
374    begin
375      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
376      begin
377        l_res := demo_todo_api.purge(json('{"before":"2999-01-01T00:00:00.000+00:00"}'));
378      exception
379        when others then
380          l_raised := true;
381          if sqlcode != road_ctx_pkg.c_forbidden then
382            fail('expected forbidden, got ' || sqlcode || ': ' || sqlerrm);
383          end if;
384      end;
385      if not l_raised then fail('purge must require todo.purge'); end if;
386    end test_purge_denied_without_permission;
387  
388    -- Purge reaches ACROSS OWNERS and only takes finished rows. Both halves matter: the cross-owner
389    -- reach is what makes it dangerous enough to reserve, and sparing OPEN rows is what stops it
390    -- being a table truncate with extra steps.
391    procedure test_purge_crosses_owners_and_spares_open is
392      l_open   number;
393      l_done_a number;
394      l_done_b number;
395      l_res    json;
396      l_count  number;
397    begin
398      l_open   := seed_todo('OWNER', 'still open', 'OPEN');
399      l_done_a := seed_todo('OWNER', 'finished a', 'DONE');
400      l_done_b := seed_todo('OTHER', 'finished b', 'DONE');
401  
402      if not road_ctx_pkg.begin_request('ADMIN', c_issuer) then fail('establish'); end if;
403      l_res := demo_todo_api.purge(json('{"before":"2999-01-01T00:00:00.000+00:00"}'));
404  
405      select count(*) into l_count from demo_todos where todo_id in (l_done_a, l_done_b);
406      assert_eq('both owners'' finished todos purged', '0', to_char(l_count));
407  
408      select count(*) into l_count from demo_todos where todo_id = l_open;
409      assert_eq('an OPEN todo is untouched', '1', to_char(l_count));
410    end test_purge_crosses_owners_and_spares_open;
