215          -- todo_id from the path, everything else from the body. A body that also carries todo_id
216          -- is ignored in favour of the path -- the URL is what the caller addressed.
217          select json_transform(
218                   json(:body_text),
219                   set '$.todo_id' = to_number(:todo_id default null on conversion error)
220                 )
221            into l_request from dual;
