321    procedure test_delete_is_soft_and_idempotent is
322      l_id    number;
323      l_token varchar2(100);
324      l_res   json;
325      l_count number;
326    begin
327      l_id := seed_todo('OWNER', 'soft delete me');
328      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
329  
330      l_token := json_value(demo_todo_api.get_todo(json('{"todo_id":' || l_id || '}')), '$.read_token');
331      l_res := demo_todo_api.delete_todo(
332                 json('{"todo_id":' || l_id || ',"read_token":"' || l_token || '"}'));
333      assert_eq('first delete reports true', 'true', json_value(l_res, '$.deleted'));
334  
335      select count(*) into l_count from demo_todos where todo_id = l_id and status = 'DELETED';
336      assert_eq('row survives as DELETED', '1', to_char(l_count));
337  
338      l_token := json_value(demo_todo_api.get_todo(json('{"todo_id":' || l_id || '}')), '$.read_token');
339      l_res := demo_todo_api.delete_todo(
340                 json('{"todo_id":' || l_id || ',"read_token":"' || l_token || '"}'));
341      assert_eq('second delete reports false, not an error', 'false', json_value(l_res, '$.deleted'));
342    end test_delete_is_soft_and_idempotent;
