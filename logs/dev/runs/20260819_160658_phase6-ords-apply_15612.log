414    procedure run_all is
415      procedure exec(p_name in varchar2) is
416      begin
417        savepoint sp_demo;
418        case p_name
419          when 'other_owner_not_found'   then test_other_owners_todo_is_not_found;
420          when 'list_all_not_list'       then test_list_all_does_not_imply_list;
421          when 'own_owner_ok'            then test_own_owner_param_is_not_escalation;
422          when 'other_owner_needs_all'   then test_listing_another_owner_requires_list_all;
423          when 'owner_from_session'      then test_create_takes_owner_from_session;
424          when 'owner_body_refused'      then test_owner_ignores_request_body;
425          when 'stale_token_conflicts'   then test_stale_read_token_conflicts;
426          when 'fresh_token_updates'     then test_fresh_read_token_updates;
427          when 'update_needs_token'      then test_update_requires_read_token;
428          when 'update_not_deleted'      then test_update_cannot_set_deleted;
429          when 'delete_soft_idempotent'  then test_delete_is_soft_and_idempotent;
430          when 'deleted_hidden'          then test_deleted_excluded_from_default_list;
431          when 'purge_needs_permission'  then test_purge_denied_without_permission;
432          when 'purge_cross_owner'       then test_purge_crosses_owners_and_spares_open;
433          else fail('unknown test ' || p_name);
434        end case;
435        dbms_output.put_line('PASS ' || p_name);
436        l_pass := l_pass + 1;
437        rollback to sp_demo;
438        road_ctx_pkg.end_request;
439      exception
440        when others then
441          dbms_output.put_line('FAIL ' || p_name || ': ' || sqlerrm);
442          l_fail := l_fail + 1;
443          rollback to sp_demo;
444          road_ctx_pkg.end_request;
445      end exec;
446    begin
447      l_pass := 0;
448      l_fail := 0;
449      setup;
450  
451      exec('other_owner_not_found');
452      exec('list_all_not_list');
453      exec('own_owner_ok');
454      exec('other_owner_needs_all');
455      exec('owner_from_session');
456      exec('owner_body_refused');
457      exec('stale_token_conflicts');
458      exec('fresh_token_updates');
459      exec('update_needs_token');
460      exec('update_not_deleted');
461      exec('delete_soft_idempotent');
462      exec('deleted_hidden');
463      exec('purge_needs_permission');
464      exec('purge_cross_owner');
465  
466      teardown;
467      dbms_output.put_line('demo_todo_api_test: ' || l_pass || ' passed, ' || l_fail || ' failed');
468      if l_fail > 0 then
469        raise_application_error(-20000, l_fail || ' demo_todo_api test(s) failed');
470      end if;
471    exception
472      when others then
473        teardown;
474        raise;
475    end run_all;
476  
477  end demo_todo_api_test;
