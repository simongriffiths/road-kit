 25        declare
 26          l_response       json;
 27          l_status_code    number;
 28          l_error_response clob;
 29        begin
 30          if not road_ctx_pkg.begin_request(:current_user) then
 31            owa_util.status_line(401);
 32            htp.p('{"error":"UNAUTHORIZED","message":"No session could be established"}');
 33            return;
 34          end if;
 35          l_response := road_admin_api.get_roles;
