SQL> @db/tables/road_roles.create.sql
SQL> -- A flat set of roles. No hierarchy and no inheritance, by decision: effective permissions are the
SQL> -- union across a principal's roles, and senior_clerk is granted the same permissions as clerk
SQL> -- rather than inheriting them (spec-patch-06 rule 2). Inheritance is where RBAC models become
SQL> -- unauditable.
SQL> --
SQL> -- is_reserved marks the road.* roles that gate the framework's own administration surface. An
SQL> -- application may rename, redefine or delete an unreserved role; road-kit finds its provisioning
SQL> -- default through road_config.default_principal_role rather than by hardcoding the name.
SQL> --
SQL> -- display_name is data, not code (section 4.4) -- it is what lets an application render "clerk" as
SQL> -- Clerk or Clerc without either string appearing in a handler.
SQL> create table road_roles (
  2    role_name    varchar2(64 char) primary key,
  3    display_name varchar2(255 char),
  4    description  varchar2(4000 char),
  5    is_reserved  varchar2(1 char) default 'N' not null,
  6    constraint road_roles_reserved_ck check (is_reserved in ('Y','N'))
  7  );

Table ROAD_ROLES created.

