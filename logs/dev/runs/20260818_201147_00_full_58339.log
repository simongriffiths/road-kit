 59  
 60    -- spec-patch-06 section 6.4: an authenticated principal denied by require_permission must map to
 61    -- 403, not 401 and not 500. Raised through road_ctx_pkg.c_forbidden in real use.
 62    procedure test_handle_known_forbidden is
 63      l_status   number;
 64      l_response clob;
 65    begin
 66      begin
 67        raise_application_error(-20403, 'Permission required: events.purge');
 68      exception
 69        when others then
 70          error_api.handle_known(sqlcode, sqlerrm, l_status, l_response);
 71      end;
 72      assert_eq('status', '403', to_char(l_status));
 73      assert_eq('error', 'FORBIDDEN', json_value(l_response, '$.error'));
 74      assert_eq('message', 'Permission required: events.purge', json_value(l_response, '$.message'));
 75      assert_eq('ora_code', 'ORA-20403', json_value(l_response, '$.ora_code'));
 76    end test_handle_known_forbidden;
 77  
 78    procedure test_handle_known_conflict is
 79      l_status   number;
 80      l_response clob;
 81    begin
 82      begin
 83        raise_application_error(-20009, 'stale read_token');
 84      exception
 85        when others then
 86          error_api.handle_known(sqlcode, sqlerrm, l_status, l_response);
 87      end;
 88      assert_eq('status', '409', to_char(l_status));
 89      assert_eq('error', 'CONFLICT', json_value(l_response, '$.error'));
 90    end test_handle_known_conflict;
 91  
 92    procedure test_handle_known_unmapped_escalates is
 93      l_status     number;
 94      l_response   clob;
 95      l_log_count  number;
 96    begin
 97      begin
 98        raise_application_error(-20050, 'not a real mapped code');
 99      exception
100        when others then
101          error_api.handle_known(sqlcode, sqlerrm, l_status, l_response);
102      end;
103      assert_eq('status', '500', to_char(l_status));
104      assert_eq('error', 'INTERNAL_ERROR', json_value(l_response, '$.error'));
105      assert_eq('message', 'An unexpected error occurred', json_value(l_response, '$.message'));
106  
107      select count(*) into l_log_count
108        from error_log
109       where sqlcode = -20050;
110      if l_log_count = 0 then
111        raise_application_error(-20000, 'expected an error_log row for the unmapped code');
112      end if;
113  
114      -- write_error_log commits autonomously; the outer SAVEPOINT/ROLLBACK in run_all cannot
115      -- undo it, so clean up explicitly (per calendar-build-instructions.md's standing rule).
116      delete from error_log where sqlcode = -20050;
117      commit;
118    end test_handle_known_unmapped_escalates;
119  
120    procedure test_handle_unknown is
121      l_status    number;
122      l_response  clob;
123      l_log_count number;
124    begin
125      error_api.handle_unknown(
126        p_sqlerrm     => 'ORA-00001: unique constraint violated',
127        p_backtrace   => 'fake backtrace for test',
128        p_context     => 'error_api_test.test_handle_unknown',
129        p_status_code => l_status,
130        p_response    => l_response
131      );
132      assert_eq('status', '500', to_char(l_status));
133      assert_eq('error', 'INTERNAL_ERROR', json_value(l_response, '$.error'));
134      assert_eq('message', 'An unexpected error occurred', json_value(l_response, '$.message'));
135  
136      select count(*) into l_log_count
137        from error_log
138       where context = 'error_api_test.test_handle_unknown';
139      if l_log_count = 0 then
140        raise_application_error(-20000, 'expected an error_log row from handle_unknown');
141      end if;
142  
143      delete from error_log where context = 'error_api_test.test_handle_unknown';
144      commit;
145    end test_handle_unknown;
146  
147    procedure run_all is
148      l_pass number := 0;
149      l_fail number := 0;
150  
151      -- Tests that assert on error_log commit their own cleanup DELETE (autonomous rows can't be
152      -- undone by ROLLBACK TO SAVEPOINT), which invalidates any savepoint taken before that
153      -- commit — so ROLLBACK TO SAVEPOINT here may legitimately find nothing to roll back
154      -- (ORA-01086). That's expected, not a failure; only re-raise other errors.
155      procedure rollback_if_possible is
156      begin
157        rollback to savepoint before_test;
158      exception
159        when others then
160          if sqlcode != -1086 then
161            raise;
162          end if;
163      end rollback_if_possible;
164  
165      procedure run(p_name in varchar2, p_proc in varchar2) is
166      begin
167        savepoint before_test;
168        case p_proc
169          when 'validation'         then test_handle_known_validation;
170          when 'agenda_locked'      then test_handle_known_agenda_locked;
171          when 'not_found'          then test_handle_known_not_found;
172          when 'conflict'           then test_handle_known_conflict;
173          when 'forbidden'          then test_handle_known_forbidden;
174          when 'unmapped_escalates' then test_handle_known_unmapped_escalates;
175          when 'handle_unknown'     then test_handle_unknown;
176        end case;
177        rollback_if_possible;
178        dbms_output.put_line('PASS ' || p_name);
179        l_pass := l_pass + 1;
180      exception
181        when others then
182          rollback_if_possible;
183          dbms_output.put_line('FAIL ' || p_name || ': ' || sqlerrm);
184          l_fail := l_fail + 1;
185      end run;
186    begin
187      run('test_handle_known_validation', 'validation');
188      run('test_handle_known_agenda_locked', 'agenda_locked');
189      run('test_handle_known_not_found', 'not_found');
190      run('test_handle_known_conflict', 'conflict');
191      run('test_handle_known_forbidden', 'forbidden');
192      run('test_handle_known_unmapped_escalates', 'unmapped_escalates');
193      run('test_handle_unknown', 'handle_unknown');
194  
195      dbms_output.put_line('error_api_test: ' || l_pass || ' passed, ' || l_fail || ' failed');
196    end run_all;
197  
198  end error_api_test;
199  /

