SQL> create or replace package body road_admin_api as
  2  
  3    c_err_validation constant number := -20001;
  4    c_err_not_found  constant number := -20004;
  5  
  6    procedure assert_role_exists(p_role_name in varchar2) is
  7      l_count number;
  8    begin
  9      select count(*) into l_count from road_roles where role_name = p_role_name;
 10      if l_count = 0 then
 11        raise_application_error(c_err_not_found, 'Role not found: ' || p_role_name);
 12      end if;
 13    end assert_role_exists;
 14  
 15    procedure assert_principal_exists(p_principal_id in number) is
 16      l_count number;
 17    begin
 18      select count(*) into l_count from road_principals where principal_id = p_principal_id;
 19      if l_count = 0 then
 20        raise_application_error(c_err_not_found, 'Principal not found: ' || p_principal_id);
 21      end if;
 22    end assert_principal_exists;
 23  
 24    function is_reserved(p_role_name in varchar2) return boolean is
 25      l_reserved road_roles.is_reserved%type;
 26    begin
 27      select is_reserved into l_reserved from road_roles where role_name = p_role_name;
 28      return l_reserved = 'Y';
 29    exception
 30      when no_data_found then
 31        return false;
 32    end is_reserved;
 33  
 34    -- The two-tier split made explicit. road.role.grant lets a user_admin manage ordinary roles;
 35    -- touching a RESERVED role additionally needs road.role.define, which only road.system_admin
 36    -- holds. Nothing in the table structure prevents a user_admin granting road.system_admin --
 37    -- foreign keys do not know what the rows mean -- so it has to be a check, and a tested one.
 38    procedure assert_may_manage(p_role_name in varchar2) is
 39    begin
 40      if is_reserved(p_role_name) then
 41        road_ctx_pkg.require_permission('road.role.define');
 42      end if;
 43    end assert_may_manage;
 44  
 45    function get_principal_roles(p_request in json) return json is
 46      l_principal_id number;
 47      l_result       json;
 48    begin
 49      road_ctx_pkg.require_permission('road.role.grant');
 50  
 51      l_principal_id := json_value(p_request, '$.principal_id' returning number);
 52      if l_principal_id is null then
 53        raise_application_error(c_err_validation, 'principal_id is required');
 54      end if;
 55      assert_principal_exists(l_principal_id);
 56  
 57      select json_object(
 58               'principal_id' value p.principal_id,
 59               'subject'      value p.subject,
 60               'status'       value p.status,
 61               'roles'        value nvl((
 62                 select json_arrayagg(
 63                          json_object(
 64                            'role_name'  value pr.role_name,
 65                            'granted_at' value to_char(pr.granted_at, 'YYYY-MM-DD"T"HH24:MI:SSTZH:TZM'),
 66                            'granted_by' value pr.granted_by
 67                          )
 68                          order by pr.role_name returning json
 69                        )
 70                   from road_principal_roles pr
 71                  where pr.principal_id = p.principal_id
 72               ), json('[]'))
 73               returning json
 74             )
 75        into l_result
 76        from road_principals p
 77       where p.principal_id = l_principal_id;
 78  
 79      return l_result;
 80    end get_principal_roles;
 81  
 82    function grant_role(p_request in json) return json is
 83      l_principal_id number;
 84      l_role_name    varchar2(64 char);
 85      l_granted_by   number;
 86      l_existing     number;
 87      l_granted      boolean := false;
 88    begin
 89      road_ctx_pkg.require_permission('road.role.grant');
 90  
 91      l_principal_id := json_value(p_request, '$.principal_id' returning number);
 92      l_role_name    := json_value(p_request, '$.role_name' returning varchar2(64));
 93  
 94      if l_principal_id is null or l_role_name is null then
 95        raise_application_error(c_err_validation, 'principal_id and role_name are required');
 96      end if;
 97  
 98      assert_principal_exists(l_principal_id);
 99      assert_role_exists(l_role_name);
100      assert_may_manage(l_role_name);
101  
102      -- Never from the request body. A caller who could nominate granted_by could forge the audit
103      -- trail of who authorised a privilege escalation, which is the one field that would expose it.
104      l_granted_by := road_ctx_pkg.principal_id;
105  
106      select count(*)
107        into l_existing
108        from road_principal_roles
109       where principal_id = l_principal_id
110         and role_name = l_role_name;
111  
112      if l_existing = 0 then
113        insert into road_principal_roles (principal_id, role_name, granted_by)
114        values (l_principal_id, l_role_name, l_granted_by);
115        l_granted := true;
116      end if;
117  
118      return json_object(
119               'principal_id' value l_principal_id,
120               'role_name'    value l_role_name,
121               'granted'      value l_granted,
122               'granted_by'   value l_granted_by
123               returning json
124             );
125    end grant_role;
126  
127    function revoke_role(p_request in json) return json is
128      l_principal_id number;
129      l_role_name    varchar2(64 char);
130      l_holders      number;
131      l_revoked      boolean := false;
132    begin
133      road_ctx_pkg.require_permission('road.role.revoke');
134  
135      l_principal_id := json_value(p_request, '$.principal_id' returning number);
136      l_role_name    := json_value(p_request, '$.role_name' returning varchar2(64));
137  
138      if l_principal_id is null or l_role_name is null then
139        raise_application_error(c_err_validation, 'principal_id and role_name are required');
140      end if;
141  
142      assert_principal_exists(l_principal_id);
143      assert_role_exists(l_role_name);
144      assert_may_manage(l_role_name);
145  
146      -- Refuse to remove the last system administrator. "The auth system works and nobody can
147      -- administer it" is the failure mode patch section 10 question 1 exists to prevent, and it is
148      -- reachable by an ordinary revoke as easily as by a bad deploy.
149      if l_role_name = 'road.system_admin' then
150        select count(*)
151          into l_holders
152          from road_principal_roles
153         where role_name = 'road.system_admin';
154  
155        if l_holders <= 1 then
156          raise_application_error(
157            c_err_validation,
158            'Refusing to revoke the last road.system_admin - grant it to another principal first'
159          );
160        end if;
161      end if;
162  
163      delete from road_principal_roles
164       where principal_id = l_principal_id
165         and role_name = l_role_name;
166  
167      l_revoked := sql%rowcount > 0;
168  
169      return json_object(
170               'principal_id' value l_principal_id,
171               'role_name'    value l_role_name,
172               'revoked'      value l_revoked
173               returning json
174             );
175    end revoke_role;
176  
177    function get_roles(p_request in json default null) return json is
178      l_result json;
179    begin
180      road_ctx_pkg.require_permission('road.role.grant');
181  
182      select json_object(
183               'roles' value nvl((
184                 select json_arrayagg(
185                          json_object(
186                            'role_name'    value r.role_name,
187                            'display_name' value r.display_name,
188                            'description'  value r.description,
189                            'is_reserved'  value r.is_reserved,
190                            'permissions'  value nvl((
191                              select json_arrayagg(rp.permission_name
192                                                   order by rp.permission_name returning json)
193                                from road_role_permissions rp
194                               where rp.role_name = r.role_name
195                            ), json('[]'))
196                          )
197                          order by r.role_name returning json
198                        )
199                   from road_roles r
200               ), json('[]'))
201               returning json
202             )
203        into l_result
204        from dual;
205  
206      return l_result;
207    end get_roles;
208  
209    function define_role(p_request in json) return json is
210      l_role_name    varchar2(64 char);
211      l_display_name varchar2(255 char);
212      l_description  varchar2(4000 char);
213      l_existing     number;
214    begin
215      road_ctx_pkg.require_permission('road.role.define');
216  
217      l_role_name    := json_value(p_request, '$.role_name' returning varchar2(64));
218      l_display_name := json_value(p_request, '$.display_name' returning varchar2(255));
219      l_description  := json_value(p_request, '$.description' returning varchar2(4000));
220  
221      if l_role_name is null then
222        raise_application_error(c_err_validation, 'role_name is required');
223      end if;
224  
225      -- road. is the framework's reserved namespace (rule 5). An application defining a road.* role
226      -- would be claiming framework authority for an application concern, and the reserved flag would
227      -- then mean two different things.
228      if lower(l_role_name) like 'road.%' then
229        raise_application_error(
230          c_err_validation,
231          'The road. namespace is reserved for the framework: ' || l_role_name
232        );
233      end if;
234  
235      select count(*) into l_existing from road_roles where role_name = l_role_name;
236      if l_existing > 0 then
237        raise_application_error(c_err_validation, 'Role already exists: ' || l_role_name);
238      end if;
239  
240      insert into road_roles (role_name, display_name, description, is_reserved)
241      values (l_role_name, l_display_name, l_description, 'N');
242  
243      return json_object(
244               'role_name'    value l_role_name,
245               'display_name' value l_display_name,
246               'description'  value l_description,
247               'is_reserved'  value 'N'
248               returning json
249             );
250    end define_role;
251  
252    procedure grant_all_app_permissions(p_role_name in varchar2) is
253    begin
254      assert_role_exists(p_role_name);
255  
256      -- Explicit rows, written once, for the permissions that exist RIGHT NOW. Anything added after
257      -- this runs is not acquired -- that is the point (rule 4), not a limitation.
258      insert into road_role_permissions (role_name, permission_name)
259      select p_role_name, p.permission_name
260        from road_permissions p
261       where p.permission_name not like 'road.%'
262         and not exists (
263               select 1
264                 from road_role_permissions x
265                where x.role_name = p_role_name
266                  and x.permission_name = p.permission_name
267             );
268    end grant_all_app_permissions;
269  
270  end road_admin_api;
271  /

