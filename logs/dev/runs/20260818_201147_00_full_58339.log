  2  
  3    procedure assert_eq(p_label in varchar2, p_expected in varchar2, p_actual in varchar2) is
  4    begin
  5      if p_actual is null and p_expected is null then
  6        return;
  7      end if;
  8      if p_actual is null or p_expected is null or p_actual != p_expected then
  9        raise_application_error(
 10          -20000,
 11          p_label || ': expected [' || p_expected || '] got [' || p_actual || ']'
 12        );
