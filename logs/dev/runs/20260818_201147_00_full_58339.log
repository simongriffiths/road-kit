SQL> create or replace package body road_ctx_pkg as
  2  
  3    c_namespace   constant varchar2(30)  := 'ROAD_CTX';
  4  
  5    -- Fixed attributes.
  6    c_attr_established  constant varchar2(30) := 'ESTABLISHED';
  7    c_attr_principal_id constant varchar2(30) := 'PRINCIPAL_ID';
  8    c_attr_subject      constant varchar2(30) := 'SUBJECT';
  9    c_attr_issuer       constant varchar2(30) := 'ISSUER';
 10  
 11    -- Roles and permissions are stored one attribute each, prefixed to keep them out of the fixed
 12    -- attribute space. Verified on ADB: context attribute names accept up to 128 bytes, so a 64-char
 13    -- role or permission name plus a 5-char prefix fits with room to spare. The alternative -- packing
 14    -- a delimited list into one 4000-byte value -- would have imposed a ceiling on how many
 15    -- permissions a role may compose, and needed parsing on every check.
 16    c_prefix_role constant varchar2(5) := 'ROLE$';
 17    c_prefix_perm constant varchar2(5) := 'PERM$';
 18  
 19    -- SYS_CONTEXT truncates at 256 bytes unless an explicit length is passed. issuer is
 20    -- varchar2(512 char) and subject varchar2(255 char), so the length argument is mandatory here,
 21    -- not defensive: without it a long issuer silently comes back truncated and no principal ever
 22    -- matches. Verified on dev -- a 1000-byte value read back as 256 without it, 1000 with it.
 23    c_len_issuer  constant pls_integer := 512;
 24    c_len_subject constant pls_integer := 255;
 25  
 26    -- Reads the issuer from the schema's own ORDS JWT profile. Correct only while trust is
 27    -- schema-level with a single profile; 99_verify asserts exactly one row for that reason. See
 28    -- planning/spike-06-1-iss-reachability.md section 4 for the constraint and the migration path.
 29    function resolve_issuer return varchar2 is
 30      l_issuer varchar2(512 char);
 31    begin
 32      select issuer into l_issuer from user_ords_jwt_profile;
 33      return l_issuer;
 34    exception
 35      -- Zero profiles or more than one: both are unresolvable, and guessing would be worse than
 36      -- denying. Fail closed.
 37      when others then
 38        return null;
 39    end resolve_issuer;
 40  
 41    function config_value(p_key in varchar2) return varchar2 is
 42      l_value road_config.config_value%type;
 43    begin
 44      select config_value into l_value from road_config where config_key = p_key;
 45      return l_value;
 46    exception
 47      when no_data_found then
 48        return null;
 49    end config_value;
 50  
 51    -- Creates a principal for a subject the issuer has authenticated but this application has never
 52    -- seen, and grants it road_config.default_principal_role.
 53    --
 54    -- Gated on road_config.auto_provision_principals = 'Y'. Off means an unknown subject is denied,
 55    -- which is rule 3's default; on means the issuer is trusted to decide who exists. That is a
 56    -- posture decision per deployment, not a mechanism, which is why it is a row rather than code.
 57    --
 58    -- Returns the principal_id, or null when provisioning is off or fails.
 59    function provision_principal(
 60      p_issuer  in varchar2,
 61      p_subject in varchar2
 62    ) return number is
 63      pragma autonomous_transaction;
 64      l_principal_id number;
 65      l_role         road_config.config_value%type;
 66    begin
 67      if nvl(config_value('auto_provision_principals'), 'N') != 'Y' then
 68        rollback;
 69        return null;
 70      end if;
 71  
 72      l_role := config_value('default_principal_role');
 73  
 74      begin
 75        insert into road_principals (issuer, subject, display_name)
 76        values (p_issuer, p_subject, p_subject)
 77        returning principal_id into l_principal_id;
 78      exception
 79        when dup_val_on_index then
 80          -- Two first requests for the same new subject can race. The unique constraint on
 81          -- (issuer, subject) is what makes that safe: the loser reads the winner's row rather than
 82          -- failing the request, so a genuine user is never denied because they arrived twice at once.
 83          rollback;
 84          select principal_id into l_principal_id
 85            from road_principals
 86           where issuer = p_issuer and subject = p_subject;
 87          return l_principal_id;
 88      end;
 89  
 90      -- No default role configured, or it has been deleted: the principal exists but holds nothing.
 91      -- Fail closed -- an account with no permissions is recoverable by an administrator, whereas
 92      -- silently substituting some other role would not be.
 93      if l_role is not null then
 94        begin
 95          insert into road_principal_roles (principal_id, role_name)
 96          values (l_principal_id, l_role);
 97        exception
 98          when others then
 99            null;
100        end;
101      end if;
102  
103      -- Autonomous so the new principal survives even if the request that triggered it later rolls
104      -- back. Otherwise a failing first request would leave the user unprovisioned and they would hit
105      -- the same path again on every retry.
106      commit;
107      return l_principal_id;
108    exception
109      when others then
110        rollback;
111        return null;
112    end provision_principal;
113  
114    procedure end_request is
115    begin
116      dbms_session.clear_all_context(c_namespace);
117    end end_request;
118  
119    function begin_request(
120      p_subject in varchar2,
121      p_issuer  in varchar2 default null
122    ) return boolean is
123      l_issuer       varchar2(512 char);
124      l_subject      varchar2(255 char);
125      l_principal_id number;
126      l_status       varchar2(20 char);
127    begin
128      -- 1. Clear FIRST, unconditionally, before any validation. ORDS pools connections, so this
129      --    session may still be carrying the previous caller's principal and permissions. Clearing
130      --    up front means every failure path below -- including an exception -- leaves the session
131      --    holding nothing rather than holding somebody else.
132      dbms_session.clear_all_context(c_namespace);
133  
134      l_subject := trim(p_subject);
135      if l_subject is null then
136        return false;
137      end if;
138  
139      l_issuer := nvl(p_issuer, resolve_issuer);
140      if l_issuer is null then
141        return false;
142      end if;
143  
144      begin
145        select principal_id, status
146          into l_principal_id, l_status
147          from road_principals
148         where issuer = l_issuer
149           and subject = l_subject;
150      exception
151        when no_data_found then
152          -- The issuer authenticated them; this application has simply never seen them before.
153          l_principal_id := provision_principal(l_issuer, l_subject);
154          if l_principal_id is null then
155            return false;
156          end if;
157          l_status := 'ACTIVE';
158      end;
159  
160      -- 2. Only ACTIVE principals get a session. SUSPENDED and RETIRED authenticate at ORDS -- their
161      --    token is still valid -- and are denied here.
162      if l_status != 'ACTIVE' then
163        return false;
164      end if;
165  
166      dbms_session.set_context(c_namespace, c_attr_principal_id, to_char(l_principal_id));
167      dbms_session.set_context(c_namespace, c_attr_subject, l_subject);
168      dbms_session.set_context(c_namespace, c_attr_issuer, l_issuer);
169  
170      -- 3. Roles and effective permissions, loaded once. Permissions are the union across the
171      --    principal's roles with no hierarchy (rule 2), so a plain DISTINCT join is the whole rule.
172      for r in (
173        select role_name
174          from road_principal_roles
175         where principal_id = l_principal_id
176      ) loop
177        dbms_session.set_context(c_namespace, c_prefix_role || r.role_name, 'Y');
178      end loop;
179  
180      for p in (
181        select distinct rp.permission_name
182          from road_principal_roles pr
183          join road_role_permissions rp
184            on rp.role_name = pr.role_name
185         where pr.principal_id = l_principal_id
186      ) loop
187        dbms_session.set_context(c_namespace, c_prefix_perm || p.permission_name, 'Y');
188      end loop;
189  
190      -- 4. ESTABLISHED goes last, deliberately. If loading raised part-way through, this is never
191      --    set, so is_authenticated stays false and a half-populated context cannot be mistaken for
192      --    a complete one.
193      dbms_session.set_context(c_namespace, c_attr_established, 'Y');
194  
195      return true;
196    exception
197      when others then
198        -- Any unexpected failure denies and leaves nothing behind. Fail closed, per rule 3.
199        begin
200          dbms_session.clear_all_context(c_namespace);
201        exception
202          when others then
203            null;
204        end;
205        return false;
206    end begin_request;
207  
208    -- NVL is load-bearing, not decoration. SYS_CONTEXT returns NULL for an attribute that was never
209    -- set, and NULL = 'Y' evaluates to NULL rather than FALSE. A NULL returned from here would make
210    -- "if not is_authenticated then return false" fail to fire, and "if not has_permission then
211    -- raise" fail to raise -- so an unheld permission would pass silently. Rule 3 requires false,
212    -- never null. Caught by test_pooled_session_does_not_bleed, which asserted FALSE and got NULL.
213    function is_authenticated return boolean is
214    begin
215      return nvl(sys_context(c_namespace, c_attr_established), 'N') = 'Y';
216    end is_authenticated;
217  
218    function principal_id return number is
219    begin
220      if not is_authenticated then
221        return null;
222      end if;
223      return to_number(sys_context(c_namespace, c_attr_principal_id));
224    end principal_id;
225  
226    function subject return varchar2 is
227    begin
228      if not is_authenticated then
229        return null;
230      end if;
231      return sys_context(c_namespace, c_attr_subject, c_len_subject);
232    end subject;
233  
234    function issuer return varchar2 is
235    begin
236      if not is_authenticated then
237        return null;
238      end if;
239      return sys_context(c_namespace, c_attr_issuer, c_len_issuer);
240    end issuer;
241  
242    function has_role(p_role_name in varchar2) return boolean is
243    begin
244      -- The is_authenticated gate is what makes an unestablished context return false rather than
245      -- null-tolerant nonsense (section 6.3). Never true, never null.
246      if not is_authenticated or p_role_name is null then
247        return false;
248      end if;
249      return nvl(sys_context(c_namespace, c_prefix_role || p_role_name), 'N') = 'Y';
250    end has_role;
251  
252    function has_permission(p_permission_name in varchar2) return boolean is
253    begin
254      if not is_authenticated or p_permission_name is null then
255        return false;
256      end if;
257      return nvl(sys_context(c_namespace, c_prefix_perm || p_permission_name), 'N') = 'Y';
258    end has_permission;
259  
260    procedure require_role(p_role_name in varchar2) is
261    begin
262      if not has_role(p_role_name) then
263        raise_application_error(c_forbidden, 'Role required: ' || p_role_name);
264      end if;
265    end require_role;
266  
267    procedure require_permission(p_permission_name in varchar2) is
268    begin
269      if not has_permission(p_permission_name) then
270        raise_application_error(c_forbidden, 'Permission required: ' || p_permission_name);
271      end if;
272    end require_permission;
273  
274  end road_ctx_pkg;
275  /

Package Body ROAD_CTX_PKG compiled

