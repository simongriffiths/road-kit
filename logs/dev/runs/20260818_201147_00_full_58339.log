  8    );
  9  
 10    ords.define_template(
 11      p_module_name => 'hello_api.ui',
 12      p_pattern     => '/',
 13      p_priority    => 0,
 14      p_etag_type   => 'NONE',
 15      p_comments    => 'Root UI entry point'
 16    );
 17  
 18    ords.define_handler(
 19      p_module_name => 'hello_api.ui',
 20      p_pattern     => '/',
 21      p_method      => 'GET',
 22      p_source_type => ords.source_type_media,
 23      p_source      => q'[
 24        select a.content_type as "Content-Type",
 25               a.content as blob
 26          from ui_assets a
 27         where a.app_name = 'hello_world'
 28           and a.relative_path = 'index.html'
 29      ]',
 30      p_comments    => 'Returns the UI entry point'
 31    );
 32  
 33    ords.define_template(
 34      p_module_name => 'hello_api.ui',
 35      p_pattern     => '/:requested_path*',
 36      p_priority    => 1,
 37      p_etag_type   => 'NONE',
 38      p_comments    => 'Asset and SPA route delivery'
 39    );
 40  
 41    ords.define_handler(
 42      p_module_name => 'hello_api.ui',
 43      p_pattern     => '/:requested_path*',
 44      p_method      => 'GET',
 45      p_source_type => ords.source_type_media,
 46      p_source      => q'[
 47        with request_path as (
 48          select case
 49                   when :requested_path is null or :requested_path = '' then 'index.html'
 50                   when instr(:requested_path, '..') > 0 then '__invalid__'
 51                   when instr(:requested_path, '//') > 0 then '__invalid__'
 52                   when substr(:requested_path, 1, 1) = '/' then '__invalid__'
 53                   when regexp_like(:requested_path, '\.[[:alnum:]]+$') then :requested_path
 54                   else 'index.html'
 55                 end as resolved_path
 56            from dual
 57        )
 58        select a.content_type as "Content-Type",
 59               a.content as blob
 60          from ui_assets a
 61          join request_path r
 62            on a.relative_path = r.resolved_path
 63         where a.app_name = 'hello_world'
 64           and r.resolved_path != '__invalid__'
 65      ]',
 66      p_comments    => 'Returns UI assets and SPA fallback'
 67    );
 68  
 69    commit;
 70  end;
 71  /

