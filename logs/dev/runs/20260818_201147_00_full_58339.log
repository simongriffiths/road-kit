SQL> @db/package_specs/road_ctx_pkg.pks
SQL> create or replace package road_ctx_pkg as
  2  
  3    -- Session identity and authorisation for ROAD applications (spec-patch-06 section 6).
  4    --
  5    -- The ROAD_CTX application context is created WITH THIS PACKAGE as its trusted setter
  6    -- (`create or replace context road_ctx using road_ctx_pkg`). That USING clause is the security
  7    -- control, not decoration: no other code in the schema can write identity into the context, so a
  8    -- handler cannot promote itself by calling dbms_session.set_context directly.
  9    --
 10    -- Usage at the top of a protected handler:
 11    --
 12    --   if not road_ctx_pkg.begin_request(:current_user) then
 13    --     :status_code := 401;
 14    --     return;
 15    --   end if;
 16    --   road_ctx_pkg.require_permission('events.create');
 17    --
 18    -- ORDS does not fire a schema-level pre-hook -- there is no registration API reachable from the
 19    -- schema -- so begin_request is called per handler. Everything here therefore fails closed: an
 20    -- unestablished context grants nothing, never everything.
 21  
 22    -- Raised by require_permission and require_role when an AUTHENTICATED principal lacks the
 23    -- requirement. Mapped by error_api to HTTP 403. The number is mnemonic: -20403 -> 403.
 24    -- A caller who is not authenticated at all is ORDS's 401 and never reaches here.
 25    c_forbidden constant number := -20403;
 26  
 27    -- Establishes session identity for one request. Resolves (issuer, subject) to a principal,
 28    -- requires status ACTIVE, and loads that principal's effective permissions into the context in
 29    -- one pass. Returns false -- never raises -- on any failure, including an unknown subject, a
 30    -- suspended principal, or an unresolvable issuer.
 31    --
 32    -- p_issuer defaults to null, in which case the issuer is read from the schema's own ORDS JWT
 33    -- profile. ORDS validates a token's iss against that profile before admitting the request, so the
 34    -- profile issuer is by construction the issuer the caller presented.
 35    --
 36    -- ALWAYS clears any existing context first. ORDS pools connections, so this session may still
 37    -- hold the previous caller's identity.
 38    function begin_request(
 39      p_subject in varchar2,
 40      p_issuer  in varchar2 default null
 41    ) return boolean;
 42  
 43    -- Clears all session identity. Safe to call when nothing was established.
 44    procedure end_request;
 45  
 46    function principal_id return number;
 47    function subject      return varchar2;
 48    function issuer       return varchar2;
 49  
 50    -- True only after a successful begin_request on this session.
 51    function is_authenticated return boolean;
 52  
 53    -- Coarse check, kept so a simple application can ignore permissions entirely. Permissions are
 54    -- what the framework teaches, because they make role composition a data change (section 6.1).
 55    function has_role(p_role_name in varchar2) return boolean;
 56  
 57    -- Reads the context, never the tables -- one query per request, not one per check.
 58    function has_permission(p_permission_name in varchar2) return boolean;
 59  
 60    -- Raise c_forbidden unless held.
 61    procedure require_role(p_role_name in varchar2);
 62    procedure require_permission(p_permission_name in varchar2);
 63  
 64  end road_ctx_pkg;
 65  /

Package ROAD_CTX_PKG compiled

