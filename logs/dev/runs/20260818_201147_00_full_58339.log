SQL> @db/tables/road_principal_roles.create.sql
SQL> -- Which roles a principal holds. No scope_key: an earlier draft carried one so roles could be
SQL> -- per-tenant, dropped on the decision that one primary email is one principal and no login spans
SQL> -- tenants (spec-patch-06 sections 4.3 and 9.3). An application needing per-tenant membership
SQL> -- carries its own dimension.
SQL> --
SQL> -- granted_by is always taken from road_ctx.principal_id, never from a request body.
SQL> create table road_principal_roles (
  2    principal_id number not null references road_principals,
  3    role_name    varchar2(64 char) not null references road_roles,
  4    granted_at   timestamp with time zone default systimestamp not null,
  5    granted_by   number references road_principals,
  6    constraint road_principal_roles_pk primary key (principal_id, role_name)
  7  );

