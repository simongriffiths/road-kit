  9  
 10    c_user2_username constant varchar2(30) := 'USER2';
 11    c_user2_salt     constant raw(16)      := hextoraw('C7FFDC97A465A438E3BB68C0E597CFC5');
 12    c_user2_hash     constant raw(32)      := hextoraw('B96BF0DBAC303473AEB14507EA73F6795DDE1ADD502760E9FD4A83488F35C3DB');
 13  
 14    type t_config is record (
 15      issuer           jwt_scaffold_config.issuer%type,
 16      audience         jwt_scaffold_config.audience%type,
 17      scope_name       jwt_scaffold_config.scope_name%type,
 18      ttl_minutes      jwt_scaffold_config.ttl_minutes%type,
 19      jwk_url          jwt_scaffold_config.jwk_url%type,
 20      kid              jwt_scaffold_config.kid%type,
 21      private_key_b64  jwt_scaffold_config.private_key_b64%type,
 22      public_n         jwt_scaffold_config.public_n%type,
 23      public_e         jwt_scaffold_config.public_e%type
 24    );
 25  
 26    function get_config return t_config is
 27      l_config t_config;
 28    begin
 29      select issuer,
 30             audience,
 31             scope_name,
 32             ttl_minutes,
 33             jwk_url,
 34             kid,
 35             private_key_b64,
 36             public_n,
 37             public_e
 38        into l_config
 39        from jwt_scaffold_config
 40       where config_id = 1;
 41  
 42      return l_config;
 43    end get_config;
 44  
 45    function password_digest(
 46      p_password in varchar2,
 47      p_salt     in raw
 48    ) return raw is
 49    begin
 50      return dbms_crypto.hash(
 51        src => utl_i18n.string_to_raw(nvl(p_password, ''), 'AL32UTF8') || p_salt,
 52        typ => dbms_crypto.hash_sh256
 53      );
 54    end password_digest;
 55  
 56    function base64url_from_raw(p_raw in raw) return varchar2 is
 57      l_b64 varchar2(32767);
 58    begin
 59      l_b64 := utl_raw.cast_to_varchar2(utl_encode.base64_encode(p_raw));
 60      l_b64 := replace(l_b64, chr(10), '');
 61      l_b64 := replace(l_b64, chr(13), '');
 62      l_b64 := replace(l_b64, '+', '-');
 63      l_b64 := replace(l_b64, '/', '_');
 64      l_b64 := rtrim(l_b64, '=');
 65      return l_b64;
 66    end base64url_from_raw;
 67  
 68    function base64url_from_text(p_text in clob) return varchar2 is
 69    begin
 70      return base64url_from_raw(
 71        utl_i18n.string_to_raw(dbms_lob.substr(p_text, 32767, 1), 'AL32UTF8')
 72      );
 73    end base64url_from_text;
 74  
 75    function epoch_seconds_now return number is
 76    begin
 77      return floor(
 78        (cast(systimestamp at time zone 'UTC' as date) - date '1970-01-01') * 86400
 79      );
 80    end epoch_seconds_now;
 81  
 82    function check_credentials(
 83      p_username in varchar2,
 84      p_password in varchar2
 85    ) return boolean is
 86      l_username varchar2(30) := upper(trim(p_username));
 87      l_digest   raw(32);
 88    begin
 89      if l_username = c_admin_username then
 90        l_digest := password_digest(p_password, c_admin_salt);
 91        return l_digest = c_admin_hash;
 92      elsif l_username = c_user1_username then
 93        l_digest := password_digest(p_password, c_user1_salt);
 94        return l_digest = c_user1_hash;
 95      elsif l_username = c_user2_username then
 96        l_digest := password_digest(p_password, c_user2_salt);
 97        return l_digest = c_user2_hash;
 98      end if;
 99  
100      return false;
101    end check_credentials;
102  
103    function issue_token(
104      p_username in varchar2,
105      p_scope    in varchar2 default null
106    ) return clob is
107      l_config        t_config;
108      l_iat           number;
109      l_exp           number;
110      l_scope         varchar2(4000);
111      l_header_json   clob;
112      l_payload_json  clob;
113      l_header_b64    varchar2(32767);
114      l_payload_b64   varchar2(32767);
115      l_signing_input varchar2(32767);
116      l_signature_raw raw(32767);
117    begin
118      l_config := get_config;
119      l_iat := epoch_seconds_now;
120      l_exp := l_iat + (l_config.ttl_minutes * 60);
121      l_scope := nvl(p_scope, l_config.scope_name);
122  
123      select json_object(
124               'alg' value 'RS256',
125               'typ' value 'JWT',
126               'kid' value l_config.kid
127               returning clob
128             )
129        into l_header_json
130        from dual;
131  
132      select json_object(
133               'sub'   value upper(trim(p_username)),
134               'iss'   value l_config.issuer,
135               'aud'   value l_config.audience,
136               'exp'   value l_exp,
137               'iat'   value l_iat,
138               'scope' value l_scope,
139               'env'   value 'dev-scaffold'
140               returning clob
141             )
142        into l_payload_json
143        from dual;
144  
145      l_header_b64 := base64url_from_text(l_header_json);
146      l_payload_b64 := base64url_from_text(l_payload_json);
147      l_signing_input := l_header_b64 || '.' || l_payload_b64;
148  
149      l_signature_raw := dbms_crypto.sign(
150        src        => utl_i18n.string_to_raw(l_signing_input, 'AL32UTF8'),
151        prv_key    => utl_i18n.string_to_raw(l_config.private_key_b64, 'AL32UTF8'),
152        pubkey_alg => dbms_crypto.key_type_rsa,
153        sign_alg   => dbms_crypto.sign_sha256_rsa
154      );
155  
156      return l_signing_input || '.' || base64url_from_raw(l_signature_raw);
157    end issue_token;
158  
159    function jwks_document return clob is
160      l_config t_config;
161      l_jwks   clob;
162    begin
163      l_config := get_config;
164  
165      select json_object(
166               'keys' value json_array(
167                 json_object(
168                   'kty' value 'RSA',
169                   'use' value 'sig',
170                   'kid' value l_config.kid,
171                   'alg' value 'RS256',
172                   'n'   value l_config.public_n,
173                   'e'   value l_config.public_e
174                   returning clob
175                 )
176                 returning clob
177               )
178               returning clob
179             )
180        into l_jwks
181        from dual;
182  
183      return l_jwks;
184    end jwks_document;
185  
186    procedure authenticate_json(
187      p_body              in  clob,
188      p_access_token      out varchar2,
189      p_token_type        out varchar2,
190      p_expires_in        out number,
191      p_kid               out varchar2,
192      p_error             out varchar2,
193      p_error_description out varchar2,
194      p_http_status       out number
195    ) is
196      l_payload  json_object_t;
197      l_username varchar2(255);
198      l_password varchar2(255);
199      l_config   t_config;
200    begin
201      p_access_token := null;
202      p_token_type := null;
203      p_expires_in := null;
204      p_kid := null;
205      p_error := null;
206      p_error_description := null;
207      p_http_status := 200;
208  
209      l_payload := json_object_t.parse(p_body);
210      l_username := upper(trim(l_payload.get_string('username')));
211      l_password := l_payload.get_string('password');
212  
213      if l_username is null or l_password is null then
214        p_error := 'invalid_request';
215        p_error_description := 'username and password are required';
216        p_http_status := 400;
217        return;
218      end if;
219  
220      if not check_credentials(l_username, l_password) then
221        p_error := 'invalid_credentials';
222        p_error_description := 'invalid username or password';
223        p_http_status := 401;
224        return;
225      end if;
226  
227      l_config := get_config;
228  
229      p_access_token := issue_token(l_username, l_config.scope_name);
230      p_token_type := 'Bearer';
231      p_expires_in := l_config.ttl_minutes * 60;
232      p_kid := l_config.kid;
233      p_http_status := 200;
234    exception
235      when others then
236        if sqlcode in (-40441, -40587) then
237          p_error := 'invalid_request';
238          p_error_description := 'request body must be valid JSON';
239          p_http_status := 400;
240        else
241          p_error := 'server_error';
242          p_error_description := substr(sqlerrm, 1, 250);
243          p_http_status := 500;
244        end if;
245    end authenticate_json;
246  end jwt_scaffold_auth_api;
247  /

