SQL> create or replace package body road_admin_api_test as
  2  
  3    -- The two tests that carry this phase are test_user_admin_cannot_grant_reserved and
  4    -- test_granted_by_ignores_request_body. Everything else is ordinary coverage.
  5  
  6    c_issuer constant varchar2(64) := 'urn:road:test:road_admin';
  7  
  8    l_pass number := 0;
  9    l_fail number := 0;
 10  
 11    procedure fail(p_message in varchar2) is
 12    begin
 13      raise_application_error(-20000, p_message);
 14    end fail;
 15  
 16    procedure assert_eq(p_label in varchar2, p_expected in varchar2, p_actual in varchar2) is
 17    begin
 18      if nvl(p_actual, '<null>') != nvl(p_expected, '<null>') then
 19        fail(p_label || ': expected [' || p_expected || '] got [' || p_actual || ']');
 20      end if;
 21    end assert_eq;
 22  
 23    function principal_of(p_subject in varchar2) return number is
 24      l_id number;
 25    begin
 26      select principal_id into l_id
 27        from road_principals where issuer = c_issuer and subject = p_subject;
 28      return l_id;
 29    end principal_of;
 30  
 31    procedure setup is
 32      l_sys number;
 33      l_usr number;
 34      l_tgt number;
 35    begin
 36      execute immediate 'alter session disable parallel dml';
 37  
 38      insert into road_principals (issuer, subject, display_name, status)
 39      select c_issuer, 'SYSADM', 'road_admin test fixture', 'ACTIVE' from dual
 40       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'SYSADM');
 41      insert into road_principals (issuer, subject, display_name, status)
 42      select c_issuer, 'USRADM', 'road_admin test fixture', 'ACTIVE' from dual
 43       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'USRADM');
 44      insert into road_principals (issuer, subject, display_name, status)
 45      select c_issuer, 'TARGET', 'road_admin test fixture', 'ACTIVE' from dual
 46       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'TARGET');
 47  
 48      -- One role per grant test. Sharing a single role made two tests pass or fail depending on
 49      -- which ran first: whoever granted it first owned granted_by, and every later grant was a
 50      -- correct no-op that read as a failure.
 51      insert into road_roles (role_name, display_name, is_reserved)
 52      select 'test.ordinary', 'road_admin test fixture', 'N' from dual
 53       where not exists (select 1 from road_roles where role_name = 'test.ordinary');
 54      insert into road_roles (role_name, display_name, is_reserved)
 55      select 'test.grantedby', 'road_admin test fixture', 'N' from dual
 56       where not exists (select 1 from road_roles where role_name = 'test.grantedby');
 57      insert into road_roles (role_name, display_name, is_reserved)
 58      select 'test.idem', 'road_admin test fixture', 'N' from dual
 59       where not exists (select 1 from road_roles where role_name = 'test.idem');
 60  
 61      l_sys := principal_of('SYSADM');
 62      l_usr := principal_of('USRADM');
 63  
 64      insert into road_principal_roles (principal_id, role_name)
 65      select l_sys, 'road.system_admin' from dual
 66       where not exists (select 1 from road_principal_roles
 67                          where principal_id = l_sys and role_name = 'road.system_admin');
 68      insert into road_principal_roles (principal_id, role_name)
 69      select l_usr, 'road.user_admin' from dual
 70       where not exists (select 1 from road_principal_roles
 71                          where principal_id = l_usr and role_name = 'road.user_admin');
 72      commit;
 73    end setup;
 74  
 75    procedure teardown is
 76    begin
 77      delete from road_principal_roles
 78       where principal_id in (select principal_id from road_principals where issuer = c_issuer);
 79      delete from road_principals where issuer = c_issuer;
 80      delete from road_role_permissions
 81       where role_name in ('test.ordinary', 'test.definedrole', 'test.grantedby', 'test.idem');
 82      delete from road_roles
 83       where role_name in ('test.ordinary', 'test.definedrole', 'test.grantedby', 'test.idem');
 84      delete from road_permissions where permission_name like 'test.appperm%';
 85      commit;
 86      road_ctx_pkg.end_request;
 87    end teardown;
 88  
 89    -- THE test for this phase. Nothing in the table structure prevents it, so if this check is ever
 90    -- removed the model silently collapses to one tier: any user_admin could promote themselves.
 91    procedure test_user_admin_cannot_grant_reserved is
 92      l_res    json;
 93      l_raised boolean := false;
 94    begin
 95      if not road_ctx_pkg.begin_request('USRADM', c_issuer) then
 96        fail('USRADM should establish');
 97      end if;
 98  
 99      -- It CAN grant an ordinary role -- proving the denial below is about the role, not a blanket
100      -- lack of permission.
101      l_res := road_admin_api.grant_role(
102                 json('{"principal_id":' || principal_of('TARGET') || ',"role_name":"test.ordinary"}'));
103      assert_eq('ordinary grant succeeded', 'true', json_value(l_res, '$.granted'));
104  
105      begin
106        l_res := road_admin_api.grant_role(
107                   json('{"principal_id":' || principal_of('TARGET')
108                        || ',"role_name":"road.system_admin"}'));
109      exception
110        when others then
111          l_raised := true;
112          if sqlcode != road_ctx_pkg.c_forbidden then
113            fail('expected forbidden, got ' || sqlcode || ': ' || sqlerrm);
114          end if;
115      end;
116  
117      if not l_raised then
118        fail('a road.user_admin must NOT be able to grant road.system_admin');
119      end if;
120  
121      -- And it must not have happened anyway.
122      declare
123        l_count  number;
124        l_target number := principal_of('TARGET');  -- body-private, so not usable inside SQL
125      begin
126        select count(*) into l_count
127          from road_principal_roles
128         where principal_id = l_target and role_name = 'road.system_admin';
129        assert_eq('no reserved grant written', '0', to_char(l_count));
130      end;
131    end test_user_admin_cannot_grant_reserved;
132  
133    procedure test_system_admin_can_grant_reserved is
134      l_res json;
135    begin
136      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then
137        fail('SYSADM should establish');
138      end if;
139      l_res := road_admin_api.grant_role(
140                 json('{"principal_id":' || principal_of('TARGET') || ',"role_name":"road.user_admin"}'));
141      assert_eq('system_admin granted reserved role', 'true', json_value(l_res, '$.granted'));
142    end test_system_admin_can_grant_reserved;
143  
144    -- granted_by must come from the session, not the caller. A caller who could nominate it could
145    -- forge the record of who authorised an escalation.
146    procedure test_granted_by_ignores_request_body is
147      l_res    json;
148      l_actual number;
149      l_target number;
150    begin
151      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then
152        fail('SYSADM should establish');
153      end if;
154  
155      l_res := road_admin_api.grant_role(json(
156        '{"principal_id":' || principal_of('TARGET')
157        || ',"role_name":"test.grantedby","granted_by":999999}'));
158  
159      l_target := principal_of('TARGET');
160      select granted_by into l_actual
161        from road_principal_roles
162       where principal_id = l_target and role_name = 'test.grantedby';
163  
164      if l_actual = 999999 then
165        fail('granted_by was taken from the request body');
166      end if;
167      assert_eq('granted_by is the session principal', to_char(principal_of('SYSADM')), to_char(l_actual));
168    end test_granted_by_ignores_request_body;
169  
170    procedure test_grant_is_idempotent is
171      l_res json;
172    begin
173      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then fail('establish'); end if;
174      l_res := road_admin_api.grant_role(
175                 json('{"principal_id":' || principal_of('TARGET') || ',"role_name":"test.idem"}'));
176      assert_eq('first grant', 'true', json_value(l_res, '$.granted'));
177      l_res := road_admin_api.grant_role(
178                 json('{"principal_id":' || principal_of('TARGET') || ',"role_name":"test.idem"}'));
179      assert_eq('second grant is a no-op, not an error', 'false', json_value(l_res, '$.granted'));
180    end test_grant_is_idempotent;
181  
182    procedure test_cannot_revoke_last_system_admin is
183      l_raised boolean := false;
184      l_res    json;
185    begin
186      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then fail('establish'); end if;
187  
188      -- The fixture SYSADM plus the seeded bootstrap admin means more than one holder exists, so
189      -- revoke the fixture's own to get down to the last one, then prove the last is refused.
190      l_res := road_admin_api.revoke_role(
191                 json('{"principal_id":' || principal_of('SYSADM')
192                      || ',"role_name":"road.system_admin"}'));
193      assert_eq('fixture admin revoked', 'true', json_value(l_res, '$.revoked'));
194  
195      -- Re-establish as the seeded bootstrap admin, now the only holder, and try to remove itself.
196      road_ctx_pkg.end_request;
197      declare
198        l_subject road_config.config_value%type;
199        l_boot    number;
200      begin
201        select config_value into l_subject
202          from road_config where config_key = 'bootstrap_admin_subject';
203        if not road_ctx_pkg.begin_request(l_subject) then fail('bootstrap admin should establish'); end if;
204        select principal_id into l_boot
205          from road_principals
206         where subject = l_subject and issuer = road_ctx_pkg.issuer;
207  
208        begin
209          l_res := road_admin_api.revoke_role(
210                     json('{"principal_id":' || l_boot || ',"role_name":"road.system_admin"}'));
211        exception
212          when others then
213            l_raised := true;
214            if sqlcode != -20001 then
215              fail('expected validation error, got ' || sqlcode || ': ' || sqlerrm);
216            end if;
217        end;
218      end;
219  
220      if not l_raised then
221        fail('revoking the last road.system_admin must be refused');
222      end if;
223    end test_cannot_revoke_last_system_admin;
224  
225    procedure test_define_role_rejects_road_namespace is
226      l_raised boolean := false;
227      l_res    json;
228    begin
229      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then fail('establish'); end if;
230  
231      l_res := road_admin_api.define_role(
232                 json('{"role_name":"test.definedrole","display_name":"Defined"}'));
233      assert_eq('ordinary role defined', 'test.definedrole', json_value(l_res, '$.role_name'));
234  
235      begin
236        l_res := road_admin_api.define_role(json('{"role_name":"road.sneaky"}'));
237      exception
238        when others then
239          l_raised := true;
240      end;
241      if not l_raised then
242        fail('the road. namespace must be refused');
243      end if;
244    end test_define_role_rejects_road_namespace;
245  
246    -- A user_admin holds road.role.grant but NOT road.role.define, so defining must 403.
247    procedure test_user_admin_cannot_define_roles is
248      l_raised boolean := false;
249      l_res    json;
250    begin
251      if not road_ctx_pkg.begin_request('USRADM', c_issuer) then fail('establish'); end if;
252      begin
253        l_res := road_admin_api.define_role(json('{"role_name":"test.notallowed"}'));
254      exception
255        when others then
256          l_raised := true;
257          if sqlcode != road_ctx_pkg.c_forbidden then
258            fail('expected forbidden, got ' || sqlcode);
259          end if;
260      end;
261      if not l_raised then fail('user_admin must not define roles'); end if;
262    end test_user_admin_cannot_define_roles;
263  
264    -- With no session at all, every operation must deny. This is the "handler forgot begin_request"
265    -- case reaching the package directly.
266    procedure test_unauthenticated_denied is
267      l_raised boolean := false;
268      l_res    json;
269    begin
270      road_ctx_pkg.end_request;
271      begin
272        l_res := road_admin_api.get_roles;
273      exception
274        when others then
275          l_raised := true;
276      end;
277      if not l_raised then fail('get_roles must deny with no session'); end if;
278    end test_unauthenticated_denied;
279  
280    procedure test_grant_all_app_permissions_is_explicit is
281      l_before number;
282      l_after  number;
283    begin
284      insert into road_permissions (permission_name, description)
285      values ('test.appperm.one', 'road_admin test fixture');
286      insert into road_permissions (permission_name, description)
287      values ('test.appperm.two', 'road_admin test fixture');
288  
289      road_admin_api.grant_all_app_permissions('test.ordinary');
290  
291      select count(*) into l_before
292        from road_role_permissions
293       where role_name = 'test.ordinary' and permission_name like 'test.appperm%';
294      assert_eq('both app permissions granted', '2', to_char(l_before));
295  
296      -- No road.* permission may be picked up by the blanket grant.
297      select count(*) into l_after
298        from road_role_permissions
299       where role_name = 'test.ordinary' and permission_name like 'road.%';
300      assert_eq('no framework permissions granted', '0', to_char(l_after));
301  
302      -- A permission added AFTERWARDS must not be acquired -- that is rule 4, and the reason this is
303      -- a deploy-time write rather than a runtime wildcard.
304      insert into road_permissions (permission_name, description)
305      values ('test.appperm.three', 'added after the blanket grant');
306      select count(*) into l_after
307        from road_role_permissions
308       where role_name = 'test.ordinary' and permission_name = 'test.appperm.three';
309      assert_eq('later permission NOT silently acquired', '0', to_char(l_after));
310    end test_grant_all_app_permissions_is_explicit;
311  
312    procedure run(p_name in varchar2, p_which in varchar2) is
313    begin
314      case p_which
315        when 'user_admin_reserved'   then test_user_admin_cannot_grant_reserved;
316        when 'sysadmin_reserved'     then test_system_admin_can_grant_reserved;
317        when 'granted_by'            then test_granted_by_ignores_request_body;
318        when 'idempotent'            then test_grant_is_idempotent;
319        when 'last_admin'            then test_cannot_revoke_last_system_admin;
320        when 'define_namespace'      then test_define_role_rejects_road_namespace;
321        when 'user_admin_define'     then test_user_admin_cannot_define_roles;
322        when 'unauthenticated'       then test_unauthenticated_denied;
323        when 'grant_all'             then test_grant_all_app_permissions_is_explicit;
324      end case;
325      dbms_output.put_line('PASS ' || p_name);
326      l_pass := l_pass + 1;
327    exception
328      when others then
329        dbms_output.put_line('FAIL ' || p_name || ': ' || sqlerrm);
330        l_fail := l_fail + 1;
331    end run;
332  
333    procedure run_all is
334    begin
335      l_pass := 0;
336      l_fail := 0;
337      setup;
338  
339      run('test_user_admin_cannot_grant_reserved', 'user_admin_reserved');
340      run('test_system_admin_can_grant_reserved', 'sysadmin_reserved');
341      run('test_granted_by_ignores_request_body', 'granted_by');
342      run('test_grant_is_idempotent', 'idempotent');
343      run('test_define_role_rejects_road_namespace', 'define_namespace');
344      run('test_user_admin_cannot_define_roles', 'user_admin_define');
345      run('test_unauthenticated_denied', 'unauthenticated');
346      run('test_grant_all_app_permissions_is_explicit', 'grant_all');
347      -- Last: it deliberately revokes admin grants, so it must not run before the others.
348      run('test_cannot_revoke_last_system_admin', 'last_admin');
349  
350      teardown;
351      dbms_output.put_line('road_admin_api_test: ' || l_pass || ' passed, ' || l_fail || ' failed');
352      if l_fail > 0 then
353        raise_application_error(-20000, l_fail || ' road_admin_api test(s) failed');
354      end if;
355    exception
356      when others then
357        teardown;
358        raise;
359    end run_all;
360  
361  end road_admin_api_test;
362  /

