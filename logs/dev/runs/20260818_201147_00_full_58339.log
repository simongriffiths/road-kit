SQL> create or replace package body error_api as
  2  
  3    -- Never raises: a logging failure must not cause a secondary failure
  4    -- (spec/error-handling-contract-v1.md §5.2). Autonomous so the log entry survives even when
  5    -- the caller's transaction rolls back around this error.
  6    procedure write_error_log(
  7      p_sqlcode   in number,
  8      p_sqlerrm   in varchar2,
  9      p_backtrace in varchar2,
 10      p_context   in varchar2
 11    ) is
 12      pragma autonomous_transaction;
 13    begin
 14      insert into error_log (sqlcode, sqlerrm, backtrace, context)
 15      values (p_sqlcode, p_sqlerrm, p_backtrace, p_context);
 16      commit;
 17    exception
 18      when others then
 19        null;
 20    end write_error_log;
 21  
 22    procedure handle_known(
 23      p_sqlcode     in number,
 24      p_sqlerrm     in varchar2,
 25      p_status_code out number,
 26      p_response    out clob
 27    ) is
 28      l_error   varchar2(60);
 29      l_message varchar2(4000);
 30    begin
 31      -- Fixed mapping per calendar-app-design-outline.md §"Error signalling from EVENT_API to
 32      -- ORDS". Not a generic range-based scheme (e.g. 20000-20099 => 400): each code is a
 33      -- deliberately chosen business meaning, so it is listed explicitly rather than derived.
 34      case p_sqlcode
 35        when -20001 then
 36          l_error := 'VALIDATION_ERROR';
 37          p_status_code := 400;
 38        when -20003 then
 39          l_error := 'AGENDA_LOCKED';
 40          p_status_code := 422;
 41        when -20004 then
 42          l_error := 'NOT_FOUND';
 43          p_status_code := 404;
 44        when -20009 then
 45          l_error := 'CONFLICT';
 46          p_status_code := 409;
 47        when -20403 then
 48          -- road_ctx_pkg.c_forbidden. An AUTHENTICATED principal that lacks a required permission or
 49          -- role. Distinct from 401 by design: ORDS returns 401 for no token, a bad token or a
 50          -- missing scope, before any PL/SQL runs. Reaching here means the caller is who they say
 51          -- they are and still may not do this (spec-patch-06 section 6.4). Without the distinction
 52          -- a permission failure would surface as a 500 or as a 401 that misreports the cause.
 53          -- The code is mnemonic: -20403 -> 403.
 54          l_error := 'FORBIDDEN';
 55          p_status_code := 403;
 56        else
 57          -- A code inside the reserved range but outside the fixed mapping is a coding mistake,
 58          -- not a known business error — escalate rather than emit a response with a null
 59          -- error/status. Never silently return a malformed body (contract §2 principle 1).
 60          handle_unknown(
 61            p_sqlerrm     => p_sqlerrm,
 62            p_backtrace   => dbms_utility.format_error_backtrace,
 63            p_context     => 'error_api.handle_known: unmapped known-range sqlcode ' || p_sqlcode,
 64            p_status_code => p_status_code,
 65            p_response    => p_response
 66          );
 67          return;
 68      end case;
 69  
 70      -- raise_application_error(-20001, 'msg') surfaces as sqlerrm = 'ORA-20001: msg'; strip the
 71      -- code prefix so message carries only the user-safe text passed to raise_application_error.
 72      l_message := regexp_replace(p_sqlerrm, '^ORA-[0-9]+:\s*', '');
 73  
 74      select json_object(
 75               'error'    value l_error,
 76               'message'  value l_message,
 77               'ora_code' value 'ORA-' || to_char(-p_sqlcode, 'FM00000')
 78               returning clob
 79             )
 80        into p_response
 81        from dual;
 82    end handle_known;
 83  
 84    procedure handle_unknown(
 85      p_sqlerrm     in varchar2,
 86      p_backtrace   in varchar2,
 87      p_context     in varchar2 default null,
 88      p_status_code out number,
 89      p_response    out clob
 90    ) is
 91    begin
 92      write_error_log(
 93        p_sqlcode   => sqlcode,
 94        p_sqlerrm   => p_sqlerrm,
 95        p_backtrace => p_backtrace,
 96        p_context   => p_context
 97      );
 98  
 99      p_status_code := 500;
100  
101      -- Generic message only — never echo sqlerrm/backtrace to the client (contract §3.2).
102      select json_object(
103               'error'   value 'INTERNAL_ERROR',
104               'message' value 'An unexpected error occurred'
105               returning clob
106             )
107        into p_response
108        from dual;
109    end handle_unknown;
110  
111  end error_api;
112  /

