SQL> @db/tables/road_principals.create.sql
SQL> -- Identity. One row per authenticated human, keyed on (issuer, subject) rather than subject alone:
SQL> -- sub is unique only within an issuer, and federating with a deployer's own IdP is a first-class
SQL> -- scenario for a multi-cloud framework (spec-patch-06 section 4.1).
SQL> --
SQL> -- subject is opaque and email is a mutable attribute, never the key -- people change addresses and
SQL> -- principal_id must survive that (section 4.2). Nothing outside this table stores subject or email.
SQL> create table road_principals (
  2    principal_id           number generated by default as identity primary key,
  3    issuer                 varchar2(512 char) not null,
  4    subject                varchar2(255 char) not null,
  5    email                  varchar2(320 char),
  6    display_name           varchar2(255 char),
  7    status                 varchar2(20 char) default 'ACTIVE' not null,
  8    credentials_changed_at timestamp with time zone,
  9    created_at             timestamp with time zone default systimestamp not null,
 10    updated_at             timestamp with time zone default systimestamp not null,
 11    constraint road_principals_iss_sub_uk unique (issuer, subject),
 12    constraint road_principals_status_ck
 13      check (status in ('ACTIVE', 'SUSPENDED', 'RETIRED'))
 14  );

