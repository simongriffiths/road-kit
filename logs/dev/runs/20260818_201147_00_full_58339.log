 40            if sqlcode between -20999 and -20000 then
 41              error_api.handle_known(sqlcode, sqlerrm, l_status_code, l_error_response);
 42            else
 43              error_api.handle_unknown(sqlerrm, dbms_utility.format_error_backtrace,
 44                                       'admin.roles.list', l_status_code, l_error_response);
 45            end if;
 46            owa_util.status_line(l_status_code);
 47            htp.p(l_error_response);
 48        end;
 49      ]',
 50      p_comments    => 'Lists roles and the permissions they compose'
 51    );
 52  
 53    ords.define_handler(
 54      p_module_name => 'road_cal_api.admin',
