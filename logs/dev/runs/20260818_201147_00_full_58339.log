SQL> @db/package_specs/road_admin_api.pks
SQL> create or replace package road_admin_api as
  2  
  3    -- Role administration (spec-patch-06 section 5, build plan phase 4).
  4    --
  5    -- Signature convention matches event_api: native JSON in, native JSON out, no ref cursors or
  6    -- PL/SQL collections across the package boundary. Never commits -- ORDS commits on success and
  7    -- tests roll back to a savepoint.
  8    --
  9    -- Authorisation is enforced HERE, not only in the handler. The handler's job is to establish
 10    -- session context from :current_user; the permission requirement travels with the operation, so
 11    -- a second caller -- an MCP tool, a batch job, another package -- cannot reach a privileged
 12    -- operation by not being an ORDS handler.
 13  
 14    -- GET /admin/principals/:principal_id/roles   requires road.role.grant
 15    -- p_request: { "principal_id": <number> }
 16    -- Returns:   { "principal_id": n, "subject": "...", "roles": [ { "role_name", "granted_at",
 17    --              "granted_by" }, ... ] }
 18    function get_principal_roles(p_request in json) return json;
 19  
 20    -- POST /admin/principals/:principal_id/roles   requires road.role.grant
 21    -- p_request: { "principal_id": <number>, "role_name": "<name>" }
 22    -- Returns:   { "principal_id": n, "role_name": "...", "granted": true|false }
 23    --            granted=false when the principal already held it -- idempotent, not an error.
 24    --
 25    -- granted_by is taken from road_ctx_pkg.principal_id and is never read from the request body.
 26    -- Granting a RESERVED role additionally requires road.role.define, which is what stops a
 27    -- road.user_admin promoting anyone -- including themselves -- to road.system_admin.
 28    function grant_role(p_request in json) return json;
 29  
 30    -- DELETE /admin/principals/:principal_id/roles/:role_name   requires road.role.revoke
 31    -- p_request: { "principal_id": <number>, "role_name": "<name>" }
 32    -- Returns:   { "principal_id": n, "role_name": "...", "revoked": true|false }
 33    --
 34    -- Revoking a reserved role also requires road.role.define, for the same reason as granting: a
 35    -- road.user_admin who could revoke road.system_admin could lock the real administrators out.
 36    -- Revoking the LAST holder of road.system_admin is refused outright.
 37    function revoke_role(p_request in json) return json;
 38  
 39    -- GET /admin/roles   requires road.role.grant
 40    -- Returns: { "roles": [ { "role_name", "display_name", "description", "is_reserved",
 41    --            "permissions": [...] }, ... ] }
 42    function get_roles(p_request in json default null) return json;
 43  
 44    -- POST /admin/roles   requires road.role.define
 45    -- p_request: { "role_name": "<name>", "display_name": "...", "description": "..." }
 46    -- Returns:   the created role object.
 47    --
 48    -- Refuses the road. prefix: that namespace is reserved for the framework's own administration
