 22      exception
 23        when others then
 24          error_api.handle_known(sqlcode, sqlerrm, l_status, l_response);
 25      end;
 26      assert_eq('status', '400', to_char(l_status));
 27      assert_eq('error', 'VALIDATION_ERROR', json_value(l_response, '$.error'));
 28      assert_eq('message', 'start must be before end', json_value(l_response, '$.message'));
 29      assert_eq('ora_code', 'ORA-20001', json_value(l_response, '$.ora_code'));
 30    end test_handle_known_validation;
