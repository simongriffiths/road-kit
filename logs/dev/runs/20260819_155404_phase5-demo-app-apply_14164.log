361        from json_table(json_query(l_res, '$.items' returning json), '$[*]'
362                        columns (id number path '$.todo_id'))
363       where id = l_id;
364      assert_eq('DELETED visible when asked for', '1', to_char(l_count));
365    end test_deleted_excluded_from_default_list;
366  
367    ---------------------------------------------------------------------------
368    -- Purge -- the reserved permission's subject
369    ---------------------------------------------------------------------------
370  
371    procedure test_purge_denied_without_permission is
372      l_raised boolean := false;
373      l_res    json;
374    begin
375      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
376      begin
377        l_res := demo_todo_api.purge(json('{"before":"2999-01-01T00:00:00.000+00:00"}'));
378      exception
379        when others then
380          l_raised := true;
381          if sqlcode != road_ctx_pkg.c_forbidden then
382            fail('expected forbidden, got ' || sqlcode || ': ' || sqlerrm);
383          end if;
384      end;
385      if not l_raised then fail('purge must require todo.purge'); end if;
386    end test_purge_denied_without_permission;
387  
388    -- Purge reaches ACROSS OWNERS and only takes finished rows. Both halves matter: the cross-owner
389    -- reach is what makes it dangerous enough to reserve, and sparing OPEN rows is what stops it
390    -- being a table truncate with extra steps.
391    procedure test_purge_crosses_owners_and_spares_open is
392      l_open   number;
393      l_done_a number;
394      l_done_b number;
395      l_res    json;
396      l_count  number;
397    begin
398      l_open   := seed_todo('OWNER', 'still open', 'OPEN');
399      l_done_a := seed_todo('OWNER', 'finished a', 'DONE');
400      l_done_b := seed_todo('OTHER', 'finished b', 'DONE');
401  
402      if not road_ctx_pkg.begin_request('ADMIN', c_issuer) then fail('establish'); end if;
403      l_res := demo_todo_api.purge(json('{"before":"2999-01-01T00:00:00.000+00:00"}'));
404  
405      select count(*) into l_count from demo_todos where todo_id in (l_done_a, l_done_b);
406      assert_eq('both owners'' finished todos purged', '0', to_char(l_count));
407  
408      select count(*) into l_count from demo_todos where todo_id = l_open;
409      assert_eq('an OPEN todo is untouched', '1', to_char(l_count));
410    end test_purge_crosses_owners_and_spares_open;
411  
412    ---------------------------------------------------------------------------
413  
414    procedure run_all is
415      procedure exec(p_name in varchar2) is
416      begin
417        savepoint sp_demo;
418        case p_name
419          when 'other_owner_not_found'   then test_other_owners_todo_is_not_found;
420          when 'list_all_not_list'       then test_list_all_does_not_imply_list;
421          when 'own_owner_ok'            then test_own_owner_param_is_not_escalation;
422          when 'other_owner_needs_all'   then test_listing_another_owner_requires_list_all;
423          when 'owner_from_session'      then test_create_takes_owner_from_session;
424          when 'owner_body_refused'      then test_owner_ignores_request_body;
425          when 'stale_token_conflicts'   then test_stale_read_token_conflicts;
426          when 'fresh_token_updates'     then test_fresh_read_token_updates;
427          when 'update_needs_token'      then test_update_requires_read_token;
428          when 'update_not_deleted'      then test_update_cannot_set_deleted;
429          when 'delete_soft_idempotent'  then test_delete_is_soft_and_idempotent;
430          when 'deleted_hidden'          then test_deleted_excluded_from_default_list;
431          when 'purge_needs_permission'  then test_purge_denied_without_permission;
432          when 'purge_cross_owner'       then test_purge_crosses_owners_and_spares_open;
433          else fail('unknown test ' || p_name);
434        end case;
435        dbms_output.put_line('PASS ' || p_name);
436        l_pass := l_pass + 1;
437        rollback to sp_demo;
438        road_ctx_pkg.end_request;
439      exception
440        when others then
441          dbms_output.put_line('FAIL ' || p_name || ': ' || sqlerrm);
442          l_fail := l_fail + 1;
443          rollback to sp_demo;
444          road_ctx_pkg.end_request;
445      end exec;
446    begin
447      l_pass := 0;
448      l_fail := 0;
449      setup;
450  
451      exec('other_owner_not_found');
452      exec('list_all_not_list');
453      exec('own_owner_ok');
454      exec('other_owner_needs_all');
455      exec('owner_from_session');
456      exec('owner_body_refused');
457      exec('stale_token_conflicts');
458      exec('fresh_token_updates');
459      exec('update_needs_token');
460      exec('update_not_deleted');
461      exec('delete_soft_idempotent');
462      exec('deleted_hidden');
463      exec('purge_needs_permission');
464      exec('purge_cross_owner');
465  
466      teardown;
467      dbms_output.put_line('demo_todo_api_test: ' || l_pass || ' passed, ' || l_fail || ' failed');
468      if l_fail > 0 then
469        raise_application_error(-20000, l_fail || ' demo_todo_api test(s) failed');
470      end if;
471    exception
472      when others then
473        teardown;
474        raise;
475    end run_all;
476  
477  end demo_todo_api_test;
478  /

