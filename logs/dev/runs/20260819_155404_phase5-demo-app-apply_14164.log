213    ---------------------------------------------------------------------------
214    -- Concurrency (spec-patch-08 section 6.2)
215    ---------------------------------------------------------------------------
216  
217    -- THE concurrency test. A second writer moved the row after this caller read it; the update
218    -- must be refused, not silently applied over the top.
219    procedure test_stale_read_token_conflicts is
220      l_id     number;
221      l_token  varchar2(100);
222      l_read   json;
223      l_raised boolean := false;
224      l_res    json;
225    begin
226      l_id := seed_todo('OWNER', 'contended');
227      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
228  
229      l_read  := demo_todo_api.get_todo(json('{"todo_id":' || l_id || '}'));
230      l_token := json_value(l_read, '$.read_token');
231  
232      -- Somebody else moves it. The trigger advances updated_at past the token's issued_at.
233      update demo_todos set title = 'moved by someone else' where todo_id = l_id;
234  
235      begin
236        l_res := demo_todo_api.update_todo(
237                   json('{"todo_id":' || l_id || ',"read_token":"' || l_token || '","title":"mine"}'));
238      exception
239        when others then
240          l_raised := true;
241          if sqlcode != demo_todo_api.c_conflict then
242            fail('expected CONFLICT, got ' || sqlcode || ': ' || sqlerrm);
243          end if;
244      end;
245      if not l_raised then fail('a stale read_token must be refused'); end if;
246  
247      declare
248        l_title varchar2(200 char);
249      begin
250        select title into l_title from demo_todos where todo_id = l_id;
251        assert_eq('the losing write did not land', 'moved by someone else', l_title);
252      end;
253    end test_stale_read_token_conflicts;
254  
255    procedure test_fresh_read_token_updates is
256      l_id    number;
257      l_token varchar2(100);
258      l_read  json;
259      l_res   json;
260    begin
261      l_id := seed_todo('OWNER', 'before');
262      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
263  
264      l_read  := demo_todo_api.get_todo(json('{"todo_id":' || l_id || '}'));
265      l_token := json_value(l_read, '$.read_token');
266  
267      l_res := demo_todo_api.update_todo(
268                 json('{"todo_id":' || l_id || ',"read_token":"' || l_token || '","title":"after"}'));
269      assert_eq('title updated', 'after', json_value(l_res, '$.title'));
270    end test_fresh_read_token_updates;
271  
272    procedure test_update_requires_read_token is
273      l_id     number;
274      l_raised boolean := false;
275      l_res    json;
276    begin
277      l_id := seed_todo('OWNER', 'no token');
278      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
279      begin
