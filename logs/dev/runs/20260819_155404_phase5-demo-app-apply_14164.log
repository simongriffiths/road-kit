SQL> @db/tables/demo_todos.create.sql
SQL> -- The demo application's only table (spec-patch-08 section 4). Not framework: nothing in road-kit's
SQL> -- own surface references it, and deploy/create/00_full.sql does not create it -- only
SQL> -- deploy/create/97_demo.sql does, which adopters do not run.
SQL> --
SQL> -- The demo_ prefix is load-bearing. It makes a stray demo object visible in user_tables at a
SQL> -- glance, so "did the demo get deployed into an adopter's schema" is answerable by one query.
SQL> --
SQL> -- This is NOT a template to build on. An adopter copying the demo should copy the WIRING -- the
SQL> -- require_permission calls, the ownership filter, the read_token handling, the error routing --
SQL> -- and throw the domain away (spec-patch-08 section 11).
SQL> --
SQL> -- status DELETED is a soft delete. Hard deletion exists only behind demo_todo_api.purge, which is
SQL> -- the point: a reserved permission needs something genuinely irreversible to guard, or the
SQL> -- demonstration is theatre.
SQL> --
SQL> -- updated_at is trigger-maintained (coding-standards-v1.md section 5.5) and is exposed for display
SQL> -- only. It is NOT the concurrency mechanism -- the opaque read_token from road_audit_api is
SQL> -- (spec-patch-08 section 6.2). A client-supplied updated_at is rejected, never honoured.
SQL> create table demo_todos (
  2    todo_id            number generated always as identity,
  3    owner_principal_id number not null references road_principals,
  4    title              varchar2(200 char) not null,
  5    notes              varchar2(4000 char),
  6    due_at             timestamp with time zone,
  7    status             varchar2(10 char) default 'OPEN' not null,
  8    created_at         timestamp with time zone default systimestamp not null,
  9    updated_at         timestamp with time zone default systimestamp not null,
 10    constraint demo_todos_pk primary key (todo_id),
 11    constraint demo_todos_status_ck check (status in ('OPEN', 'DONE', 'DELETED'))
 12  );

