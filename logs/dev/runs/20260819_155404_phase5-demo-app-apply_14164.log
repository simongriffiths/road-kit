SQL> create or replace package demo_todo_api as
  2  
  3    -- The demo application (planning/spec-patch-08-road-kit-demo-app.md, in road-cal).
  4    --
  5    -- This package exists to be READ, and to fail loudly when the framework breaks. It is the
  6    -- smallest application that pulls on every seam an adopter will pull on: permission-gated
  7    -- handlers, an application role, a RESERVED application permission, per-principal ownership, and
  8    -- optimistic concurrency through road_audit_api.
  9    --
 10    -- It is not a product and not a starter template. Nobody should build on top of it.
 11    --
 12    -- Rule 1 of the patch, which keeps it honest: THE DEMO APP MAY NEVER CAUSE A FRAMEWORK CHANGE.
 13    -- If it needs something road-kit lacks, that is a specification question for the framework,
 14    -- raised separately -- never a change smuggled in under a demo.
 15    --
 16    -- Signature convention matches road_admin_api and road-cal's event_api: native JSON in, native
 17    -- JSON out, no ref cursors or PL/SQL collections across the package boundary. Never commits --
 18    -- ORDS commits on success and tests roll back to a savepoint.
 19    --
 20    -- Authorisation is enforced HERE, not only in the handler, for the same reason road_admin_api
 21    -- does it: a second caller -- an MCP tool, a batch job, another package -- must not reach a
 22    -- privileged operation by not being an ORDS handler.
 23  
 24    -- Error codes, matching error_api's fixed mapping exactly. Listed here so the demo reads as
 25    -- documentation of the contract an adopter inherits.
 26    c_validation constant number := -20001;  -- 400 VALIDATION_ERROR
 27    c_not_found  constant number := -20004;  -- 404 NOT_FOUND
 28    c_conflict   constant number := -20009;  -- 409 CONFLICT
 29  
 30    -- Fixed 409 wording. It must read as a request to RE-EVALUATE, never as an instruction to retry
 31    -- (spec-patch-02-mcp.md section 5). An agent told to retry will retry, and the second write is
 32    -- the one that silently destroys the change it could not see. Do not vary this text per call.
 33    c_conflict_message constant varchar2(300) :=
 34      'The todo changed since you read it. Call GET /todos/{todo_id}/ to see the current state, ' ||
 35      'then decide whether the change is still appropriate.';
 36  
 37    -- GET /todos/   requires todo.list
 38    -- p_request: { "status": "OPEN|DONE|DELETED", "q": "<term>", "owner": n,
 39    --              "offset": n, "limit": n }  -- all optional
 40    -- Returns:   { "items": [ <todo>, ... ], "hasMore": bool, "limit": n, "offset": n, "count": n,
 41    --              "read_token": "<guid>" }
 42    --
 43    -- Scoped to the caller's own rows unless "owner" names someone else, which requires
 44    -- todo.list_all. The same endpoint with permission-dependent scope, deliberately, rather than a
 45    -- separate /todos/all/ route: it is the case adopters actually hit and the one that is easy to
 46    -- get wrong. A route-shaped check teaches nothing transferable (spec-patch-08 section 6.1).
 47    --
 48    -- DELETED rows are excluded unless "status" asks for them by name.
 49    --
 50    -- hasMore comes from fetching limit+1 rows and discarding the extra. There is deliberately no
 51    -- total count, which would be a second full scan to render a number nothing needs.
 52    function get_todos(p_request in json default null) return json;
 53  
 54    -- POST /todos/   requires todo.create
 55    -- p_request: { "title": "...", "notes": "...", "due_at": "<iso8601>" }
 56    -- Returns:   the created todo object. NO read_token -- read it back via get_todo before
 57    --            updating, matching road-cal's create endpoints.
 58    --
 59    -- owner_principal_id is taken from road_ctx_pkg.principal_id and is NEVER read from the body,
 60    -- for the same reason granted_by is not on grant_role and attached_by is not on
 61    -- attach_permission: a caller who could nominate it could forge the record of who owns what. A
 62    -- body that supplies it is a 400, not a silently ignored field -- silently ignoring an attempt
 63    -- to set ownership tells the caller their forgery worked.
 64    function create_todo(p_request in json) return json;
 65  
 66    -- GET /todos/:todo_id/   requires todo.get
 67    -- p_request: { "todo_id": n }
 68    -- Returns:   { "todo": <todo>, "read_token": "<guid>" }
 69    function get_todo(p_request in json) return json;
 70  
 71    -- PATCH /todos/:todo_id/   requires todo.update
 72    -- p_request: { "todo_id": n, "read_token": "<guid>",
 73    --              "title": "...", "notes": "...", "due_at": "...", "status": "OPEN|DONE" }
 74    -- Returns:   the updated todo object.
 75    --
 76    -- status accepts OPEN and DONE only. DELETED is reachable through delete_todo alone, so
 77    -- "I finished it" and "I want it gone" stay distinguishable.
 78    --
 79    -- read_token is required and checked with road_audit_api.check_fresh. Stale -> c_conflict.
 80    function update_todo(p_request in json) return json;
 81  
 82    -- DELETE /todos/:todo_id/   requires todo.delete
 83    -- p_request: { "todo_id": n, "read_token": "<guid>" }
 84    -- Returns:   { "todo_id": n, "deleted": true|false }
 85    --            deleted=false when it was already DELETED -- idempotent, not an error, matching
 86    --            grant_role and attach_permission.
 87    --
 88    -- Soft delete. The row survives; only purge removes it.
 89    function delete_todo(p_request in json) return json;
 90  
 91    -- POST /todos/purge/   requires todo.purge  -- RESERVED
 92    -- p_request: { "before": "<iso8601>" }
 93    -- Returns:   { "purged": n }
 94    --
 95    -- Hard-deletes DONE and DELETED rows older than the cutoff, ACROSS ALL OWNERS. Irreversible,
 96    -- which is exactly what qualifies it to be the reserved permission's subject.
 97    --
 98    -- todo.purge is reserved and does NOT start with road. -- spec-patch-07 section 3.1's worked
 99    -- example, and the whole reason road-kit needed an application: a prefix rule would let any
100    -- road.role.compose holder attach this from the composition UI, and the entire point of it is to
101    -- be the permission nobody holds by default.
102    function purge(p_request in json) return json;
103  
104  end demo_todo_api;
105  /

