165    begin
166      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
167      begin
168        l_res := demo_todo_api.get_todos(json('{"owner":' || principal_of('OTHER') || '}'));
169      exception
170        when others then
171          l_raised := true;
172          if sqlcode != road_ctx_pkg.c_forbidden then
173            fail('expected forbidden, got ' || sqlcode || ': ' || sqlerrm);
174          end if;
175      end;
176      if not l_raised then fail('listing another owner must require todo.list_all'); end if;
177    end test_listing_another_owner_requires_list_all;
