445    -- THE test that proves spec-patch-07 section 1's claim end to end: composition is a data change,
446    -- not a release. Nothing tested this before now, because until this phase nothing COULD.
447    procedure test_composition_takes_effect_on_next_request is
448      l_res json;
449    begin
450      insert into road_permissions (permission_name, description)
451      values ('test.appperm.compose', 'road_admin test fixture');
452  
453      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then fail('establish'); end if;
454      l_res := road_admin_api.attach_permission(
455                 json('{"role_name":"test.composetarget","permission_name":"test.appperm.compose"}'));
456      assert_eq('attached', 'true', json_value(l_res, '$.attached'));
457  
458      -- TARGET holds test.composetarget (setup). Re-establishing loads effective permissions fresh
459      -- from road_role_permissions -- no deploy, no new machinery.
460      road_ctx_pkg.end_request;
461      if not road_ctx_pkg.begin_request('TARGET', c_issuer) then fail('TARGET should establish'); end if;
462      if not road_ctx_pkg.has_permission('test.appperm.compose') then
463        fail('composition did not take effect on the next request');
464      end if;
465    end test_composition_takes_effect_on_next_request;
