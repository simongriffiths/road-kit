289                 json('{"role_name":"test.definedrole","display_name":"Defined"}'));
290      assert_eq('ordinary role defined', 'test.definedrole', json_value(l_res, '$.role_name'));
291  
292      begin
293        l_res := road_admin_api.define_role(json('{"role_name":"road.sneaky"}'));
294      exception
295        when others then
296          l_raised := true;
297      end;
298      if not l_raised then
299        fail('the road. namespace must be refused');
300      end if;
301    end test_define_role_rejects_road_namespace;
