SQL> create or replace package body road_admin_api_test as
  2  
  3    -- The two tests that carry this phase are test_user_admin_cannot_grant_reserved and
  4    -- test_granted_by_ignores_request_body. Everything else is ordinary coverage.
  5  
  6    c_issuer constant varchar2(64) := 'urn:road:test:road_admin';
  7  
  8    l_pass number := 0;
  9    l_fail number := 0;
 10  
 11    procedure fail(p_message in varchar2) is
 12    begin
 13      raise_application_error(-20000, p_message);
 14    end fail;
 15  
 16    procedure assert_eq(p_label in varchar2, p_expected in varchar2, p_actual in varchar2) is
 17    begin
 18      if nvl(p_actual, '<null>') != nvl(p_expected, '<null>') then
 19        fail(p_label || ': expected [' || p_expected || '] got [' || p_actual || ']');
 20      end if;
 21    end assert_eq;
 22  
 23    function principal_of(p_subject in varchar2) return number is
 24      l_id number;
 25    begin
 26      select principal_id into l_id
 27        from road_principals where issuer = c_issuer and subject = p_subject;
 28      return l_id;
 29    end principal_of;
 30  
 31    procedure setup is
 32      l_sys    number;
 33      l_usr    number;
 34      l_tgt    number;
 35      l_target number;
 36    begin
 37      execute immediate 'alter session disable parallel dml';
 38  
 39      insert into road_principals (issuer, subject, display_name, status)
 40      select c_issuer, 'SYSADM', 'road_admin test fixture', 'ACTIVE' from dual
 41       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'SYSADM');
 42      insert into road_principals (issuer, subject, display_name, status)
 43      select c_issuer, 'USRADM', 'road_admin test fixture', 'ACTIVE' from dual
 44       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'USRADM');
 45      insert into road_principals (issuer, subject, display_name, status)
 46      select c_issuer, 'TARGET', 'road_admin test fixture', 'ACTIVE' from dual
 47       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'TARGET');
 48  
 49      -- Distinctive name and address, so the get_principals search tests can assert an exact count
 50      -- against a database that also holds the real seeded principals.
 51      insert into road_principals (issuer, subject, display_name, email, status)
 52      select c_issuer, 'SEARCHME', 'Searchable Fixture', 'find.me@example.test', 'ACTIVE' from dual
 53       where not exists (select 1 from road_principals
 54                          where issuer = c_issuer and subject = 'SEARCHME');
 55  
 56      -- One role per grant test. Sharing a single role made two tests pass or fail depending on
 57      -- which ran first: whoever granted it first owned granted_by, and every later grant was a
 58      -- correct no-op that read as a failure.
 59      insert into road_roles (role_name, display_name, is_reserved)
 60      select 'test.ordinary', 'road_admin test fixture', 'N' from dual
 61       where not exists (select 1 from road_roles where role_name = 'test.ordinary');
 62      insert into road_roles (role_name, display_name, is_reserved)
 63      select 'test.grantedby', 'road_admin test fixture', 'N' from dual
 64       where not exists (select 1 from road_roles where role_name = 'test.grantedby');
 65      insert into road_roles (role_name, display_name, is_reserved)
 66      select 'test.idem', 'road_admin test fixture', 'N' from dual
 67       where not exists (select 1 from road_roles where role_name = 'test.idem');
 68  
 69      -- Two APPLICATION permission fixtures, one reserved and one not. Neither starts with road.,
 70      -- which is the whole point: spec-patch-07 section 3.1's rule is that reserved-ness is read
 71      -- from the column and never inferred from the name, and only an application permission can
 72      -- exercise it.
 73      --
 74      -- Seeded by this suite rather than borrowed from the adopting application's own data, so the
 75      -- file stays byte-identical across repos. It did borrow, until 2026-08-19: it named
 76      -- events.purge and session.read, which are road-cal's, and the two composition tests below
 77      -- therefore failed with ORA-20004 the first time this suite ran in road-kit. A framework test
 78      -- suite must not depend on any particular adopter existing.
 79      insert into road_permissions (permission_name, description, is_reserved)
 80      select 'test.appperm.reserved', 'road_admin test fixture, reserved', 'Y' from dual
 81       where not exists (select 1 from road_permissions
 82                          where permission_name = 'test.appperm.reserved');
 83      insert into road_permissions (permission_name, description, is_reserved)
 84      select 'test.appperm.plain', 'road_admin test fixture, unreserved', 'N' from dual
 85       where not exists (select 1 from road_permissions
 86                          where permission_name = 'test.appperm.plain');
 87      insert into road_roles (role_name, display_name, is_reserved)
 88      select 'test.searchable', 'road_admin test fixture', 'N' from dual
 89       where not exists (select 1 from road_roles where role_name = 'test.searchable');
 90      -- Dedicated to test_composition_takes_effect_on_next_request -- NOT test.ordinary, which
 91      -- test_grant_all_app_permissions_is_explicit blanket-attaches every application permission to
 92      -- (deploy-attached), and which test_user_admin_cannot_grant_reserved's own grant_role call
 93      -- assumes TARGET does not already hold.
 94      insert into road_roles (role_name, display_name, is_reserved)
 95      select 'test.composetarget', 'road_admin test fixture', 'N' from dual
 96       where not exists (select 1 from road_roles where role_name = 'test.composetarget');
 97  
 98      l_sys := principal_of('SYSADM');
 99      l_usr := principal_of('USRADM');
100      l_tgt := principal_of('SEARCHME');
101  
102      insert into road_principal_roles (principal_id, role_name)
103      select l_tgt, 'test.searchable' from dual
104       where not exists (select 1 from road_principal_roles
105                          where principal_id = l_tgt and role_name = 'test.searchable');
106  
107      insert into road_principal_roles (principal_id, role_name)
108      select l_sys, 'road.system_admin' from dual
109       where not exists (select 1 from road_principal_roles
110                          where principal_id = l_sys and role_name = 'road.system_admin');
111      insert into road_principal_roles (principal_id, role_name)
112      select l_usr, 'road.user_admin' from dual
113       where not exists (select 1 from road_principal_roles
114                          where principal_id = l_usr and role_name = 'road.user_admin');
115  
116      -- TARGET holds test.composetarget directly (not via another test's side effect), so
117      -- test_composition_takes_effect_on_next_request stays correct regardless of run order.
118      l_target := principal_of('TARGET');
119      insert into road_principal_roles (principal_id, role_name)
120      select l_target, 'test.composetarget' from dual
121       where not exists (select 1 from road_principal_roles
122                          where principal_id = l_target and role_name = 'test.composetarget');
123      commit;
124    end setup;
125  
126    procedure teardown is
127    begin
128      -- road_role_permissions BEFORE road_principals: spec-patch-07 added ATTACHED_BY, a nullable FK
129      -- to road_principals, and the composition tests below leave rows attached_by one of this
130      -- fixture's own principals (SYSADM). Deleting road_principals first would raise ORA-02292
131      -- (child record found) against those rows.
132      delete from road_role_permissions
133       where role_name in ('test.ordinary', 'test.definedrole', 'test.grantedby', 'test.idem',
134                           'test.searchable', 'test.composetarget');
135      delete from road_principal_roles
136       where principal_id in (select principal_id from road_principals where issuer = c_issuer);
137      delete from road_principals where issuer = c_issuer;
138      delete from road_roles
139       where role_name in ('test.ordinary', 'test.definedrole', 'test.grantedby', 'test.idem',
140                           'test.searchable', 'test.composetarget');
141      delete from road_permissions where permission_name like 'test.appperm%';
142      commit;
143      road_ctx_pkg.end_request;
144    end teardown;
145  
146    -- THE test for this phase. Nothing in the table structure prevents it, so if this check is ever
147    -- removed the model silently collapses to one tier: any user_admin could promote themselves.
148    procedure test_user_admin_cannot_grant_reserved is
149      l_res    json;
150      l_raised boolean := false;
151    begin
152      if not road_ctx_pkg.begin_request('USRADM', c_issuer) then
153        fail('USRADM should establish');
154      end if;
155  
156      -- It CAN grant an ordinary role -- proving the denial below is about the role, not a blanket
157      -- lack of permission.
158      l_res := road_admin_api.grant_role(
159                 json('{"principal_id":' || principal_of('TARGET') || ',"role_name":"test.ordinary"}'));
160      assert_eq('ordinary grant succeeded', 'true', json_value(l_res, '$.granted'));
161  
162      begin
163        l_res := road_admin_api.grant_role(
164                   json('{"principal_id":' || principal_of('TARGET')
165                        || ',"role_name":"road.system_admin"}'));
166      exception
167        when others then
168          l_raised := true;
169          if sqlcode != road_ctx_pkg.c_forbidden then
170            fail('expected forbidden, got ' || sqlcode || ': ' || sqlerrm);
171          end if;
172      end;
173  
174      if not l_raised then
175        fail('a road.user_admin must NOT be able to grant road.system_admin');
176      end if;
177  
178      -- And it must not have happened anyway.
179      declare
180        l_count  number;
181        l_target number := principal_of('TARGET');  -- body-private, so not usable inside SQL
182      begin
183        select count(*) into l_count
184          from road_principal_roles
185         where principal_id = l_target and role_name = 'road.system_admin';
186        assert_eq('no reserved grant written', '0', to_char(l_count));
187      end;
188    end test_user_admin_cannot_grant_reserved;
189  
190    procedure test_system_admin_can_grant_reserved is
191      l_res json;
192    begin
193      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then
194        fail('SYSADM should establish');
195      end if;
196      l_res := road_admin_api.grant_role(
197                 json('{"principal_id":' || principal_of('TARGET') || ',"role_name":"road.user_admin"}'));
198      assert_eq('system_admin granted reserved role', 'true', json_value(l_res, '$.granted'));
199    end test_system_admin_can_grant_reserved;
200  
201    -- granted_by must come from the session, not the caller. A caller who could nominate it could
202    -- forge the record of who authorised an escalation.
203    procedure test_granted_by_ignores_request_body is
204      l_res    json;
205      l_actual number;
206      l_target number;
207    begin
208      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then
209        fail('SYSADM should establish');
210      end if;
211  
212      l_res := road_admin_api.grant_role(json(
213        '{"principal_id":' || principal_of('TARGET')
214        || ',"role_name":"test.grantedby","granted_by":999999}'));
215  
216      l_target := principal_of('TARGET');
217      select granted_by into l_actual
218        from road_principal_roles
219       where principal_id = l_target and role_name = 'test.grantedby';
220  
221      if l_actual = 999999 then
222        fail('granted_by was taken from the request body');
223      end if;
224      assert_eq('granted_by is the session principal', to_char(principal_of('SYSADM')), to_char(l_actual));
225    end test_granted_by_ignores_request_body;
226  
227    procedure test_grant_is_idempotent is
228      l_res json;
229    begin
230      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then fail('establish'); end if;
231      l_res := road_admin_api.grant_role(
232                 json('{"principal_id":' || principal_of('TARGET') || ',"role_name":"test.idem"}'));
233      assert_eq('first grant', 'true', json_value(l_res, '$.granted'));
234      l_res := road_admin_api.grant_role(
235                 json('{"principal_id":' || principal_of('TARGET') || ',"role_name":"test.idem"}'));
236      assert_eq('second grant is a no-op, not an error', 'false', json_value(l_res, '$.granted'));
237    end test_grant_is_idempotent;
238  
239    procedure test_cannot_revoke_last_system_admin is
240      l_raised boolean := false;
241      l_res    json;
242    begin
243      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then fail('establish'); end if;
244  
245      -- The fixture SYSADM plus the seeded bootstrap admin means more than one holder exists, so
246      -- revoke the fixture's own to get down to the last one, then prove the last is refused.
247      l_res := road_admin_api.revoke_role(
248                 json('{"principal_id":' || principal_of('SYSADM')
249                      || ',"role_name":"road.system_admin"}'));
250      assert_eq('fixture admin revoked', 'true', json_value(l_res, '$.revoked'));
251  
252      -- Re-establish as the seeded bootstrap admin, now the only holder, and try to remove itself.
253      road_ctx_pkg.end_request;
254      declare
255        l_subject road_config.config_value%type;
256        l_boot    number;
257      begin
258        select config_value into l_subject
259          from road_config where config_key = 'bootstrap_admin_subject';
260        if not road_ctx_pkg.begin_request(l_subject) then fail('bootstrap admin should establish'); end if;
261        select principal_id into l_boot
262          from road_principals
263         where subject = l_subject and issuer = road_ctx_pkg.issuer;
264  
265        begin
266          l_res := road_admin_api.revoke_role(
267                     json('{"principal_id":' || l_boot || ',"role_name":"road.system_admin"}'));
268        exception
269          when others then
270            l_raised := true;
271            if sqlcode != -20001 then
272              fail('expected validation error, got ' || sqlcode || ': ' || sqlerrm);
273            end if;
274        end;
275      end;
276  
277      if not l_raised then
278        fail('revoking the last road.system_admin must be refused');
279      end if;
280    end test_cannot_revoke_last_system_admin;
281  
282    procedure test_define_role_rejects_road_namespace is
283      l_raised boolean := false;
284      l_res    json;
285    begin
286      if not road_ctx_pkg.begin_request('SYSADM', c_issuer) then fail('establish'); end if;
287  
