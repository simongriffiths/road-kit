577        values ('test.grantedby', 'road.role.compose', l_sys);
578        rollback;
579      exception
580        when others then
581          rollback;
582          l_raised := true;
583          if sqlcode != -8601 then
584            fail('expected ORA-08601, got ' || sqlcode || ': ' || sqlerrm);
