337    procedure test_grant_all_app_permissions_is_explicit is
338      l_before number;
339      l_after  number;
340    begin
341      insert into road_permissions (permission_name, description)
342      values ('test.appperm.one', 'road_admin test fixture');
343      insert into road_permissions (permission_name, description)
344      values ('test.appperm.two', 'road_admin test fixture');
345  
346      road_admin_api.grant_all_app_permissions('test.ordinary');
347  
348      -- three, not two: test.appperm.one and .two above, plus test.appperm.plain from setup.
349      -- test.appperm.reserved is the one that must NOT appear -- see below.
350      select count(*) into l_before
351        from road_role_permissions
352       where role_name = 'test.ordinary' and permission_name like 'test.appperm%';
353      assert_eq('unreserved app permissions granted', '3', to_char(l_before));
354  
355      -- No road.* permission may be picked up by the blanket grant.
356      select count(*) into l_after
357        from road_role_permissions
358       where role_name = 'test.ordinary' and permission_name like 'road.%';
359      assert_eq('no framework permissions granted', '0', to_char(l_after));
360  
361      -- THE regression test for spec-patch-08 section 7.1. Until 2026-08-19 this procedure filtered
362      -- on the road. prefix ALONE, so a RESERVED application permission -- events.purge in road-cal,
363      -- todo.purge in the demo app, test.appperm.reserved here -- was handed to whatever role was
364      -- named. That is the exact inference spec-patch-07 section 3.1 exists to forbid, in the package
365      -- spec-patch-07 amended. road-cal hit the symptom, hand-listed its user grants in 95_data.sql
366      -- to route around it, and left the cause shipping. This assertion is what stops it returning.
367      select count(*) into l_after
368        from road_role_permissions
369       where role_name = 'test.ordinary' and permission_name = 'test.appperm.reserved';
370      assert_eq('RESERVED app permission NOT granted', '0', to_char(l_after));
371  
372      -- A permission added AFTERWARDS must not be acquired -- that is rule 4, and the reason this is
373      -- a deploy-time write rather than a runtime wildcard.
374      insert into road_permissions (permission_name, description)
375      values ('test.appperm.three', 'added after the blanket grant');
376      select count(*) into l_after
377        from road_role_permissions
378       where role_name = 'test.ordinary' and permission_name = 'test.appperm.three';
379      assert_eq('later permission NOT silently acquired', '0', to_char(l_after));
380    end test_grant_all_app_permissions_is_explicit;
