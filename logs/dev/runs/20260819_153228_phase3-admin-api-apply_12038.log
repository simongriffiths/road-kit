563      values ('test.idem', 'test.appperm.assertok', l_sys);
564      rollback;
565    exception
566      when others then
567        rollback;
568        fail('ordinary permission, session-attached, must be permitted: ' || sqlerrm);
569    end test_assertion_permits_ordinary_session_attach;
