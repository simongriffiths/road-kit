SQL> prompt === verify role composition (spec patch 07) ===
=== verify role composition (spec patch 07) ===
SQL> 
SQL> declare
  2    l_count number;
  3  
  4    procedure assert(p_condition in boolean, p_message in varchar2) is
  5    begin
  6      if not nvl(p_condition, false) then
  7        raise_application_error(-20000, p_message);
  8      end if;
  9    end assert;
 10  begin
 11    -- 1. Every permission road-kit ships is RESERVED, because every one of them is the framework's
 12    --    own authority. An unreserved permission appearing here means an application's seed has
 13    --    leaked into the framework's, or a migration left a row fail-open.
 14    select count(*) into l_count
 15      from road_permissions
 16     where permission_name in ('road.role.define', 'road.permission.define', 'road.role.grant',
 17                               'road.role.revoke', 'road.role.compose')
 18       and is_reserved = 'Y';
 19    assert(l_count = 5, 'All 5 framework permissions must be reserved, found ' || l_count);
 20  
 21    -- 2. road.role.compose belongs to road.system_admin and to nobody else -- not road.user_admin,
 22    --    which administers PEOPLE, not what a role means (spec-patch-07 section 6).
 23    select count(*) into l_count
 24      from road_role_permissions
 25     where permission_name = 'road.role.compose' and role_name = 'road.system_admin';
 26    assert(l_count = 1, 'road.system_admin must hold road.role.compose');
 27  
 28    select count(*) into l_count
 29      from road_role_permissions
 30     where permission_name = 'road.role.compose' and role_name != 'road.system_admin';
 31    assert(l_count = 0,
 32           'road.role.compose must be held only by road.system_admin, found ' || l_count || ' other');
 33  
 34    -- 3. Both assertions exist and are ENABLED. A deploy that dropped them and did not recreate
 35    --    them leaves the composition guard as a package promise only, which is exactly what
 36    --    spec-patch-07 section 5 exists to avoid.
 37    select count(*) into l_count
 38      from user_assertions
 39     where assertion_name in ('ROAD_RESERVED_COMPOSITION', 'ROAD_ADMIN_REACHABLE')
 40       and status = 'ENABLED';
 41    assert(l_count = 2, 'Both composition assertions must exist and be ENABLED, found ' || l_count);
 42  
 43    -- 4. Every framework attachment is deploy-seeded. A non-null attached_by on a reserved
 44    --    permission should have been refused by road_reserved_composition outright, so finding one
 45    --    means the assertion is not doing its job.
 46    select count(*) into l_count
 47      from road_role_permissions rp, road_permissions p
 48     where p.permission_name = rp.permission_name
 49       and p.is_reserved = 'Y'
 50       and rp.attached_by is not null;
 51    assert(l_count = 0,
 52           'A reserved permission is session-attached - the composition guard is not enforcing');
 53  
 54    dbms_output.put_line('[INFO] Role composition verified: 5 reserved permissions, '
 55                         || 'road.role.compose correctly restricted, 2 assertions ENABLED');
 56  end;
 57  /
[INFO] Role composition verified: 5 reserved permissions, road.role.compose correctly restricted, 2 assertions ENABLED


