357    -- Purge -- the reserved permission's subject
358    ---------------------------------------------------------------------------
359  
360    procedure test_purge_denied_without_permission is
361      l_raised boolean := false;
362      l_res    json;
363    begin
364      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
365      begin
366        l_res := demo_todo_api.purge(json('{"before":"2999-01-01T00:00:00.000+00:00"}'));
367      exception
368        when others then
369          l_raised := true;
370          if sqlcode != road_ctx_pkg.c_forbidden then
371            fail('expected forbidden, got ' || sqlcode || ': ' || sqlerrm);
372          end if;
373      end;
374      if not l_raised then fail('purge must require todo.purge'); end if;
375    end test_purge_denied_without_permission;
376  
377    -- Purge reaches ACROSS OWNERS and only takes finished rows. Both halves matter: the cross-owner
378    -- reach is what makes it dangerous enough to reserve, and sparing OPEN rows is what stops it
379    -- being a table truncate with extra steps.
380    procedure test_purge_crosses_owners_and_spares_open is
381      l_open   number;
382      l_done_a number;
383      l_done_b number;
384      l_res    json;
385      l_count  number;
386    begin
387      l_open   := seed_todo('OWNER', 'still open', 'OPEN');
388      l_done_a := seed_todo('OWNER', 'finished a', 'DONE');
389      l_done_b := seed_todo('OTHER', 'finished b', 'DONE');
390  
391      if not road_ctx_pkg.begin_request('ADMIN', c_issuer) then fail('establish'); end if;
392      l_res := demo_todo_api.purge(json('{"before":"2999-01-01T00:00:00.000+00:00"}'));
393  
394      select count(*) into l_count from demo_todos where todo_id in (l_done_a, l_done_b);
395      assert_eq('both owners'' finished todos purged', '0', to_char(l_count));
396  
397      select count(*) into l_count from demo_todos where todo_id = l_open;
398      assert_eq('an OPEN todo is untouched', '1', to_char(l_count));
399    end test_purge_crosses_owners_and_spares_open;
