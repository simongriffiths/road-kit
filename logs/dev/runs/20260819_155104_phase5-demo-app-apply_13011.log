132      exception
133        when others then
134          l_raised := true;
135          if sqlcode != road_ctx_pkg.c_forbidden then
136            fail('expected forbidden, got ' || sqlcode || ': ' || sqlerrm);
137          end if;
138      end;
139      if not l_raised then fail('todo_admin holds no todo.list and must not be able to list'); end if;
140    end test_list_all_does_not_imply_list;
