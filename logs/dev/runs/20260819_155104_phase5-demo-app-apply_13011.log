 40      select c_issuer, 'OWNER', 'demo_todo test fixture', 'ACTIVE' from dual
 41       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'OWNER');
 42      insert into road_principals (issuer, subject, display_name, status)
