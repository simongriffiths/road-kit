202    ---------------------------------------------------------------------------
203    -- Concurrency (spec-patch-08 section 6.2)
204    ---------------------------------------------------------------------------
205  
206    -- THE concurrency test. A second writer moved the row after this caller read it; the update
207    -- must be refused, not silently applied over the top.
208    procedure test_stale_read_token_conflicts is
209      l_id     number;
210      l_token  varchar2(100);
211      l_read   json;
212      l_raised boolean := false;
213      l_res    json;
214    begin
215      l_id := seed_todo('OWNER', 'contended');
216      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
217  
218      l_read  := demo_todo_api.get_todo(json('{"todo_id":' || l_id || '}'));
219      l_token := json_value(l_read, '$.read_token');
220  
221      -- Somebody else moves it. The trigger advances updated_at past the token's issued_at.
222      update demo_todos set title = 'moved by someone else' where todo_id = l_id;
223  
224      begin
225        l_res := demo_todo_api.update_todo(
226                   json('{"todo_id":' || l_id || ',"read_token":"' || l_token || '","title":"mine"}'));
227      exception
228        when others then
229          l_raised := true;
230          if sqlcode != demo_todo_api.c_conflict then
231            fail('expected CONFLICT, got ' || sqlcode || ': ' || sqlerrm);
232          end if;
233      end;
234      if not l_raised then fail('a stale read_token must be refused'); end if;
235  
236      declare
237        l_title varchar2(200 char);
238      begin
239        select title into l_title from demo_todos where todo_id = l_id;
240        assert_eq('the losing write did not land', 'moved by someone else', l_title);
241      end;
242    end test_stale_read_token_conflicts;
