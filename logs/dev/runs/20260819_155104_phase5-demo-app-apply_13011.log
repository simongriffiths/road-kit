310    procedure test_delete_is_soft_and_idempotent is
311      l_id    number;
312      l_token varchar2(100);
313      l_res   json;
314      l_count number;
315    begin
316      l_id := seed_todo('OWNER', 'soft delete me');
317      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
318  
319      l_token := json_value(demo_todo_api.get_todo(json('{"todo_id":' || l_id || '}')), '$.read_token');
320      l_res := demo_todo_api.delete_todo(
321                 json('{"todo_id":' || l_id || ',"read_token":"' || l_token || '"}'));
322      assert_eq('first delete reports true', 'true', json_value(l_res, '$.deleted'));
323  
324      select count(*) into l_count from demo_todos where todo_id = l_id and status = 'DELETED';
325      assert_eq('row survives as DELETED', '1', to_char(l_count));
326  
327      l_token := json_value(demo_todo_api.get_todo(json('{"todo_id":' || l_id || '}')), '$.read_token');
328      l_res := demo_todo_api.delete_todo(
329                 json('{"todo_id":' || l_id || ',"read_token":"' || l_token || '"}'));
330      assert_eq('second delete reports false, not an error', 'false', json_value(l_res, '$.deleted'));
331    end test_delete_is_soft_and_idempotent;
332  
333    procedure test_deleted_excluded_from_default_list is
334      l_res   json;
335      l_id    number;
336      l_count number;
337    begin
338      l_id := seed_todo('OWNER', 'hidden', 'DELETED');
339      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
340  
341      l_res := demo_todo_api.get_todos(null);
342      select count(*) into l_count
343        from json_table(json_query(l_res, '$.items' returning json), '$[*]'
344                        columns (id number path '$.todo_id'))
345       where id = l_id;
346      assert_eq('DELETED hidden by default', '0', to_char(l_count));
347  
348      l_res := demo_todo_api.get_todos(json('{"status":"DELETED"}'));
349      select count(*) into l_count
350        from json_table(json_query(l_res, '$.items' returning json), '$[*]'
351                        columns (id number path '$.todo_id'))
352       where id = l_id;
353      assert_eq('DELETED visible when asked for', '1', to_char(l_count));
354    end test_deleted_excluded_from_default_list;
