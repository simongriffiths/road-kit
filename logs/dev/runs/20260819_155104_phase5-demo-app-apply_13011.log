403    procedure run_all is
404      procedure exec(p_name in varchar2) is
405      begin
406        savepoint sp_demo;
407        case p_name
408          when 'other_owner_not_found'   then test_other_owners_todo_is_not_found;
409          when 'list_all_not_list'       then test_list_all_does_not_imply_list;
410          when 'own_owner_ok'            then test_own_owner_param_is_not_escalation;
411          when 'other_owner_needs_all'   then test_listing_another_owner_requires_list_all;
412          when 'owner_from_session'      then test_create_takes_owner_from_session;
413          when 'owner_body_refused'      then test_owner_ignores_request_body;
414          when 'stale_token_conflicts'   then test_stale_read_token_conflicts;
415          when 'fresh_token_updates'     then test_fresh_read_token_updates;
416          when 'update_needs_token'      then test_update_requires_read_token;
417          when 'update_not_deleted'      then test_update_cannot_set_deleted;
418          when 'delete_soft_idempotent'  then test_delete_is_soft_and_idempotent;
419          when 'deleted_hidden'          then test_deleted_excluded_from_default_list;
420          when 'purge_needs_permission'  then test_purge_denied_without_permission;
421          when 'purge_cross_owner'       then test_purge_crosses_owners_and_spares_open;
422          else fail('unknown test ' || p_name);
423        end case;
424        dbms_output.put_line('PASS ' || p_name);
425        l_pass := l_pass + 1;
426        rollback to sp_demo;
427        road_ctx_pkg.end_request;
428      exception
429        when others then
430          dbms_output.put_line('FAIL ' || p_name || ': ' || sqlerrm);
431          l_fail := l_fail + 1;
432          rollback to sp_demo;
433          road_ctx_pkg.end_request;
434      end exec;
435    begin
436      l_pass := 0;
437      l_fail := 0;
438      setup;
439  
440      exec('other_owner_not_found');
441      exec('list_all_not_list');
442      exec('own_owner_ok');
443      exec('other_owner_needs_all');
444      exec('owner_from_session');
445      exec('owner_body_refused');
446      exec('stale_token_conflicts');
447      exec('fresh_token_updates');
448      exec('update_needs_token');
449      exec('update_not_deleted');
450      exec('delete_soft_idempotent');
451      exec('deleted_hidden');
452      exec('purge_needs_permission');
453      exec('purge_cross_owner');
454  
455      teardown;
456      dbms_output.put_line('demo_todo_api_test: ' || l_pass || ' passed, ' || l_fail || ' failed');
457      if l_fail > 0 then
458        raise_application_error(-20000, l_fail || ' demo_todo_api test(s) failed');
459      end if;
460    exception
461      when others then
462        teardown;
463        raise;
464    end run_all;
465  
466  end demo_todo_api_test;
