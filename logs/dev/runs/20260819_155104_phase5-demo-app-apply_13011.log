 47       where not exists (select 1 from road_principals where issuer = c_issuer and subject = 'ADMIN');
 48  
 49      insert into road_principal_roles (principal_id, role_name)
 50      select principal_of('OWNER'), 'user' from dual
 51       where not exists (select 1 from road_principal_roles
 52                          where principal_id = principal_of('OWNER') and role_name = 'user');
 53      insert into road_principal_roles (principal_id, role_name)
 54      select principal_of('OTHER'), 'user' from dual
 55       where not exists (select 1 from road_principal_roles
 56                          where principal_id = principal_of('OTHER') and role_name = 'user');
