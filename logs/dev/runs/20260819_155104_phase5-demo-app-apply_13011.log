 89    -- Ownership (spec-patch-08 section 6.1)
 90    ---------------------------------------------------------------------------
 91  
 92    -- THE ownership test. A todo belonging to someone else is NOT FOUND, not FORBIDDEN -- a 403
 93    -- would confirm the row exists, which the caller has not earned.
 94    procedure test_other_owners_todo_is_not_found is
 95      l_id     number;
 96      l_raised boolean := false;
 97      l_res    json;
 98    begin
 99      l_id := seed_todo('OTHER', 'not yours');
100      if not road_ctx_pkg.begin_request('OWNER', c_issuer) then fail('establish'); end if;
101  
102      begin
103        l_res := demo_todo_api.get_todo(json('{"todo_id":' || l_id || '}'));
104      exception
105        when others then
106          l_raised := true;
107          if sqlcode != demo_todo_api.c_not_found then
108            fail('expected NOT_FOUND (' || demo_todo_api.c_not_found || '), got '
109                 || sqlcode || ': ' || sqlerrm);
110          end if;
111      end;
112      if not l_raised then fail('another owner''s todo must not be readable'); end if;
113    end test_other_owners_todo_is_not_found;
114  
115    -- todo_admin holds todo.list_all but NOT todo.list, so it cannot list at all. That is the
116    -- separation rule 2 of spec patch 06 applies to road.system_admin, carried into the application:
117    -- administering todos is not using them. It also proves list_all does not imply list -- an
118    -- easy and invisible mistake to make when wiring the two.
119    --
120    -- Naming this honestly matters. An earlier draft called it test_admin_can_list_another_owner,
121    -- which is the opposite of what it asserts.
122    procedure test_list_all_does_not_imply_list is
123      l_ignore number;
