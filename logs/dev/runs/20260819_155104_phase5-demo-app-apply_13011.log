SQL> create or replace package body demo_todo_api as
  2  
  3    c_app_schema constant varchar2(30) := 'ROAD_KIT_DEMO';
  4  
  5    c_default_limit constant number := 25;
  6    c_max_limit     constant number := 100;
  7  
  8    -- A search term is user input reaching a LIKE pattern, so its wildcards have to be neutralised
  9    -- or a user typing '%' silently matches everything. Escape the escape character first, or
 10    -- escaping the wildcards re-introduces it. Lifted verbatim from road_admin_api.like_term -- the
 11    -- demo copies the framework's idioms rather than inventing its own.
 12    function like_term(p_term in varchar2) return varchar2 is
 13    begin
 14      return '%' || replace(replace(replace(lower(p_term), '\', '\\'), '%', '\%'), '_', '\_') || '%';
 15    end like_term;
 16  
 17    function parse_ts(p_text in varchar2, p_field in varchar2) return timestamp with time zone is
 18    begin
 19      if p_text is null then
 20        return null;
 21      end if;
 22      return to_timestamp_tz(p_text, 'YYYY-MM-DD"T"HH24:MI:SS.FFTZH:TZM');
 23    exception
 24      when others then
 25        raise_application_error(c_validation, p_field || ' must be ISO 8601 with a UTC offset');
 26    end parse_ts;
 27  
 28    -- The canonical todo object (spec-patch-08 section 6).
 29    --
 30    -- owner_principal_id is returned; owner email and display_name are not. The id is an opaque
 31    -- internal number, and an administrator who needs to put a name to it can resolve it through
 32    -- /admin/principals/, which they already hold road.role.grant for. Duplicating principal PII
 33    -- into a second endpoint widens the audience for it and gains nothing.
 34    function build_todo_json(p_todo_id in number) return json is
 35      l_result json;
 36    begin
 37      select json_object(
 38               'todo_id'            value t.todo_id,
 39               'owner_principal_id' value t.owner_principal_id,
 40               'title'              value t.title,
 41               'notes'              value t.notes,
 42               'due_at'             value t.due_at,
 43               'status'             value t.status,
 44               'created_at'         value t.created_at,
 45               'updated_at'         value t.updated_at
 46               returning json
 47             )
 48        into l_result
 49        from demo_todos t
 50       where t.todo_id = p_todo_id;
 51  
 52      return l_result;
 53    end build_todo_json;
 54  
 55    -- Resolves a todo the caller is entitled to see, or raises NOT_FOUND.
 56    --
 57    -- 404 rather than 403 for another owner's row, DELIBERATELY, and it is the one place the demo
 58    -- departs from the framework's own 403-on-refusal contract (spec-patch-08 section 6.1, decided
 59    -- 2026-08-19). There, the PERMISSION is missing and saying so is useful. Here the permission is
 60    -- held and the ROW is out of scope -- a 403 would confirm the row exists, which the caller has
 61    -- not earned. Same reason a login form should not say "no such user".
 62    function owned_todo_id(p_todo_id in number) return number is
 63      l_owner number;
 64    begin
 65      if p_todo_id is null then
 66        raise_application_error(c_validation, 'todo_id is required');
 67      end if;
 68  
 69      begin
 70        select owner_principal_id into l_owner from demo_todos where todo_id = p_todo_id;
 71      exception
 72        when no_data_found then
 73          raise_application_error(c_not_found, 'Todo ' || p_todo_id || ' not found');
 74      end;
 75  
 76      if l_owner != road_ctx_pkg.principal_id
 77         and not road_ctx_pkg.has_permission('todo.list_all') then
 78        raise_application_error(c_not_found, 'Todo ' || p_todo_id || ' not found');
 79      end if;
 80  
 81      return p_todo_id;
 82    end owned_todo_id;
 83  
 84    -- Shared by update_todo and delete_todo. Both mutate a row the caller read, so both must prove
 85    -- the read is still current (spec-patch-08 section 6.2).
 86    procedure require_fresh(p_todo_id in number, p_request in json) is
 87      l_token_txt varchar2(100);
 88      l_token     raw(16);
 89      l_updated   timestamp with time zone;
 90    begin
 91      l_token_txt := json_value(p_request, '$.read_token');
 92      if l_token_txt is null then
 93        raise_application_error(c_validation, 'read_token is required');
 94      end if;
 95  
 96      begin
 97        l_token := hextoraw(l_token_txt);
 98      exception
 99        when others then
100          raise_application_error(c_validation, 'read_token is not a valid token');
101      end;
102  
103      select updated_at into l_updated from demo_todos where todo_id = p_todo_id;
104  
105      if not road_audit_api.check_fresh(
106           p_guid               => l_token,
107           p_app_schema         => c_app_schema,
108           p_entity_type        => 'DEMO_TODOS',
109           p_entity_id          => to_char(p_todo_id),
110           p_current_updated_at => l_updated
111         )
112      then
113        raise_application_error(c_conflict, c_conflict_message);
114      end if;
115    end require_fresh;
116  
117    function get_todos(p_request in json default null) return json is
118      l_offset      number;
119      l_limit       number;
120      l_status      varchar2(10 char);
121      l_q           varchar2(200 char);
122      l_owner       number;
123      l_caller_type varchar2(30);
124      l_caller_ref  varchar2(200);
125      l_read_token  raw(16);
126      l_items       json;
127      l_count       number;
128    begin
129      road_ctx_pkg.require_permission('todo.list');
130  
131      select nvl(json_value(p_request, '$.offset' returning number), 0),
132             nvl(json_value(p_request, '$.limit'  returning number), c_default_limit),
133             upper(json_value(p_request, '$.status')),
134             json_value(p_request, '$.q'),
135             json_value(p_request, '$.owner' returning number),
136             nvl(json_value(p_request, '$.caller_type'), 'BROWSER'),
137             json_value(p_request, '$.caller_ref')
138        into l_offset, l_limit, l_status, l_q, l_owner, l_caller_type, l_caller_ref
139        from dual;
140  
141      if l_offset < 0 then
142        raise_application_error(c_validation, 'offset must not be negative');
143      end if;
144      l_limit := least(greatest(l_limit, 1), c_max_limit);
145  
146      if l_status is not null and l_status not in ('OPEN', 'DONE', 'DELETED') then
147        raise_application_error(c_validation, 'status must be one of OPEN, DONE, DELETED');
148      end if;
149  
150      -- THE authorisation case this demo exists to show. Reading your own rows needs todo.list;
151      -- reading anyone else's needs todo.list_all as well. Note the check is on the VALUE, not on
152      -- whether the parameter was supplied -- passing your own id explicitly is not an escalation
153      -- and must not be treated as one.
154      l_owner := nvl(l_owner, road_ctx_pkg.principal_id);
155      if l_owner != road_ctx_pkg.principal_id then
156        road_ctx_pkg.require_permission('todo.list_all');
157      end if;
158  
159      -- limit+1, then discard the extra: hasMore without a second full scan.
160      select json_arrayagg(
161               json_object(
162                 'todo_id'            value todo_id,
163                 'owner_principal_id' value owner_principal_id,
164                 'title'              value title,
165                 'notes'              value notes,
166                 'due_at'             value due_at,
167                 'status'             value status,
168                 'created_at'         value created_at,
169                 'updated_at'         value updated_at
170                 returning json
171               )
172               order by rn returning json
173             )
174        into l_items
175        from (
176          select t.*, row_number() over (order by t.created_at desc, t.todo_id desc) as rn
177            from demo_todos t
178           where t.owner_principal_id = l_owner
179             and (l_status is null and t.status != 'DELETED' or t.status = l_status)
180             and (l_q is null or lower(t.title) like like_term(l_q) escape '\')
181        )
182       where rn > l_offset
183         and rn <= l_offset + l_limit + 1;
184  
185      l_items := nvl(l_items, json('[]'));
186      select count(*) into l_count from json_table(l_items, '$[*]' columns (dummy number path '$.todo_id'));
187  
188      l_read_token := road_audit_api.issue_read_token(
189        p_caller_type => l_caller_type,
190        p_app_schema  => c_app_schema,
191        p_endpoint    => 'get_todos',
192        p_caller_ref  => l_caller_ref
193      );
194  
195      return json_object(
196               'items'      value case when l_count > l_limit
197                                  then json_query(l_items, '$[0 to ' || (l_limit - 1) || ']'
198                                                  returning json)
199                                  else l_items end,
200               'hasMore'    value case when l_count > l_limit then 'true' else 'false' end format json,
201               'limit'      value l_limit,
202               'offset'     value l_offset,
203               'count'      value least(l_count, l_limit),
204               'read_token' value rawtohex(l_read_token)
205               returning json
206             );
207    end get_todos;
208  
209    function create_todo(p_request in json) return json is
210      l_title   varchar2(200 char);
211      l_notes   varchar2(4000 char);
212      l_due_txt varchar2(100);
213      l_todo_id number;
214    begin
215      road_ctx_pkg.require_permission('todo.create');
216  
217      -- An attempt to nominate the owner is REFUSED, not ignored. Silently dropping it would tell a
218      -- caller probing for the hole that their forgery was accepted.
219      if json_exists(p_request, '$.owner_principal_id') then
220        raise_application_error(c_validation,
221          'owner_principal_id is taken from the session and must not be supplied');
222      end if;
223  
224      select json_value(p_request, '$.title'),
225             json_value(p_request, '$.notes'),
226             json_value(p_request, '$.due_at')
227        into l_title, l_notes, l_due_txt
228        from dual;
229  
230      if l_title is null then
231        raise_application_error(c_validation, 'title is required');
232      end if;
233  
234      insert into demo_todos (owner_principal_id, title, notes, due_at)
235      values (road_ctx_pkg.principal_id, l_title, l_notes, parse_ts(l_due_txt, 'due_at'))
236      returning todo_id into l_todo_id;
237  
238      return build_todo_json(l_todo_id);
239    end create_todo;
240  
241    function get_todo(p_request in json) return json is
242      l_todo_id     number;
243      l_caller_type varchar2(30);
244      l_caller_ref  varchar2(200);
245      l_read_token  raw(16);
246    begin
247      road_ctx_pkg.require_permission('todo.get');
248  
249      select json_value(p_request, '$.todo_id' returning number),
250             nvl(json_value(p_request, '$.caller_type'), 'BROWSER'),
251             json_value(p_request, '$.caller_ref')
252        into l_todo_id, l_caller_type, l_caller_ref
253        from dual;
254  
255      l_todo_id := owned_todo_id(l_todo_id);
256  
257      l_read_token := road_audit_api.issue_read_token(
258        p_caller_type => l_caller_type,
259        p_app_schema  => c_app_schema,
260        p_endpoint    => 'get_todo',
261        p_caller_ref  => l_caller_ref
262      );
263  
264      return json_object(
265               'todo'       value build_todo_json(l_todo_id),
266               'read_token' value rawtohex(l_read_token)
267               returning json
268             );
269    end get_todo;
270  
271    function update_todo(p_request in json) return json is
272      l_todo_id number;
273      l_status  varchar2(10 char);
274    begin
275      road_ctx_pkg.require_permission('todo.update');
276  
277      l_todo_id := owned_todo_id(json_value(p_request, '$.todo_id' returning number));
278      require_fresh(l_todo_id, p_request);
279  
280      l_status := upper(json_value(p_request, '$.status'));
281  
282      -- DELETED is deliberately not reachable here. "I finished it" and "I want it gone" are
283      -- different intentions and the audit trail should keep them apart.
284      if l_status is not null and l_status not in ('OPEN', 'DONE') then
285        raise_application_error(c_validation,
286          'status must be OPEN or DONE - use DELETE /todos/{todo_id}/ to remove a todo');
287      end if;
288  
289      update demo_todos
290         set title  = case when json_exists(p_request, '$.title')
291                           then json_value(p_request, '$.title') else title end,
292             notes  = case when json_exists(p_request, '$.notes')
293                           then json_value(p_request, '$.notes') else notes end,
294             due_at = case when json_exists(p_request, '$.due_at')
295                           then parse_ts(json_value(p_request, '$.due_at'), 'due_at') else due_at end,
296             status = nvl(l_status, status)
297       where todo_id = l_todo_id;
298  
299      return build_todo_json(l_todo_id);
300    end update_todo;
301  
302    function delete_todo(p_request in json) return json is
303      l_todo_id number;
304      l_status  varchar2(10 char);
305    begin
306      road_ctx_pkg.require_permission('todo.delete');
307  
308      l_todo_id := owned_todo_id(json_value(p_request, '$.todo_id' returning number));
309      require_fresh(l_todo_id, p_request);
310  
311      select status into l_status from demo_todos where todo_id = l_todo_id;
312  
313      if l_status = 'DELETED' then
314        -- Idempotent, not an error: same shape as grant_role and attach_permission.
315        return json_object('todo_id' value l_todo_id, 'deleted' value 'false' format json
316                           returning json);
317      end if;
318  
319      update demo_todos set status = 'DELETED' where todo_id = l_todo_id;
320  
321      return json_object('todo_id' value l_todo_id, 'deleted' value 'true' format json
322                         returning json);
323    end delete_todo;
324  
325    function purge(p_request in json) return json is
326      l_before_txt varchar2(100);
327      l_before     timestamp with time zone;
328      l_purged     number;
329    begin
330      -- todo.purge is RESERVED. Nothing here reads that flag -- the reservation governs who may
331      -- attach the permission to a role, not what the handler does once someone holds it. The
332      -- guard is road_reserved_composition, in the database, one layer down.
333      road_ctx_pkg.require_permission('todo.purge');
334  
335      l_before_txt := json_value(p_request, '$.before');
336      if l_before_txt is null then
337        raise_application_error(c_validation, 'before is required');
338      end if;
339      l_before := parse_ts(l_before_txt, 'before');
340  
341      -- Across ALL owners, and no ownership filter anywhere: that is what makes this the dangerous
342      -- operation worth reserving.
343      delete from demo_todos
344       where status in ('DONE', 'DELETED')
345         and updated_at < l_before;
346      l_purged := sql%rowcount;
347  
348      road_audit_api.log_admin_action(
349        p_endpoint    => 'purge',
350        p_entity_type => 'DEMO_TODOS',
351        p_entity_id   => to_char(l_purged),
352        p_outcome     => 'OK'
353      );
354  
355      return json_object('purged' value l_purged returning json);
356    end purge;
357  
358  end demo_todo_api;
359  /

