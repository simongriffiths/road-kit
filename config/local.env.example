# Per-machine values that bin/ scripts source if config/local.env exists.
#
# Copy to config/local.env, which is gitignored, and fill in real values.
#
# These deliberately have no default in code -- render-auth-config.sh explains why: a
# plausible-but-wrong value is exactly how a defect survives unnoticed. This file is the
# alternative to exporting them in a shell profile, for interfaces (the Claude Desktop app,
# a fresh terminal, an agent session) that do not inherit one.
#
# THIS FILE IS THE ESTATE'S STANDARD and is byte-identical across every road-* repository, checked
# by bin/check-road-kit-parity.sh. It exists as a shared file because the convention already failed
# once by not travelling: on 2026-09-06 quorate's browser suite could not run, because road-cal had
# ROAD_TEST_PASSWORD in its local.env and quorate's example never mentioned the variable, so
# quorate's local.env was created without it. Three of its scripts required it. Adding a variable
# that a bin/ script reads means adding it here, in the same commit.

# The ORDS host, scheme included, no trailing slash.
export ROAD_ORDS_HOST=https://example-db.adb.<region>.oraclecloudapps.com

# Which authentication provider profile the scripts and the rendered config assume.
# ords_local_jwt_scaffold (the development scaffold) or external_oidc (Auth0).
export AUTH_PROFILE=ords_local_jwt_scaffold

# The JWT scaffold's application login for the test principal -- read by get-test-token.sh,
# run-endpoint-tests.sh and run-browser-smoke.sh.
#
# NOT A DATABASE PASSWORD. It is a fake application account that exists only under
# AUTH_PROFILE=ords_local_jwt_scaffold, and it never reaches the database as plaintext: the
# database stores a PBKDF2 hash, so THE VALUE CANNOT BE RECOVERED FROM THE DATABASE OR FROM ANY LOG
# once it is lost. This file is the only copy, which is exactly why the variable belongs here
# rather than in a shell history or a one-off export.
#
# If it is lost, it cannot be looked up -- it can only be replaced:
#
#   bin/set-principal-password.sh          # prompts twice on the terminal, sends only hex
#
# then write the new value into config/local.env IN THE SAME SITTING. That reset updates the
# principal's credentials_changed_at, which is the global-logout epoch, so every existing session
# for that identity stops working. Dev only; do not point this at anything serving traffic.
export ROAD_TEST_PASSWORD='replace-me'

# The test principal the password belongs to. Defaults to ADMIN in the scripts, so it only needs
# setting where a repository uses a different one.
# export ROAD_TEST_USERNAME=ADMIN
